    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor blocks", "default": true },
    { "type": "checkbox", "id": "show_description", "label": "Show description blocks", "default": true },
    { "type": "checkbox", "id": "show_quantity", "label": "Show quantity blocks", "default": true },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Allow dynamic checkout in buy-button blocks", "default": true },
    { "type": "checkbox", "id": "show_pickup_availability", "label": "Show pickup availability", "default": true },
    { "type": "text", "id": "delivery_note", "label": "Delivery note", "info": "Only add delivery claims your store can fulfil." },
    { "type": "text", "id": "dispatch_note", "label": "Dispatch estimate", "info": "The product custom.dispatch_note metafield takes precedence." },
    { "type": "url", "id": "size_guide_link", "label": "Size guide link" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f7f3ed" },
    { "type": "color", "id": "card_color", "label": "Media and placeholder background", "default": "#eee8df" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#24211e" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#716b64" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#8a6d2f" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_desktop", "label": "Desktop vertical spacing", "min": 24, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_mobile", "label": "Mobile vertical spacing", "min": 20, "max": 100, "step": 4, "unit": "px", "default": 52 }
  ],
  "blocks": [
    { "type": "@app" },
