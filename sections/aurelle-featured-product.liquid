    { "type": "price", "name": "Price", "limit": 1, "settings": [] },
    { "type": "description", "name": "Description", "limit": 1, "settings": [] },
    { "type": "variant_picker", "name": "Variant and purchase options", "limit": 1, "settings": [ { "type": "text", "id": "selling_plan_heading", "label": "Purchase options heading", "default": "Purchase options" } ] },
    { "type": "inventory", "name": "Inventory status", "limit": 1, "settings": [ { "type": "range", "id": "low_stock_threshold", "label": "Low stock threshold", "min": 1, "max": 20, "step": 1, "default": 5 } ] },
    { "type": "sku", "name": "SKU", "limit": 1, "settings": [ { "type": "text", "id": "label", "label": "Label", "default": "SKU" } ] },
    { "type": "quantity", "name": "Quantity selector", "limit": 1, "settings": [ { "type": "text", "id": "label", "label": "Label", "default": "Quantity" } ] },
    { "type": "buy_buttons", "name": "Buy buttons", "limit": 1, "settings": [ { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show accelerated checkout", "default": true } ] },
    { "type": "collapsible", "name": "Collapsible details", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Materials and care" }, { "type": "richtext", "id": "content", "label": "Content" } ] },
    { "type": "custom_liquid", "name": "Custom Liquid", "settings": [ { "type": "liquid", "id": "custom_liquid", "label": "Custom Liquid" } ] },
    { "type": "text_icon", "name": "Text with icon", "settings": [ { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "diamond", "label": "Gemstone" }, { "value": "care", "label": "Care" }, { "value": "delivery", "label": "Delivery" }, { "value": "bullet", "label": "Bullet" } ], "default": "diamond" }, { "type": "text", "id": "heading", "label": "Heading" }, { "type": "richtext", "id": "text", "label": "Text" } ] },
    { "type": "complementary_products", "name": "Complementary products", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Pairs beautifully with" }, { "type": "product_list", "id": "products", "label": "Products", "limit": 4 } ] }
  ],
  "max_blocks": 24,
  "presets": [
    {
