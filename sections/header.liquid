{% liquid
  assign show_country_selector = false
  assign show_language_selector = false

  if localization.available_countries.size > 1
    assign show_country_selector = true
  endif

  if localization.available_languages.size > 1
    assign show_language_selector = true
  endif

  assign show_localization_form = false
  if show_country_selector or show_language_selector
    assign show_localization_form = true
  endif
%}

<header
  class="aurelle-header full-width{% if section.settings.enable_sticky_header %} aurelle-header--sticky{% endif %}"
  style="--aurelle-header-background: {{ section.settings.background_color }}; --aurelle-header-foreground: {{ section.settings.foreground_color }}; --aurelle-header-accent: {{ section.settings.accent_color }};"
  data-aurelle-header
  data-sticky-header="{{ section.settings.enable_sticky_header }}"
>
  <div class="aurelle-header__utility">
    <div class="aurelle-header__inner aurelle-header__utility-inner">
      {% if section.settings.salon_message != blank %}
        <p class="aurelle-header__salon-message">
          <span class="aurelle-header__status-dot" aria-hidden="true"></span>
          {{ section.settings.salon_message | escape }}
        </p>
      {% else %}
        <span></span>
      {% endif %}

      {% if section.settings.announcement_message != blank %}
        <p class="aurelle-header__announcement">{{ section.settings.announcement_message | escape }}</p>
      {% else %}
        <span></span>
      {% endif %}

      <div class="aurelle-header__localization">
        {% if show_localization_form %}
          {% form 'localization', id: 'AurelleLocalizationForm', return_to: routes.root_url, aria-label: 'Store region and language', data-aurelle-localization-form: '' %}
            <span class="aurelle-header__globe" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none" focusable="false">
                <circle cx="8" cy="8" r="6.25" stroke="currentColor" stroke-width="1.2" />
                <path d="M1.9 8h12.2M8 1.8c1.6 1.7 2.4 3.8 2.4 6.2S9.6 12.5 8 14.2C6.4 12.5 5.6 10.4 5.6 8S6.4 3.5 8 1.8Z" stroke="currentColor" stroke-width="1.1" />
              </svg>
            </span>

            {% if show_country_selector %}
              <label class="aurelle-header__visually-hidden" for="AurelleCountry-{{ section.id }}">Country and currency</label>
              <select id="AurelleCountry-{{ section.id }}" name="country_code" data-aurelle-localization-select>
                {% for country in localization.available_countries %}
                  <option
                    value="{{ country.iso_code }}"
                    {% if country.iso_code == localization.country.iso_code %}selected{% endif %}
                  >
                    {{ country.currency.iso_code }} ({{ country.currency.symbol }})
                  </option>
                {% endfor %}
              </select>
            {% else %}
              <span>{{ localization.country.currency.iso_code }} ({{ localization.country.currency.symbol }})</span>
            {% endif %}

            <span class="aurelle-header__localization-divider" aria-hidden="true">|</span>

            {% if show_language_selector %}
              <label class="aurelle-header__visually-hidden" for="AurelleLanguage-{{ section.id }}">Language</label>
              <select id="AurelleLanguage-{{ section.id }}" name="language_code" data-aurelle-localization-select>
                {% for language in localization.available_languages %}
                  <option
                    value="{{ language.iso_code }}"
                    lang="{{ language.iso_code }}"
                    {% if language.iso_code == localization.language.iso_code %}selected{% endif %}
                  >
                    {{ language.iso_code | upcase }}
                  </option>
                {% endfor %}
              </select>
            {% else %}
              <span>{{ localization.language.iso_code | upcase }}</span>
            {% endif %}

            <button class="aurelle-header__localization-submit" type="submit" aria-label="Apply region and language">
              <svg viewBox="0 0 10 10" fill="none" aria-hidden="true" focusable="false">
                <path d="m2 4 3 3 3-3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          {% endform %}
        {% else %}
          <span class="aurelle-header__globe" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none" focusable="false">
              <circle cx="8" cy="8" r="6.25" stroke="currentColor" stroke-width="1.2" />
              <path d="M1.9 8h12.2M8 1.8c1.6 1.7 2.4 3.8 2.4 6.2S9.6 12.5 8 14.2C6.4 12.5 5.6 10.4 5.6 8S6.4 3.5 8 1.8Z" stroke="currentColor" stroke-width="1.1" />
            </svg>
          </span>
          <span>{{ localization.country.currency.iso_code }} ({{ localization.country.currency.symbol }})</span>
          <span class="aurelle-header__localization-divider" aria-hidden="true">|</span>
          <span>{{ localization.language.iso_code | upcase }}</span>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="aurelle-header__brand-row">
    <div class="aurelle-header__inner aurelle-header__brand-inner">
      <div class="aurelle-header__left-actions">
        <button
          class="aurelle-header__action aurelle-header__search"
          type="button"
          aria-label="Open search"
          aria-haspopup="dialog"
          aria-controls="AurelleSearchDialog-{{ section.id }}"
          data-aurelle-search-open
        >
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
            <circle cx="6.9" cy="6.9" r="4.6" stroke="currentColor" stroke-width="1.35" />
            <path d="m10.3 10.3 3.1 3.1" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" />
          </svg>
          <span>Search</span>
        </button>

        {% if section.settings.concierge_link != blank %}
          <span class="aurelle-header__action-divider" aria-hidden="true">|</span>
          <a class="aurelle-header__action aurelle-header__concierge" href="{{ section.settings.concierge_link | escape }}">
            {{ section.settings.concierge_label | escape }}
          </a>
        {% endif %}

        <details class="aurelle-header__mobile-menu" data-aurelle-mobile-menu>
          <summary aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="AurelleMobileNavigation-{{ section.id }}">
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
              <path d="M3 5.5h14M3 10h14M3 14.5h14" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
            </svg>
            <span class="aurelle-header__visually-hidden">Menu</span>
          </summary>
          <nav class="aurelle-header__mobile-panel" id="AurelleMobileNavigation-{{ section.id }}" aria-label="Main navigation" data-aurelle-mobile-navigation>
            <ul class="aurelle-header__mobile-list aurelle-header__mobile-list--level-1">
              {% if section.settings.menu != blank %}
                {% for link in section.settings.menu.links %}
                  {% assign mobile_submenu_id = 'AurelleMobileSubmenu-' | append: section.id | append: '-' | append: forloop.index %}
                  <li class="aurelle-header__mobile-item{% if link.current or link.child_active %} is-active{% endif %}">
                    <div class="aurelle-header__mobile-link-row">
                      <a href="{{ link.url | escape }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
                      {% if link.links != blank %}
                        <button class="aurelle-header__submenu-toggle" type="button" aria-expanded="false" aria-controls="{{ mobile_submenu_id }}" aria-haspopup="true" data-aurelle-submenu-toggle>
                          <span class="aurelle-header__visually-hidden">Toggle {{ link.title | escape }} submenu</span>
                          <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="m2.5 4.25 3.5 3.5 3.5-3.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                      {% endif %}
                    </div>
                    {% if link.links != blank %}
                      <ul class="aurelle-header__mobile-list aurelle-header__mobile-list--level-2" id="{{ mobile_submenu_id }}" hidden>
                        {% for child_link in link.links %}
                          {% assign mobile_nested_id = mobile_submenu_id | append: '-' | append: forloop.index %}
                          <li class="aurelle-header__mobile-item{% if child_link.current or child_link.child_active %} is-active{% endif %}">
                            <div class="aurelle-header__mobile-link-row">
                              <a href="{{ child_link.url | escape }}"{% if child_link.current %} aria-current="page"{% endif %}>{{ child_link.title | escape }}</a>
                              {% if child_link.links != blank %}
                                <button class="aurelle-header__submenu-toggle" type="button" aria-expanded="false" aria-controls="{{ mobile_nested_id }}" aria-haspopup="true" data-aurelle-submenu-toggle>
                                  <span class="aurelle-header__visually-hidden">Toggle {{ child_link.title | escape }} submenu</span>
                                  <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="m2.5 4.25 3.5 3.5 3.5-3.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </button>
                              {% endif %}
                            </div>
                            {% if child_link.links != blank %}
                              <ul class="aurelle-header__mobile-list aurelle-header__mobile-list--level-3" id="{{ mobile_nested_id }}" hidden>
                                {% for grandchild_link in child_link.links %}
                                  <li class="aurelle-header__mobile-item{% if grandchild_link.current %} is-active{% endif %}">
                                    <a href="{{ grandchild_link.url | escape }}"{% if grandchild_link.current %} aria-current="page"{% endif %}>{{ grandchild_link.title | escape }}</a>
                                  </li>
                                {% endfor %}
                              </ul>
                            {% endif %}
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </li>
                {% endfor %}
              {% else %}
                <li><a href="{{ routes.all_products_collection_url }}">High Jewellery</a></li>
                <li><a href="{{ routes.collections_url }}">Collections</a></li>
                <li><a href="{{ routes.all_products_collection_url }}">New Arrivals</a></li>
                <li><a href="{{ routes.search_url }}?q=bespoke">Bespoke</a></li>
                <li><a href="{{ routes.search_url }}?q=editorial">Editorial</a></li>
              {% endif %}
            </ul>
          </nav>
        </details>
      </div>

      <a class="aurelle-header__brand" href="{{ routes.root_url }}" aria-label="{{ section.settings.brand_name | default: shop.name | escape }} home">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 500 | image_tag: class: 'aurelle-header__logo-image', alt: section.settings.brand_name, widths: '160, 240, 320, 500', sizes: '(min-width: 750px) 200px, 160px' }}
        {% else %}
          <span class="aurelle-header__wordmark">{{ section.settings.brand_name | default: shop.name | default: 'AURELLE' | escape }}</span>
        {% endif %}
        {% if section.settings.brand_subtitle != blank %}
          <span class="aurelle-header__brand-subtitle">{{ section.settings.brand_subtitle | escape }}</span>
        {% endif %}
      </a>

      <div class="aurelle-header__right-actions">
        {% if shop.customer_accounts_enabled %}
          <a class="aurelle-header__icon-link" href="{{ routes.account_url }}" aria-label="Account">
            {{ 'icon-account.svg' | inline_asset_content }}
          </a>
        {% endif %}
        <a class="aurelle-header__icon-link aurelle-header__bag-link" href="{{ routes.cart_url }}" aria-label="Shopping bag, {{ cart.item_count }} items">
          {{ 'icon-cart.svg' | inline_asset_content }}
          <span class="aurelle-header__bag-count" aria-hidden="true">({{ cart.item_count }})</span>
        </a>
      </div>
    </div>
  </div>

  <nav class="aurelle-header__desktop-navigation" aria-label="Main navigation">
    <div class="aurelle-header__inner">
      <ul class="aurelle-header__desktop-list">
        {% if section.settings.menu != blank %}
          {% for link in section.settings.menu.links %}
            {% assign desktop_submenu_id = 'AurelleDesktopSubmenu-' | append: section.id | append: '-' | append: forloop.index %}
            <li class="aurelle-header__desktop-item{% if link.current or link.child_active %} is-active{% endif %}" data-aurelle-desktop-nav-item>
              <div class="aurelle-header__desktop-link-row">
                <a href="{{ link.url | escape }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
                {% if link.links != blank %}
                  <button class="aurelle-header__desktop-toggle" type="button" aria-expanded="false" aria-controls="{{ desktop_submenu_id }}" aria-haspopup="true" data-aurelle-desktop-toggle>
                    <span class="aurelle-header__visually-hidden">Toggle {{ link.title | escape }} submenu</span>
                    <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="m2.5 4.25 3.5 3.5 3.5-3.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </button>
                {% endif %}
              </div>
              {% if link.links != blank %}
                <div class="aurelle-header__desktop-submenu" id="{{ desktop_submenu_id }}" data-aurelle-desktop-submenu>
                  <ul class="aurelle-header__desktop-submenu-list">
                    {% for child_link in link.links %}
                      <li class="aurelle-header__desktop-submenu-item{% if child_link.current or child_link.child_active %} is-active{% endif %}">
                        <a class="aurelle-header__desktop-level-2" href="{{ child_link.url | escape }}"{% if child_link.current %} aria-current="page"{% endif %}>{{ child_link.title | escape }}</a>
                        {% if child_link.links != blank %}
                          <ul class="aurelle-header__desktop-level-3">
                            {% for grandchild_link in child_link.links %}
                              <li><a href="{{ grandchild_link.url | escape }}"{% if grandchild_link.current %} aria-current="page"{% endif %}>{{ grandchild_link.title | escape }}</a></li>
                            {% endfor %}
                          </ul>
                        {% endif %}
                      </li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
            </li>
          {% endfor %}
        {% else %}
          <li><a href="{{ routes.all_products_collection_url }}">High Jewellery</a></li>
          <li><a href="{{ routes.collections_url }}">Collections</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">New Arrivals</a></li>
          <li><a href="{{ routes.search_url }}?q=bespoke">Bespoke</a></li>
          <li><a href="{{ routes.search_url }}?q=editorial">Editorial</a></li>
        {% endif %}
      </ul>
    </div>
  </nav>
</header>

<dialog
  id="AurelleSearchDialog-{{ section.id }}"
  class="aurelle-search-dialog"
  style="--aurelle-header-background: {{ section.settings.background_color }}; --aurelle-header-foreground: {{ section.settings.foreground_color }}; --aurelle-header-accent: {{ section.settings.accent_color }};"
  aria-labelledby="AurelleSearchTitle-{{ section.id }}"
  data-aurelle-search-dialog
>
  <div class="aurelle-search-dialog__panel">
    <button class="aurelle-search-dialog__close" type="button" aria-label="Close search" data-aurelle-search-close>
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
        <path d="m4 4 12 12M16 4 4 16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
      </svg>
    </button>
    <p class="aurelle-search-dialog__eyebrow" id="AurelleSearchTitle-{{ section.id }}">Search AURELLE</p>
    <form class="aurelle-search-dialog__form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="aurelle-header__visually-hidden" for="AurelleSearchInput-{{ section.id }}">Search products and pages</label>
      <input
        id="AurelleSearchInput-{{ section.id }}"
        class="aurelle-search-dialog__input"
        type="search"
        name="q"
        placeholder="What are you looking for?"
        autocomplete="off"
      >
      <button class="aurelle-search-dialog__submit" type="submit" aria-label="Submit search">
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
          <circle cx="6.9" cy="6.9" r="4.6" stroke="currentColor" stroke-width="1.35" />
          <path d="m10.3 10.3 3.1 3.1" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" />
        </svg>
      </button>
    </form>
  </div>
</dialog>

{% stylesheet %}
  .aurelle-header {
    position: relative;
    z-index: 10;
    width: 100%;
    color: var(--aurelle-header-foreground);
    background: var(--aurelle-header-background);
    font-family: var(--font-primary--family);
  }

  .shopify-section.aurelle-header-section--sticky {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .shopify-section.aurelle-header-section--sticky .aurelle-header {
    transition: box-shadow 180ms ease;
  }

  .shopify-section.aurelle-header-section--sticky.is-scrolled .aurelle-header {
    box-shadow: 0 10px 28px rgb(39 37 33 / 9%);
  }

  .aurelle-header__inner {
    width: min(1184px, calc(100% - 96px));
    margin-inline: auto;
  }

  .aurelle-header p,
  .aurelle-header ul {
    margin: 0;
    padding: 0;
  }

  .aurelle-header__utility {
    min-height: 32px;
    border-bottom: 1px solid rgb(39 37 33 / 8%);
  }

  .aurelle-header__utility-inner {
    display: grid;
    min-height: 32px;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) auto;
    align-items: center;
    gap: 24px;
    font-size: 11px;
    letter-spacing: 0.16em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .aurelle-header__salon-message,
  .aurelle-header__announcement,
  .aurelle-header__localization {
    display: flex;
    align-items: center;
  }

  .aurelle-header__salon-message {
    gap: 10px;
    white-space: nowrap;
  }

  .aurelle-header__status-dot {
    width: 6px;
    height: 6px;
    flex: 0 0 6px;
    border-radius: 50%;
    background: var(--aurelle-header-accent);
  }

  .aurelle-header__announcement {
    justify-content: center;
    text-align: center;
  }

  .aurelle-header__localization {
    justify-content: flex-end;
    gap: 5px;
    white-space: nowrap;
  }

  .aurelle-header__localization form {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .aurelle-header__localization select,
  .aurelle-header__localization-submit {
    border: 0;
    padding: 0;
    color: inherit;
    background: transparent;
    font: inherit;
    letter-spacing: inherit;
    text-transform: uppercase;
  }

  .aurelle-header__localization select {
    max-width: 112px;
    cursor: pointer;
  }

  .aurelle-header__localization select:focus-visible,
  .aurelle-header__localization-submit:focus-visible,
  .aurelle-header a:focus-visible,
  .aurelle-header button:focus-visible,
  .aurelle-header summary:focus-visible {
    outline: 2px solid var(--aurelle-header-accent);
    outline-offset: 3px;
  }

  .aurelle-header__globe,
  .aurelle-header__globe svg {
    display: block;
    width: 12px;
    height: 12px;
  }

  .aurelle-header__localization-divider {
    opacity: 0.55;
  }

  .aurelle-header__localization-submit {
    display: inline-grid;
    width: 18px;
    height: 18px;
    place-items: center;
    cursor: pointer;
  }

  .aurelle-header__localization-submit svg {
    width: 10px;
    height: 10px;
  }

  .aurelle-header__brand-row {
    border-bottom: 1px solid rgb(39 37 33 / 8%);
  }

  .aurelle-header__brand-inner {
    display: grid;
    min-height: 80px;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
  }

  .aurelle-header__left-actions,
  .aurelle-header__right-actions {
    display: flex;
    align-items: center;
  }

  .aurelle-header__left-actions {
    gap: 16px;
  }

  .aurelle-header__right-actions {
    justify-content: flex-end;
    gap: 22px;
  }

  .aurelle-header__action,
  .aurelle-header__icon-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: inherit;
    font-size: 13px;
    letter-spacing: 0.16em;
    line-height: 1.3;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 180ms ease, transform 180ms ease;
  }

  .aurelle-header__search {
    border: 0;
    padding: 0;
    color: inherit;
    background: transparent;
    cursor: pointer;
  }

  .aurelle-header__action:hover,
  .aurelle-header__icon-link:hover,
  .aurelle-header__desktop-navigation a:hover,
  .aurelle-header__mobile-panel a:hover {
    color: var(--aurelle-header-accent);
  }

  .aurelle-header__action:active,
  .aurelle-header__icon-link:active {
    transform: scale(0.96);
  }

  .aurelle-header__search svg {
    width: 14px;
    height: 14px;
  }

  .aurelle-header__action-divider {
    color: rgb(39 37 33 / 32%);
    font-size: 12px;
  }

  .aurelle-header__brand {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: inherit;
    text-align: center;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .aurelle-header__brand:hover {
    color: var(--aurelle-header-accent);
  }

  .aurelle-header__wordmark {
    /* Approximate editorial serif; the Figma font family isn't exposed in the inspected metadata. */
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 26px;
    font-weight: 400;
    letter-spacing: 0.27em;
    line-height: 1;
    padding-left: 0.27em;
  }

  .aurelle-header__logo-image {
    display: block;
    width: min(100%, 200px);
    height: auto;
  }

  .aurelle-header__brand-subtitle {
    margin-top: 7px;
    font-size: 10px;
    letter-spacing: 0.34em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .aurelle-header__icon-link svg {
    width: 16px;
    height: 16px;
  }

  .aurelle-header__bag-link {
    gap: 6px;
    letter-spacing: 0.02em;
    text-transform: none;
  }

  .aurelle-header__bag-count {
    font-size: 12px;
  }

  .aurelle-header__desktop-navigation {
    position: relative;
    min-height: 41.5px;
    border-bottom: 1px solid rgb(39 37 33 / 8%);
  }

  .aurelle-header__desktop-list {
    display: flex;
    min-height: 41.5px;
    align-items: center;
    justify-content: center;
    gap: 32px;
    list-style: none;
  }

  .aurelle-header__desktop-item,
  .aurelle-header__desktop-link-row {
    display: flex;
    min-width: 0;
    align-items: center;
  }

  .aurelle-header__desktop-item {
    position: static;
  }

  .aurelle-header__desktop-link-row {
    gap: 5px;
  }

  .aurelle-header__desktop-navigation a,
  .aurelle-header__mobile-panel a {
    color: inherit;
    font-size: 13px;
    letter-spacing: 0.2em;
    line-height: 1.3;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 180ms ease, transform 180ms ease;
  }

  .aurelle-header__desktop-navigation a {
    position: relative;
    display: inline-block;
  }

  .aurelle-header__desktop-link-row > a {
    overflow-wrap: anywhere;
  }

  .aurelle-header__desktop-toggle,
  .aurelle-header__submenu-toggle {
    display: inline-grid;
    place-items: center;
    border: 0;
    padding: 0;
    color: inherit;
    background: transparent;
    cursor: pointer;
  }

  .aurelle-header__desktop-toggle {
    width: 24px;
    height: 32px;
    flex: 0 0 24px;
  }

  .aurelle-header__desktop-toggle svg,
  .aurelle-header__submenu-toggle svg {
    width: 12px;
    height: 12px;
    transition: transform 180ms ease;
  }

  .aurelle-header__desktop-toggle[aria-expanded='true'] svg,
  .aurelle-header__submenu-toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .aurelle-header__desktop-navigation a::after {
    position: absolute;
    right: 0;
    bottom: -7px;
    left: 0;
    height: 1px;
    background: currentColor;
    content: '';
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 220ms ease;
  }

  .aurelle-header__desktop-navigation a:hover::after,
  .aurelle-header__desktop-navigation a:focus-visible::after {
    transform: scaleX(1);
  }

  .aurelle-header__desktop-list > li + li::before {
    display: inline-block;
    margin-right: 32px;
    color: var(--aurelle-header-accent);
    content: '•';
  }

  .aurelle-header__desktop-submenu {
    position: absolute;
    z-index: 4;
    top: 100%;
    left: 50%;
    width: min(760px, calc(100vw - 48px));
    max-height: min(70vh, 620px);
    overflow: auto;
    padding: 28px 32px 32px;
    border: 1px solid rgb(39 37 33 / 10%);
    color: var(--aurelle-header-foreground);
    background: var(--aurelle-header-background);
    box-shadow: 0 18px 42px rgb(39 37 33 / 13%);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -8px);
    visibility: hidden;
    transition: opacity 180ms ease, transform 220ms ease, visibility 180ms ease;
  }

  .aurelle-header__desktop-item:hover > .aurelle-header__desktop-submenu,
  .aurelle-header__desktop-item.is-open > .aurelle-header__desktop-submenu {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
    visibility: visible;
  }

  .aurelle-header__desktop-submenu-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(190px, 100%), 1fr));
    gap: 28px 36px;
    list-style: none;
  }

  .aurelle-header__desktop-submenu-item {
    min-width: 0;
  }

  .aurelle-header__desktop-navigation .aurelle-header__desktop-level-2 {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .aurelle-header__desktop-level-3 {
    display: grid;
    gap: 10px;
    margin-top: 14px !important;
    list-style: none;
  }

  .aurelle-header__desktop-navigation .aurelle-header__desktop-level-3 a {
    color: color-mix(in srgb, var(--aurelle-header-foreground) 72%, transparent);
    font-size: 12px;
    letter-spacing: 0.04em;
    line-height: 1.45;
    overflow-wrap: anywhere;
    text-transform: none;
  }

  .aurelle-header__desktop-navigation [aria-current='page'] {
    color: var(--aurelle-header-accent);
  }

  .aurelle-header__desktop-item.is-active > .aurelle-header__desktop-link-row > a,
  .aurelle-header__desktop-toggle:hover,
  .aurelle-header__submenu-toggle:hover {
    color: var(--aurelle-header-accent);
  }

  .aurelle-header__mobile-menu {
    display: none;
  }

  .aurelle-header__mobile-menu summary {
    display: flex;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    list-style: none;
  }

  .aurelle-header__mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .aurelle-header__mobile-menu summary svg {
    width: 20px;
    height: 20px;
  }

  .aurelle-header__mobile-panel {
    position: absolute;
    z-index: 2;
    top: 100%;
    right: 0;
    left: 0;
    padding: 12px 24px 22px;
    border-top: 1px solid rgb(39 37 33 / 8%);
    background: var(--aurelle-header-background);
    box-shadow: 0 12px 18px rgb(39 37 33 / 9%);
    max-height: min(72vh, 680px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .aurelle-header__mobile-menu[open] .aurelle-header__mobile-panel {
    animation: aurelle-menu-enter 240ms cubic-bezier(0.2, 0.65, 0.3, 1) both;
  }

  .aurelle-header__mobile-list {
    display: grid;
    gap: 0;
    list-style: none;
  }

  .aurelle-header__mobile-list--level-1 > .aurelle-header__mobile-item {
    border-bottom: 1px solid rgb(39 37 33 / 8%);
  }

  .aurelle-header__mobile-link-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 48px;
    align-items: stretch;
  }

  .aurelle-header__mobile-link-row > a,
  .aurelle-header__mobile-item > a {
    display: flex;
    min-width: 0;
    align-items: center;
    padding: 16px 0;
    overflow-wrap: anywhere;
  }

  .aurelle-header__submenu-toggle {
    width: 48px;
    min-height: 48px;
    justify-self: end;
  }

  .aurelle-header__mobile-list[hidden] {
    display: none;
  }

  .aurelle-header__mobile-list--level-2,
  .aurelle-header__mobile-list--level-3 {
    border-top: 1px solid rgb(39 37 33 / 8%);
    padding-left: 18px !important;
  }

  .aurelle-header__mobile-list--level-2 .aurelle-header__mobile-item + .aurelle-header__mobile-item,
  .aurelle-header__mobile-list--level-3 .aurelle-header__mobile-item + .aurelle-header__mobile-item {
    border-top: 1px solid rgb(39 37 33 / 6%);
  }

  .aurelle-header__mobile-list--level-2 a {
    font-size: 12px;
    letter-spacing: 0.13em;
  }

  .aurelle-header__mobile-list--level-3 a {
    color: color-mix(in srgb, var(--aurelle-header-foreground) 72%, transparent);
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: none;
  }

  .aurelle-header__mobile-item.is-active > .aurelle-header__mobile-link-row > a,
  .aurelle-header__mobile-item > a[aria-current='page'] {
    color: var(--aurelle-header-accent);
  }

  .aurelle-header__visually-hidden {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .aurelle-search-dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    border: 0;
    padding: clamp(56px, 16vh, 160px) 20px 24px;
    color: var(--aurelle-header-foreground);
    background: transparent;
  }

  .aurelle-search-dialog::backdrop {
    background: rgb(24 22 19 / 46%);
    backdrop-filter: blur(2px);
  }

  .aurelle-search-dialog[open]::backdrop {
    animation: aurelle-backdrop-enter 220ms ease both;
  }

  .aurelle-search-dialog__panel {
    position: relative;
    width: min(680px, 100%);
    margin-inline: auto;
    padding: 42px 48px 48px;
    background: var(--aurelle-header-background);
    box-shadow: 0 20px 70px rgb(24 22 19 / 18%);
  }

  .aurelle-search-dialog[open] .aurelle-search-dialog__panel {
    animation: aurelle-search-enter 260ms cubic-bezier(0.2, 0.65, 0.3, 1) both;
  }

  @keyframes aurelle-menu-enter {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes aurelle-search-enter {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes aurelle-backdrop-enter {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .aurelle-search-dialog__close {
    position: absolute;
    top: 16px;
    right: 16px;
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border: 0;
    color: inherit;
    background: transparent;
