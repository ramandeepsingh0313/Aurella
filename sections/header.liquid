{% javascript %}
  (() => {
    const stickyClass = 'aurelle-header-section--sticky';
    const scrolledClass = 'is-scrolled';

    const setDesktopItemOpen = (item, open) => {
      item.classList.toggle('is-open', open);
      item.querySelector(':scope > .aurelle-header__desktop-link-row > [data-aurelle-desktop-toggle]')?.setAttribute('aria-expanded', String(open));
    };

    const closeDesktopMenus = (header, exceptItem = null) => {
      header.querySelectorAll('[data-aurelle-desktop-nav-item].is-open').forEach((item) => {
        if (item !== exceptItem) setDesktopItemOpen(item, false);
      });
    };

    const setMobileSubmenuOpen = (button, open) => {
      const submenu = document.getElementById(button.getAttribute('aria-controls'));
      if (!submenu) return;
      button.setAttribute('aria-expanded', String(open));
      submenu.hidden = !open;
    };

    const resetMobileMenu = (menu) => {
      menu.querySelectorAll('[data-aurelle-submenu-toggle][aria-expanded="true"]').forEach((button) => setMobileSubmenuOpen(button, false));
    };

    const initializeHeader = (scope = document) => {
      const headers = [];
      if (scope.matches?.('[data-aurelle-header]')) headers.push(scope);
      scope.querySelectorAll?.('[data-aurelle-header]').forEach((header) => headers.push(header));

      headers.forEach((header) => {
        const sectionWrapper = header.closest('.shopify-section');
        if (!sectionWrapper) return;

        const stickyEnabled = header.dataset.stickyHeader === 'true';
        sectionWrapper.classList.toggle(stickyClass, stickyEnabled);
        sectionWrapper.classList.toggle(scrolledClass, stickyEnabled && window.scrollY > 0);

        header.querySelectorAll('[data-aurelle-submenu-toggle]').forEach((button) => {
          const submenu = document.getElementById(button.getAttribute('aria-controls'));
          if (submenu) submenu.hidden = button.getAttribute('aria-expanded') !== 'true';
        });
      });
    };

    const updateStickyHeaders = () => {
      document.querySelectorAll(`.${stickyClass}`).forEach((sectionWrapper) => {
        sectionWrapper.classList.toggle(scrolledClass, window.scrollY > 0);
      });
    };

    initializeHeader();
    document.addEventListener('shopify:section:load', (event) => initializeHeader(event.target));
    window.addEventListener('scroll', updateStickyHeaders, { passive: true });

    document.addEventListener('toggle', (event) => {
      const menu = event.target.closest?.('[data-aurelle-mobile-menu]');
      if (!menu || event.target !== menu) return;
      menu.querySelector(':scope > summary')?.setAttribute('aria-expanded', String(menu.open));
      if (!menu.open) resetMobileMenu(menu);
    }, true);

    document.addEventListener('click', (event) => {
      const desktopToggle = event.target.closest('[data-aurelle-desktop-toggle]');
      if (desktopToggle) {
        const item = desktopToggle.closest('[data-aurelle-desktop-nav-item]');
        const header = desktopToggle.closest('[data-aurelle-header]');
        const willOpen = desktopToggle.getAttribute('aria-expanded') !== 'true';
        closeDesktopMenus(header, item);
        setDesktopItemOpen(item, willOpen);
        return;
      }

      const mobileToggle = event.target.closest('[data-aurelle-submenu-toggle]');
      if (mobileToggle) {
        setMobileSubmenuOpen(mobileToggle, mobileToggle.getAttribute('aria-expanded') !== 'true');
        return;
      }

      document.querySelectorAll('[data-aurelle-header]').forEach((header) => closeDesktopMenus(header));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const header = event.target.closest?.('[data-aurelle-header]');
      if (!header) return;

      const openDesktopItem = event.target.closest('[data-aurelle-desktop-nav-item].is-open') || header.querySelector('[data-aurelle-desktop-nav-item].is-open');
      if (openDesktopItem) {
        const toggle = openDesktopItem.querySelector(':scope > .aurelle-header__desktop-link-row > [data-aurelle-desktop-toggle]');
        setDesktopItemOpen(openDesktopItem, false);
        toggle?.focus();
        event.preventDefault();
        return;
      }

      const expandedMobileButtons = [...header.querySelectorAll('[data-aurelle-submenu-toggle][aria-expanded="true"]')];
      const deepestMobileButton = expandedMobileButtons.reverse().find((button) => document.getElementById(button.getAttribute('aria-controls'))?.contains(event.target)) || expandedMobileButtons[0];
      if (deepestMobileButton) {
        setMobileSubmenuOpen(deepestMobileButton, false);
        deepestMobileButton.focus();
        event.preventDefault();
        return;
      }

      const mobileMenu = header.querySelector('[data-aurelle-mobile-menu][open]');
      if (mobileMenu) {
        mobileMenu.open = false;
        mobileMenu.querySelector(':scope > summary')?.focus();
        event.preventDefault();
      }
    });

    document.addEventListener('focusin', (event) => {
      const focusedHeader = event.target.closest?.('[data-aurelle-header]');
      document.querySelectorAll('[data-aurelle-header]').forEach((header) => {
        const focusedItem = header === focusedHeader ? event.target.closest('[data-aurelle-desktop-nav-item]') : null;
        closeDesktopMenus(header, focusedItem);
      });
    });

    window.addEventListener('resize', () => {
      document.querySelectorAll('[data-aurelle-header]').forEach((header) => {
        if (window.matchMedia('(min-width: 1001px)').matches) {
          const mobileMenu = header.querySelector('[data-aurelle-mobile-menu]');
          if (mobileMenu?.open) mobileMenu.open = false;
        } else {
          closeDesktopMenus(header);
        }
      });
    }, { passive: true });
  })();

  document.addEventListener('change', (event) => {
    if (event.target.matches('[data-aurelle-localization-select]')) {
      event.target.form?.requestSubmit();
    }
  });

  document.addEventListener('click', (event) => {
    const openButton = event.target.closest('[data-aurelle-search-open]');

    if (openButton) {
      const dialog = document.getElementById(openButton.getAttribute('aria-controls'));

      if (dialog && !dialog.open) {
        dialog.addEventListener('close', () => openButton.focus(), { once: true });
        dialog.showModal();
        window.requestAnimationFrame(() => dialog.querySelector('input[type="search"]')?.focus());
      }

      return;
    }

    const closeButton = event.target.closest('[data-aurelle-search-close]');
    if (closeButton) {
      closeButton.closest('dialog')?.close();
      return;
    }

    if (event.target.matches('[data-aurelle-search-dialog]')) {
      event.target.close();
    }
  });
{% endjavascript %}

