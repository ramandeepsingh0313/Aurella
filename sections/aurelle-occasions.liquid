<section
  class="aurelle-occasions full-width"
  style="--aurelle-occasions-background: {{ section.settings.background_color }}; --aurelle-occasions-foreground: {{ section.settings.foreground_color }}; --aurelle-occasions-accent: {{ section.settings.accent_color }};"
  aria-labelledby="AurelleOccasionsHeading-{{ section.id }}"
>
  <div class="aurelle-occasions__inner">
    <header class="aurelle-occasions__header">
      {% if section.settings.eyebrow != blank %}
        <p class="aurelle-occasions__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="aurelle-occasions__heading" id="AurelleOccasionsHeading-{{ section.id }}">
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="aurelle-occasions__description">{{ section.settings.description | escape }}</p>
      {% endif %}
    </header>

    {% if section.blocks.size > 0 %}
      <div class="aurelle-occasions__grid" role="list" aria-label="{{ section.settings.heading | escape }}">
        {% for block in section.blocks %}
          {% liquid
            assign occasion_title = block.settings.heading
            assign occasion_alt = block.settings.image_alt | default: occasion_title
            assign occasion_url = block.settings.link
            if block.settings.collection != blank
              assign occasion_url = block.settings.collection.url
            elsif occasion_url == blank
              assign occasion_url = routes.all_products_collection_url
            endif
          %}
          <a
            class="aurelle-occasions__card"
            href="{{ occasion_url | escape }}"
            role="listitem"
            {{ block.shopify_attributes }}
          >
            <div class="aurelle-occasions__media">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1000 | image_tag: class: 'aurelle-occasions__image', alt: occasion_alt, widths: '320, 480, 640, 800, 1000', sizes: '(min-width: 1100px) 25vw, (min-width: 701px) 50vw, 78vw', loading: 'lazy' }}
              {% else %}
                <div class="aurelle-occasions__placeholder" aria-hidden="true">
                  {{ 'image' | placeholder_svg_tag: 'aurelle-occasions__placeholder-svg' }}
                  {% if request.design_mode %}<span>Add an occasion photograph in this card's settings.</span>{% endif %}
                </div>
              {% endif %}
              <span class="aurelle-occasions__shade" aria-hidden="true"></span>
              <span class="aurelle-occasions__copy">
                {% if block.settings.eyebrow != blank %}
                  <span class="aurelle-occasions__card-eyebrow">{{ block.settings.eyebrow | escape }}</span>
                {% endif %}
                {% if occasion_title != blank %}
                  <span class="aurelle-occasions__card-title">{{ occasion_title | escape }}</span>
                {% endif %}
                {% if occasion_url != blank and block.settings.link_label != blank %}
                  <span class="aurelle-occasions__link-label">
                    {{ block.settings.link_label | escape }}
                    <span aria-hidden="true">&#8594;</span>
                  </span>
                {% endif %}
              </span>
            </div>
          </a>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .aurelle-occasions {
    width: 100%;
    padding-block: 82px 88px;
    color: var(--aurelle-occasions-foreground);
    background: var(--aurelle-occasions-background);
  }

  .aurelle-occasions__inner {
    width: min(1440px, calc(100% - 84px));
    margin-inline: auto;
  }

  .aurelle-occasions__header {
    text-align: center;
  }

  .aurelle-occasions__eyebrow {
    margin: 0 0 8px;
    color: var(--aurelle-occasions-accent);
    font-family: var(--font-primary--family);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .aurelle-occasions__heading {
    margin: 0;
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
    font-size: clamp(30px, 3.2vw, 38px);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .aurelle-occasions__description {
    margin: 8px 0 0;
    color: color-mix(in srgb, var(--aurelle-occasions-foreground) 72%, transparent);
    font-family: var(--font-primary--family);
    font-size: 12px;
    line-height: 1.5;
  }

  .aurelle-occasions__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin-top: 54px;
  }

  .aurelle-occasions__card {
    display: block;
    min-width: 0;
    overflow: hidden;
    color: #fff;
    background: #d9d3ca;
    border-radius: 2px;
    box-shadow: 0 2px 5px rgb(31 29 26 / 13%);
    text-decoration: none;
  }

  .aurelle-occasions__card:focus-visible {
    outline: 2px solid var(--aurelle-occasions-accent);
    outline-offset: 4px;
  }

  .aurelle-occasions__media {
    position: relative;
    aspect-ratio: 0.75;
    overflow: hidden;
    background: linear-gradient(145deg, #d9d4cd, #aaa197);
  }

  .aurelle-occasions__image,
  .aurelle-occasions__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 650ms cubic-bezier(0.2, 0.65, 0.3, 1);
  }

  .aurelle-occasions__placeholder {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 10px;
    padding: 18px;
    color: #514b43;
    background: linear-gradient(145deg, #e3ded7, #aaa197);
    text-align: center;
  }

  .aurelle-occasions__placeholder-svg {
    width: 46%;
    height: auto;
    fill: rgb(67 60 52 / 25%);
  }

  .aurelle-occasions__placeholder span {
    max-width: 210px;
    font-family: var(--font-primary--family);
    font-size: 11px;
    line-height: 1.45;
  }

  .aurelle-occasions__shade {
    position: absolute;
    inset: 28% 0 0;
    background: linear-gradient(180deg, transparent 0%, rgb(13 12 11 / 76%) 100%);
    pointer-events: none;
  }

  .aurelle-occasions__copy {
    position: absolute;
    right: 20px;
    bottom: 20px;
    left: 20px;
    display: grid;
    justify-items: start;
    gap: 5px;
  }

  .aurelle-occasions__card-eyebrow {
    color: #e2c786;
    font-family: var(--font-primary--family);
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.11em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .aurelle-occasions__card-title {
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
    font-size: clamp(17px, 1.7vw, 22px);
    font-weight: 400;
    line-height: 1.24;
  }

  .aurelle-occasions__link-label {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 6px;
    font-family: var(--font-primary--family);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.045em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .aurelle-occasions__link-label span {
    transition: transform 180ms ease;
  }

  .aurelle-occasions__card:hover .aurelle-occasions__image,
  .aurelle-occasions__card:focus-visible .aurelle-occasions__image,
  .aurelle-occasions__card:hover .aurelle-occasions__placeholder,
  .aurelle-occasions__card:focus-visible .aurelle-occasions__placeholder {
    transform: scale(1.035);
  }

  .aurelle-occasions__card:hover .aurelle-occasions__link-label span,
  .aurelle-occasions__card:focus-visible .aurelle-occasions__link-label span {
    transform: translateX(3px);
  }

  @media screen and (max-width: 1000px) {
    .aurelle-occasions__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .aurelle-occasions__card-title {
      font-size: clamp(19px, 2.5vw, 24px);
    }
  }

  @media screen and (max-width: 700px) {
    .aurelle-occasions {
      padding-block: 54px 60px;
    }

    .aurelle-occasions__inner {
      width: calc(100% - 40px);
    }

    .aurelle-occasions__heading {
      font-size: clamp(28px, 8vw, 34px);
    }

    .aurelle-occasions__description {
      max-width: 340px;
      margin-inline: auto;
      font-size: 11px;
    }

    .aurelle-occasions__grid {
      grid-auto-columns: min(78vw, 310px);
      grid-auto-flow: column;
      grid-template-columns: none;
      gap: 13px;
      margin-top: 32px;
      overflow-x: auto;
      padding: 0 1px 8px;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }

    .aurelle-occasions__card {
      scroll-snap-align: start;
    }

    .aurelle-occasions__copy {
      right: 16px;
      bottom: 16px;
      left: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aurelle-occasions__image,
    .aurelle-occasions__placeholder,
    .aurelle-occasions__link-label span {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AURELLE occasions",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Moments of Distinction" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Curated by Occasion" },
    { "type": "text", "id": "description", "label": "Description", "default": "Whether commemorating intimate triumphs or orchestrating grand milestones." },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#F0EDE8" },
    { "type": "color", "id": "foreground_color", "label": "Primary text", "default": "#24221F" },
    { "type": "color", "id": "accent_color", "label": "Muted gold accent", "default": "#806122" }
  ],
  "blocks": [
    {
      "type": "occasion",
      "name": "Occasion card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Card photograph" },
        { "type": "text", "id": "image_alt", "label": "Image alternative text" },
        { "type": "text", "id": "eyebrow", "label": "Card eyebrow", "default": "Capsule Collection" },
        { "type": "text", "id": "heading", "label": "Card heading", "default": "Everyday Refinement" },
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Optional. When selected, this collection is the card destination." },
        { "type": "url", "id": "link", "label": "Custom card link", "info": "Optional. Used when no collection is selected. Unset cards link to all products." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore edit" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "AURELLE occasions",
      "blocks": [
        { "type": "occasion", "settings": { "eyebrow": "Capsule Collection", "heading": "Everyday Refinement" } },
        { "type": "occasion", "settings": { "eyebrow": "Ceremony & Vows", "heading": "Wedding & Bridal" } },
        { "type": "occasion", "settings": { "eyebrow": "Heirlooms of Love", "heading": "Milestones & Anniversaries" } },
        { "type": "occasion", "settings": { "eyebrow": "Evening Gala", "heading": "The Black-Tie Suite" } }
      ]
    }
  ]
}
{% endschema %}
