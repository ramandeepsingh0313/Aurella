{% comment %}
  This section is used in the search template to render search results for
  products, articles, and pages.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/search
{% endcomment %}

<section class="aurelle-search full-width">
  <div class="aurelle-search__inner">
    <h1>{{ 'search.title' | t }}</h1>

    <form class="aurelle-search__form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="AurelleSearchPageInput-{{ section.id }}">{{ 'search.placeholder' | t }}</label>
      <input
        id="AurelleSearchPageInput-{{ section.id }}"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
      >
      <button type="submit">{{ 'search.submit' | t }}</button>
    </form>

    {% if search.performed %}
      {% if search.results_count == 0 %}
        {% assign search_message = 'search.no_results_html' | t: terms: search.terms %}
        <p>{{ search_message | escape }}</p>
      {% else %}
        {% assign search_message = 'search.results_for_html' | t: terms: search.terms, count: search.results_count %}
        <p>{{ search_message | escape }}</p>

        <div class="search-results">
          {% paginate search.results by 20 %}
            {% # Search result items may be an article, a page, or a product. %}
            {% for result in search.results %}
              <div class="search-result">
                {% assign featured_image = result.featured_image | default: result.image %}
                {% if featured_image %}
                  {% render 'image', class: 'search-result__image', image: featured_image, url: result.url, width: 400, sizes: '(min-width: 1000px) 25vw, (min-width: 600px) 33vw, 100vw' %}
                {% endif %}
                <div class="search-result__content">
                  <span class="search-result__type">
                    {% case result.object_type %}
                      {% when 'product' %}{{ 'search.product' | t }}
                      {% when 'article' %}{{ 'search.article' | t }}
                      {% when 'page' %}{{ 'search.page' | t }}
                    {% endcase %}
                  </span>
                  <p>
                    {{ result.title | link_to: result.url }}
                    {% if result.price %}
                      {{ result.price | money_with_currency }}
                    {% endif %}
                  </p>
                </div>
              </div>
            {% endfor %}

            {{ paginate | default_pagination }}
          {% endpaginate %}
        </div>
      {% endif %}
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .aurelle-search {
    padding-block: clamp(36px, 6vw, 80px);
  }

  .aurelle-search__inner {
    width: min(1184px, calc(100% - clamp(32px, 8vw, 112px)));
    margin-inline: auto;
  }

  .aurelle-search__inner > h1 {
    margin-bottom: 24px;
    font-family: 'Bodoni MT', Didot, Georgia, 'Times New Roman', serif;
    font-size: clamp(34px, 5vw, 56px);
    font-weight: 400;
    line-height: 1.1;
  }

  .aurelle-search__form {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 28px;
  }

  .aurelle-search__form input {
    width: min(100%, 36rem);
    min-width: 0;
    min-height: 48px;
    flex: 1 1 16rem;
    padding: 10px 12px;
  }

  .aurelle-search__form button {
    min-height: 48px;
    padding: 10px 18px;
  }

  .search-results {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
    gap: clamp(16px, 2vw, 28px);
  }

  .search-result {
    min-width: 0;
  }

  .search-results .prev,
  .search-results .page,
  .search-results .next {
    grid-column: 1 / -1;
  }

  @media screen and (max-width: 520px) {
    .aurelle-search__inner {
      width: calc(100% - 32px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}
