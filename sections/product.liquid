{% javascript %}
  (() => {
    const sectionSelector = '[data-aurelle-product]';

    const initializeProductSection = (section) => {
      if (!section || section.dataset.productReady === 'true') return;
      const form = section.querySelector('form.aurelle-product__form');
      const variantSelect = section.querySelector('[data-variant-fallback]');
      const variantIdInput = section.querySelector('[data-current-variant-id]');
      const variantsScript = section.querySelector('[data-product-variants]');
      if (!form || !variantSelect || !variantIdInput || !variantsScript) return;

      let variants;
      try {
        variants = JSON.parse(variantsScript.textContent);
      } catch {
        return;
      }
      if (!Array.isArray(variants) || !variants.length) return;

      section.dataset.productReady = 'true';
      section.classList.add('is-enhanced');
      variantSelect.removeAttribute('name');
      variantSelect.hidden = true;
      variantIdInput.name = 'id';

      const price = section.querySelector('[data-product-price]');
      const comparePrice = section.querySelector('[data-product-compare]');
      const unitPrice = section.querySelector('[data-product-unit-price]');
      const addButton = section.querySelector('[data-product-atc]');
      const availability = section.querySelector('[data-product-availability]');
      const availabilityCopy = section.querySelector('[data-availability-copy]');
      const dispatchNote = section.querySelector('[data-dispatch-note]');
      const productStatus = section.querySelector('[data-product-status]');
      const skuContainer = section.querySelector('.aurelle-product__sku');
      const sku = section.querySelector('[data-product-sku]');
      const quantityInput = section.querySelector('[data-quantity-input]');
      const sellingPlanInput = section.querySelector('[data-selling-plan-input]');
      const sellingPlanOptions = [...section.querySelectorAll('[data-selling-plan-option]')];
      const pickupContainer = section.querySelector('[data-pickup-container]');
      const recipient = section.querySelector('[data-gift-recipient]');
      if (recipient) {
        const toggle = recipient.querySelector('[data-gift-recipient-toggle]');
        const fields = recipient.querySelector('[data-gift-recipient-fields]');
        const email = recipient.querySelector('[data-gift-recipient-email]');
        const date = recipient.querySelector('[data-gift-recipient-date]');
        const offset = recipient.querySelector('[data-gift-recipient-offset]');
        const dynamicCheckout = section.querySelector('[data-dynamic-checkout]');
        const formatLocalDate = (value) => `${value.getFullYear()}-${String(value.getMonth() + 1).padStart(2, '0')}-${String(value.getDate()).padStart(2, '0')}`;
        if (date) {
          const today = new Date();
          const lastDay = new Date(today);
          lastDay.setDate(lastDay.getDate() + 90);
          date.min = formatLocalDate(today);
          date.max = formatLocalDate(lastDay);
        }
        if (offset) offset.value = String(new Date().getTimezoneOffset());
        const updateRecipient = () => {
          const enabled = Boolean(toggle?.checked);
          if (fields) fields.disabled = !enabled;
          if (email) email.required = enabled;
          if (dynamicCheckout) dynamicCheckout.hidden = enabled;
        };
        toggle?.addEventListener('change', updateRecipient);
        updateRecipient();
      }

      const getOptionValues = () => {
        const values = [];
        section.querySelectorAll('[data-product-option]').forEach((option) => {
          const index = Number(option.dataset.optionIndex);
          if (option.type === 'radio') {
            if (option.checked) values[index] = option.value;
          } else {
            values[index] = option.value;
          }
        });
        return values;
      };

      const showMedia = (mediaId) => {
        if (!mediaId) return;
        let activeIndex = 0;
        const mediaItems = [...section.querySelectorAll('[data-gallery-item]')];
        const thumbnails = [...section.querySelectorAll('[data-gallery-thumb]')];
        mediaItems.forEach((item, index) => {
          item.hidden = item.dataset.mediaId !== String(mediaId);
          if (!item.hidden) activeIndex = index;
        });
        thumbnails.forEach((thumbnail) => {
          const selected = thumbnail.dataset.mediaId === String(mediaId);
          thumbnail.classList.toggle('is-active', selected);
          thumbnail.setAttribute('aria-pressed', String(selected));
        });
        const count = section.querySelector('[data-gallery-count]');
        if (count && mediaItems.length) count.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${String(mediaItems.length).padStart(2, '0')}`;
      };

      const updateOptionAvailability = () => {
        const selected = getOptionValues();
        section.querySelectorAll('[data-product-option]').forEach((control) => {
          const index = Number(control.dataset.optionIndex);
          const isCompatible = (candidateValue) => variants.some((variant) => variant.available && variant.options[index] === candidateValue && variant.options.every((value, optionIndex) => optionIndex >= index || !selected[optionIndex] || value === selected[optionIndex]));
          if (control.tagName === 'SELECT') {
            [...control.options].forEach((option) => { option.disabled = !isCompatible(option.value); });
          } else {
            const compatible = isCompatible(control.value);
            control.disabled = !compatible;
            control.closest('label')?.classList.toggle('is-unavailable', !compatible);
          }
        });
      };

      const updatePickupAvailability = async (variantId) => {
        if (!pickupContainer || !variantId) return;
        pickupContainer.setAttribute('aria-busy', 'true');
        try {
          const rootUrl = pickupContainer.dataset.rootUrl || '/';
          const response = await fetch(`${rootUrl}variants/${variantId}/?section_id=pickup-availability`);
          if (!response.ok) throw new Error('Pickup availability request failed');
          const documentFragment = new DOMParser().parseFromString(await response.text(), 'text/html');
          const responseContent = documentFragment.querySelector('[data-pickup-response]');
          pickupContainer.innerHTML = responseContent?.innerHTML || '';
        } catch {
          pickupContainer.innerHTML = '';
        } finally {
          pickupContainer.removeAttribute('aria-busy');
        }
      };

      const updateSellingPlans = (variant) => {
        if (!sellingPlanOptions.length) return null;
        const allocations = variant.selling_plan_allocations || [];
        sellingPlanOptions.forEach((option) => {
          if (!option.value) return;
          option.disabled = !allocations.some((allocation) => String(allocation.selling_plan_id) === option.value);
        });
        let selectedOption = section.querySelector('[data-selling-plan-option]:checked');
        if (!selectedOption || selectedOption.disabled) {
          selectedOption = sellingPlanOptions.find((option) => !option.disabled);
          if (selectedOption) selectedOption.checked = true;
        }
        const planId = selectedOption?.value || '';
        if (sellingPlanInput) {
          sellingPlanInput.value = planId;
          sellingPlanInput.disabled = !planId;
        }
        return allocations.find((allocation) => String(allocation.selling_plan_id) === planId) || null;
      };

      const updateDisplayedPrice = (variant, allocation = null) => {
        const displayPrice = allocation?.price_text || variant.price_text;
        const displayComparePrice = allocation?.compare_at_price_text || variant.compare_at_price_text;
        const displayPriceValue = allocation?.price ?? variant.price;
        const displayCompareValue = allocation?.compare_at_price ?? variant.compare_at_price;
        if (price) price.textContent = displayPrice;
        const atcPrice = addButton?.querySelector('[data-atc-price]');
        if (atcPrice) atcPrice.textContent = displayPrice;
        if (comparePrice) {
          comparePrice.hidden = !(displayCompareValue && displayCompareValue > displayPriceValue);
          comparePrice.textContent = displayComparePrice || '';
        }
      };

      const updateVariant = () => {
        const optionValues = getOptionValues();
        const variant = variants.find((item) => item.options.length === optionValues.length && item.options.every((value, index) => value === optionValues[index]));
        const atcLabel = addButton?.querySelector('[data-atc-label]');
        if (!variant) {
          if (availability) availability.classList.add('is-unavailable');
          if (availabilityCopy) availabilityCopy.textContent = availability?.dataset.unavailableLabel || '';
          if (addButton) {
            addButton.disabled = true;
            if (atcLabel) atcLabel.textContent = addButton.dataset.labelUnavailable || '';
          }
          if (productStatus) productStatus.textContent = 'This option combination is unavailable.';
          return;
        }

        variantIdInput.value = variant.id;
        variantSelect.value = String(variant.id);
        variantIdInput.dispatchEvent(new Event('change', { bubbles: true }));
        const sellingPlanAllocation = updateSellingPlans(variant);
        const sellingPlanRequired = section.dataset.requiresSellingPlan === 'true';
        const sellingPlanValid = !sellingPlanRequired || Boolean(sellingPlanAllocation);
        updateDisplayedPrice(variant, sellingPlanAllocation);
        if (unitPrice) {
          const unitPriceText = sellingPlanAllocation?.unit_price_text || variant.unit_price_text;
          unitPrice.hidden = !unitPriceText;
          unitPrice.textContent = unitPriceText || '';
        }
        if (availability) availability.classList.toggle('is-unavailable', !variant.available);
        if (availabilityCopy) {
          const lowStockThreshold = Number(availability?.dataset.lowStockThreshold || 5);
          const lowStock = variant.available && variant.inventory_management && variant.inventory_policy === 'deny' && variant.inventory_quantity > 0 && variant.inventory_quantity <= lowStockThreshold;
          availabilityCopy.textContent = lowStock ? `Only ${variant.inventory_quantity} left` : (variant.available ? availability.dataset.availableLabel : availability.dataset.unavailableLabel);
        }
        if (dispatchNote) dispatchNote.hidden = !variant.available;
        if (addButton) {
          addButton.disabled = !variant.available || !sellingPlanValid;
          if (atcLabel) atcLabel.textContent = variant.available && sellingPlanValid ? addButton.dataset.labelAvailable : addButton.dataset.labelUnavailable;
        }
        if (skuContainer && sku) {
          sku.textContent = variant.sku || '';
          skuContainer.hidden = !variant.sku;
        }
        if (quantityInput) {
          const rule = variant.quantity_rule || { min: 1, max: null, increment: 1 };
          quantityInput.min = String(rule.min || 1);
          quantityInput.step = String(rule.increment || 1);
          if (rule.max) quantityInput.max = String(rule.max);
          else quantityInput.removeAttribute('max');
          const currentQuantity = Number.parseInt(quantityInput.value, 10) || rule.min || 1;
          const boundedQuantity = rule.max ? Math.min(rule.max, currentQuantity) : currentQuantity;
          quantityInput.value = String(Math.max(rule.min || 1, boundedQuantity));
        }

        section.querySelectorAll('[data-option-group]').forEach((group) => {
          const selected = group.querySelector('[data-product-option]:checked') || group.querySelector('[data-product-option]');
          const currentValue = group.querySelector('[data-option-current]');
          if (selected && currentValue) currentValue.textContent = selected.value;
        });
        if (variant.featured_media_id) showMedia(variant.featured_media_id);
        updateOptionAvailability();
        updatePickupAvailability(variant.id);
        if (productStatus) productStatus.textContent = `${variant.options.join(', ')}. ${variant.available && sellingPlanValid ? 'Available' : 'Unavailable'}. ${sellingPlanAllocation?.price_text || variant.price_text}`;
        const url = new URL(window.location.href);
        url.searchParams.set('variant', variant.id);
        window.history.replaceState({}, '', url);
      };

      form.addEventListener('change', (event) => {
        if (event.target.matches('[data-product-option]')) updateVariant();
        if (event.target.matches('[data-selling-plan-option]')) {
          const variant = variants.find((item) => String(item.id) === variantIdInput.value);
          if (variant) updateVariant();
        }
      });

      section.addEventListener('click', (event) => {
        const openButton = event.target.closest('[data-pickup-open]');
        const closeButton = event.target.closest('[data-pickup-close]');
        if (openButton) {
          const dialogId = openButton.getAttribute('aria-controls');
          const pickupDialog = dialogId ? section.querySelector(`#${CSS.escape(dialogId)}`) : null;
          if (pickupDialog && typeof pickupDialog.showModal === 'function') pickupDialog.showModal();
        }
        if (closeButton) closeButton.closest('[data-pickup-dialog]')?.close();
      });
      section.querySelectorAll('[data-gallery-thumb]').forEach((thumbnail) => {
        thumbnail.addEventListener('click', () => showMedia(thumbnail.dataset.mediaId));
      });

      section.querySelectorAll('[data-quantity-step]').forEach((button) => {
        button.addEventListener('click', () => {
          const input = quantityInput;
          if (!input) return;
          const current = Number.parseInt(input.value, 10) || Number(input.min) || 1;
          const increment = Number(input.step) || 1;
          const minimum = Number(input.min) || 1;
          const maximum = input.max ? Number(input.max) : Number.POSITIVE_INFINITY;
          input.value = String(Math.min(maximum, Math.max(minimum, current + (Number(button.dataset.quantityStep) * increment))));
          input.dispatchEvent(new Event('change', { bubbles: true }));
        });
      });

      quantityInput?.addEventListener('change', () => {
        const minimum = Number(quantityInput.min) || 1;
        const maximum = quantityInput.max ? Number(quantityInput.max) : Number.POSITIVE_INFINITY;
        const increment = Number(quantityInput.step) || 1;
        let value = Number.parseInt(quantityInput.value, 10) || minimum;
        value = Math.min(maximum, Math.max(minimum, value));
        value = minimum + Math.floor((value - minimum) / increment) * increment;
        quantityInput.value = String(value);
      });

      const engravingToggle = section.querySelector('[data-engraving-toggle]');
      const engravingInput = section.querySelector('[data-engraving-input]');
      engravingToggle?.addEventListener('change', () => {
        if (!engravingInput) return;
        engravingInput.hidden = !engravingToggle.checked;
        engravingInput.required = engravingToggle.checked;
        if (engravingToggle.checked) engravingInput.focus();
        else engravingInput.value = '';
      });

      section.querySelectorAll('[data-product-tab]').forEach((tab) => {
        tab.addEventListener('click', () => {
          section.querySelectorAll('[data-product-tab]').forEach((item) => {
            const active = item === tab;
            item.setAttribute('aria-selected', String(active));
            item.tabIndex = active ? 0 : -1;
          });
          section.querySelectorAll('[data-product-panel]').forEach((panel) => {
            panel.hidden = panel.dataset.productPanel !== tab.dataset.productTab;
          });
        });
        tab.addEventListener('keydown', (event) => {
          if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
          event.preventDefault();
          const tabs = [...section.querySelectorAll('[data-product-tab]')];
          let index = tabs.indexOf(tab);
          if (event.key === 'Home') index = 0;
          else if (event.key === 'End') index = tabs.length - 1;
          else index = (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
          tabs[index].focus();
          tabs[index].click();
        });
      });

      const dialog = section.querySelector('[data-gallery-dialog]');
      const dialogImage = section.querySelector('[data-gallery-dialog-image]');
      section.querySelector('[data-gallery-open]')?.addEventListener('click', () => {
        const activeImage = section.querySelector('[data-gallery-item]:not([hidden]) img');
        if (!activeImage || !dialog || !dialogImage) return;
        dialogImage.src = activeImage.currentSrc || activeImage.src;
        dialogImage.alt = activeImage.alt;
        if (typeof dialog.showModal === 'function') dialog.showModal();
      });
      section.querySelector('[data-gallery-close]')?.addEventListener('click', () => dialog?.close());
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });

      const enquiryDialog = section.querySelector('[data-product-enquiry]');
      const enquiryHeading = enquiryDialog?.querySelector('[data-enquiry-heading]');
      const enquiryTypeInput = enquiryDialog?.querySelector('[data-enquiry-type-input]');
      section.querySelectorAll('[data-enquiry-open]').forEach((trigger) => {
        trigger.addEventListener('click', () => {
          if (!enquiryDialog) return;
          if (enquiryHeading) enquiryHeading.textContent = trigger.dataset.enquiryTitle || '';
          if (enquiryTypeInput) enquiryTypeInput.value = trigger.dataset.enquiryType || '';
          if (typeof enquiryDialog.showModal === 'function') enquiryDialog.showModal();
          else enquiryDialog.setAttribute('open', '');
        });
      });
      section.querySelector('[data-enquiry-close]')?.addEventListener('click', () => {
        if (typeof enquiryDialog?.close === 'function') enquiryDialog.close();
        else enquiryDialog?.removeAttribute('open');
      });
      enquiryDialog?.addEventListener('click', (event) => {
        if (event.target !== enquiryDialog) return;
        if (typeof enquiryDialog.close === 'function') enquiryDialog.close();
        else enquiryDialog.removeAttribute('open');
      });
      if (enquiryDialog?.querySelector('[data-enquiry-success], .aurelle-product__form-errors') && typeof enquiryDialog.showModal === 'function') {
        enquiryDialog.showModal();
      }

      updateVariant();
    };

    const initialize = (root = document) => {
      if (root.matches?.(sectionSelector)) initializeProductSection(root);
      root.querySelectorAll?.(sectionSelector).forEach(initializeProductSection);
    };

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => initialize(), { once: true });
    else initialize();
    document.addEventListener('shopify:section:load', (event) => initialize(event.target));
  })();
{% endjavascript %}

