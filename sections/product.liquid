{% # theme-check-disable LiquidComplexity %}
{% liquid
  assign current_variant = product.selected_or_first_available_variant | default: product.variants.first
  assign active_collection = collection | default: section.settings.related_collection | default: product.collections.first
  assign active_media = current_variant.featured_media | default: product.featured_media | default: product.media.first
  assign product_eyebrow = product.metafields.custom.collection_label.value | default: product.collections.first.title | default: product.vendor
  assign product_subtitle = product.metafields.custom.product_subtitle.value | default: product.type
  assign gallery_badge = product.metafields.custom.gallery_badge.value
  assign gallery_caption = product.metafields.custom.gallery_caption.value
  assign rating_value = product.metafields.reviews.rating.value.rating | default: product.metafields.custom.rating.value
  assign review_count = product.metafields.reviews.rating_count.value | default: product.metafields.custom.review_count.value
  assign dispatch_note = product.metafields.custom.dispatch_note.value | default: section.settings.dispatch_note
  assign product_engravable = section.settings.enable_engraving
  if product.metafields.custom.enable_engraving != blank
    assign product_engravable = product.metafields.custom.enable_engraving.value
  endif
  assign atelier_image = product.metafields.custom.atelier_image.value | default: section.settings.atelier_image
  assign details_heading = product.metafields.custom.details_heading.value | default: product.title | default: section.settings.details_heading
  assign details_intro = product.metafields.custom.details_intro.value | default: product.description | strip_html
  assign details_note = product.metafields.custom.details_note.value | default: section.settings.details_note
  assign atelier_heading = product.metafields.custom.atelier_heading.value | default: section.settings.atelier_heading
  assign atelier_description = product.metafields.custom.atelier_description.value
  assign atelier_badge = product.metafields.custom.atelier_badge.value | default: section.settings.atelier_badge
  assign atelier_stat_one = product.metafields.custom.atelier_stat_one.value | default: section.settings.atelier_stat_one
  assign atelier_stat_one_label = product.metafields.custom.atelier_stat_one_label.value | default: section.settings.atelier_stat_one_label
  assign atelier_stat_two = product.metafields.custom.atelier_stat_two.value | default: section.settings.atelier_stat_two
  assign atelier_stat_two_label = product.metafields.custom.atelier_stat_two_label.value | default: section.settings.atelier_stat_two_label
  assign enquiry_form_id = 'AurelleContactForm-' | append: section.id
%}

{% if product != blank %}
  <section class="aurelle-product full-width" data-aurelle-product data-section-id="{{ section.id }}" data-requires-selling-plan="{{ product.requires_selling_plan }}" aria-label="{{ product.title | escape }}">
    <div class="aurelle-product__page-width">
      <nav class="aurelle-product__breadcrumbs" aria-label="{{ 'products.aurelle.breadcrumbs' | t }}">
        <a href="{{ routes.root_url }}">{{ 'products.aurelle.home' | t }}</a>
        <span aria-hidden="true">/</span>
        {% if active_collection != blank %}
          <a href="{{ active_collection.url }}">{{ active_collection.title | escape }}</a>
          <span aria-hidden="true">/</span>
        {% elsif product.type != blank %}
          <span>{{ product.type | escape }}</span>
          <span aria-hidden="true">/</span>
        {% endif %}
        <span aria-current="page">{{ product.title | escape }}</span>
      </nav>

      <div class="aurelle-product__overview">
        <div class="aurelle-product__gallery" data-product-gallery>
          <div class="aurelle-product__gallery-stage">
            {% if product.media.size > 0 %}
              {% for media in product.media %}
                {% assign media_alt = media.alt | default: product.title %}
                <div class="aurelle-product__media-item" data-gallery-item data-media-id="{{ media.id }}"{% unless media.id == active_media.id %} hidden{% endunless %}>
                  {% if media.media_type == 'image' %}
                    {{ media.preview_image | image_url: width: 1600 | image_tag: class: 'aurelle-product__main-image', alt: media_alt, widths: '480, 640, 800, 1000, 1200, 1600', sizes: '(min-width: 1000px) 50vw, 100vw', loading: 'eager', fetchpriority: 'high' }}
                  {% else %}
                    {{ media | media_tag: image_size: '1200x', controls: true, preload: 'none' }}
                  {% endif %}
                </div>
              {% endfor %}
            {% else %}
              <div class="aurelle-product__media-item aurelle-product__media-item--empty">
                {{ 'product-1' | placeholder_svg_tag: 'aurelle-product__placeholder' }}
              </div>
            {% endif %}

            {% if gallery_badge != blank %}<span class="aurelle-product__gallery-badge">{{ gallery_badge | escape }}</span>{% endif %}

            {% if product.media.size > 0 %}
              <button class="aurelle-product__fullscreen" type="button" data-gallery-open aria-label="{{ 'products.aurelle.open_image' | t }}">
                <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M7 3H3v4M13 3h4v4M17 13v4h-4M3 13v4h4M3 7l5-5M17 7l-5-5M17 13l-5 5M3 13l5 5" /></svg>
              </button>
            {% endif %}
          </div>

          {% if product.media.size > 0 %}
          <div class="aurelle-product__thumbnails" role="group" aria-label="{{ 'products.aurelle.gallery' | t: title: product.title | escape }}">
              {% for media in product.media %}
                {% assign thumbnail_alt = media.alt | default: product.title %}
                <button
                  class="aurelle-product__thumbnail{% if media.id == active_media.id %} is-active{% endif %}"
                  type="button"
                  data-gallery-thumb
                  data-media-id="{{ media.id }}"
                  aria-pressed="{% if media.id == active_media.id %}true{% else %}false{% endif %}"
                  aria-label="{{ 'products.aurelle.view_image' | t: index: forloop.index }}"
                >
                  {{ media.preview_image | image_url: width: 420 | image_tag: alt: thumbnail_alt, widths: '140, 210, 280, 420', sizes: '(min-width: 1000px) 17vw, 32vw', loading: 'lazy' }}
                  {% if media.media_type != 'image' %}<span class="aurelle-product__thumbnail-type" aria-hidden="true">{{ media.media_type | upcase }}</span>{% endif %}
                </button>
              {% endfor %}
            </div>
          {% endif %}

          <div class="aurelle-product__gallery-caption">
            {% if gallery_caption != blank %}<p>{{ gallery_caption | escape }}</p>{% endif %}
            {% if product.media.size > 0 %}
              {% assign gallery_total = product.media.size %}
              {% if gallery_total < 10 %}{% assign gallery_total = gallery_total | prepend: '0' %}{% endif %}
              <span data-gallery-count>01 / {{ gallery_total }}</span>
            {% endif %}
          </div>
        </div>

        <div class="aurelle-product__purchase">
          {% if product_eyebrow != blank %}<p class="aurelle-product__eyebrow">{{ product_eyebrow | escape }}</p>{% endif %}
          {% assign product_info_block_count = 0 %}
          {% for block in section.blocks %}
            {% unless block.type == 'service' or block.type == '@app' %}{% assign product_info_block_count = product_info_block_count | plus: 1 %}{% endunless %}
          {% endfor %}

          {% if product_info_block_count > 0 %}
            {% if rating_value != blank and review_count != blank and review_count != 0 %}
              <a class="aurelle-product__rating" href="#AurelleReviews-{{ section.id }}" aria-label="{{ 'products.aurelle.rating_summary' | t: rating: rating_value, count: review_count }}">
                <span class="aurelle-product__stars" aria-hidden="true">★★★★★</span>
                <span class="aurelle-product__rating-copy">{{ rating_value | round: 1 }} · {{ review_count }} {{ 'products.aurelle.reviews' | t }}</span>
              </a>
            {% endif %}
            {% assign product_form_id = 'AurelleProductForm-' | append: section.id %}
            {% form 'product', product, id: product_form_id, class: 'aurelle-product__form' %}
              <input type="hidden" value="{{ current_variant.id }}" data-current-variant-id>
              <input type="hidden" name="selling_plan" value="" data-selling-plan-input disabled>
              <label class="visually-hidden" for="AurelleVariant-{{ section.id }}">{{ 'products.product.choose_options' | t }}</label>
              <select id="AurelleVariant-{{ section.id }}" class="aurelle-product__fallback-variant" name="id" data-variant-fallback>
                {% for variant in product.variants %}<option value="{{ variant.id }}"{% if variant.id == current_variant.id %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money_with_currency }}{% unless variant.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}</option>{% endfor %}
              </select>
              <p class="visually-hidden" role="status" aria-live="polite" data-product-status></p>
              {% for block in section.blocks %}
                {% unless block.type == 'service' or block.type == '@app' %}
                  {% render 'aurelle-product-info-block', block_type: block.type, block: block, product: product, current_variant: current_variant, form: form, section_id: section.id, dispatch_note: dispatch_note, product_engravable: product_engravable, engraving_label: section.settings.engraving_label, engraving_limit: section.settings.engraving_limit, size_guide_link: section.settings.size_guide_link, show_dynamic_checkout: section.settings.show_dynamic_checkout %}
                {% endunless %}
              {% endfor %}
              {% if form.errors %}<div class="aurelle-product__form-errors" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
              <div class="aurelle-product__form-errors" role="alert" data-product-error hidden></div>
            {% endform %}
          {% else %}
          <h1 class="aurelle-product__title">{{ product.title | escape }}</h1>

          {% if product_subtitle != blank %}<p class="aurelle-product__subtitle">{{ product_subtitle | escape }}</p>{% endif %}

          {% if rating_value != blank and review_count != blank and review_count != 0 %}
            <a class="aurelle-product__rating" href="#AurelleReviews-{{ section.id }}" aria-label="{{ 'products.aurelle.rating_summary' | t: rating: rating_value, count: review_count }}">
              <span class="aurelle-product__stars" aria-hidden="true">★★★★★</span>
              <span class="aurelle-product__rating-copy">{{ rating_value | round: 1 }} · {{ review_count }} {{ 'products.aurelle.reviews' | t }}</span>
            </a>
          {% endif %}

          <div class="aurelle-product__price-wrap" aria-live="polite">
            <p class="aurelle-product__price" data-product-price>{{ current_variant.price | money_with_currency }}</p>
            <s class="aurelle-product__compare-price" data-product-compare{% unless current_variant.compare_at_price > current_variant.price %} hidden{% endunless %}>{{ current_variant.compare_at_price | money_with_currency }}</s>
          </div>
          <p class="aurelle-product__unit-price" data-product-unit-price{% if current_variant.unit_price == blank %} hidden{% endif %}>{{ current_variant.unit_price | unit_price_with_measurement: current_variant.unit_price_measurement }}</p>
          {% if cart.taxes_included %}<p class="aurelle-product__tax-note">{{ 'products.aurelle.taxes_included' | t }}</p>{% endif %}
          {% if section.settings.delivery_note != blank %}<p class="aurelle-product__tax-note">{{ section.settings.delivery_note | escape }}</p>{% endif %}

          <div class="aurelle-product__rule"></div>

          {% if product.description != blank %}
            <div class="aurelle-product__description rte">{{ product.description }}</div>
          {% endif %}

          {% assign product_form_id = 'AurelleProductForm-' | append: section.id %}
          {% form 'product', product, id: product_form_id, class: 'aurelle-product__form' %}
            <input type="hidden" value="{{ current_variant.id }}" data-current-variant-id>
            <label class="visually-hidden" for="AurelleVariant-{{ section.id }}">{{ 'products.product.choose_options' | t }}</label>
            <select id="AurelleVariant-{{ section.id }}" class="aurelle-product__fallback-variant" name="id" data-variant-fallback>
              {% for variant in product.variants %}
                <option value="{{ variant.id }}"{% if variant.id == current_variant.id %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>
                  {{ variant.title | escape }} — {{ variant.price | money_with_currency }}{% unless variant.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}
                </option>
              {% endfor %}
            </select>
            <div class="aurelle-product__payment-terms">{{ form | payment_terms }}</div>

            {% for product_option in product.options_with_values %}
              {% assign option_position = forloop.index0 %}
              {% assign option_name_downcase = product_option.name | downcase %}
              {% assign render_swatch_option = false %}
              {% for option_value in product_option.values %}
                {% if option_value.swatch != blank %}{% assign render_swatch_option = true %}{% endif %}
              {% endfor %}
              <fieldset class="aurelle-product__option" data-option-group data-option-index="{{ option_position }}">
                <legend>{{ product_option.name | escape }} <span data-option-current>{{ current_variant.options[option_position] | escape }}</span></legend>
                {% if option_name_downcase contains 'size' %}
                  {% if section.settings.size_guide_link != blank %}
                    <a class="aurelle-product__size-guide" href="{{ section.settings.size_guide_link }}">{{ 'products.aurelle.find_your_size' | t }}</a>
                  {% else %}
                    <button class="aurelle-product__size-guide" type="button" data-enquiry-open data-enquiry-title="{{ 'products.aurelle.size_advice_title' | t | escape }}" data-enquiry-type="{{ 'products.aurelle.size_advice_title' | t | escape }}">{{ 'products.aurelle.find_your_size' | t }}</button>
                  {% endif %}
                {% endif %}
                {% if render_swatch_option %}
                  <div class="aurelle-product__swatches">
                    {% for option_value in product_option.values %}
                      {% assign option_value_name = option_value.name | default: option_value %}
                      {% assign option_input_id = 'AurelleOption-' | append: section.id | append: '-' | append: option_position | append: '-' | append: forloop.index %}
                      <label class="aurelle-product__swatch{% if option_value.swatch == blank %} aurelle-product__swatch--text{% endif %}" for="{{ option_input_id }}" title="{{ option_value_name | escape }}">
                        <input id="{{ option_input_id }}" type="radio" name="AurelleOption-{{ section.id }}-{{ option_position }}" value="{{ option_value_name | escape }}" data-product-option data-option-index="{{ option_position }}" data-option-label="{{ product_option.name | escape }}"{% if option_value_name == current_variant.options[option_position] %} checked{% endif %}>
                        {% if option_value.swatch.image != blank %}
                          <span class="aurelle-product__swatch-dot aurelle-product__swatch-dot--image" aria-hidden="true">{{ option_value.swatch.image | image_url: width: 64 | image_tag: alt: '', widths: '32, 64', sizes: '27px', loading: 'lazy' }}</span>
                        {% elsif option_value.swatch.color != blank %}
                          <span class="aurelle-product__swatch-dot" style="--aurelle-swatch: {{ option_value.swatch.color }}" aria-hidden="true"></span>
                        {% else %}
                          <span class="aurelle-product__swatch-text">{{ option_value_name | escape }}</span>
                        {% endif %}
                        <span class="visually-hidden">{{ option_value_name | escape }}</span>
                      </label>
                    {% endfor %}
                  </div>
                {% else %}
                  <label class="visually-hidden" for="AurelleSelect-{{ section.id }}-{{ option_position }}">{{ product_option.name | escape }}</label>
                  <select id="AurelleSelect-{{ section.id }}-{{ option_position }}" class="aurelle-product__select" data-product-option data-option-index="{{ option_position }}" data-option-label="{{ product_option.name | escape }}">
                    {% for option_value in product_option.values %}
                      {% assign option_value_name = option_value.name | default: option_value %}
                      <option value="{{ option_value_name | escape }}"{% if option_value_name == current_variant.options[option_position] %} selected{% endif %}>{{ option_value_name | escape }}</option>
                    {% endfor %}
                  </select>
                {% endif %}
              </fieldset>
            {% endfor %}

            {% if product_engravable %}
              <label class="aurelle-product__engraving-toggle">
                <input type="checkbox" data-engraving-toggle>
                <span>{{ section.settings.engraving_label | escape }}</span>
              </label>
              <label class="visually-hidden" for="AurelleEngraving-{{ section.id }}">{{ 'products.aurelle.engraving_text' | t }}</label>
              <input id="AurelleEngraving-{{ section.id }}" class="aurelle-product__engraving-input" type="text" name="properties[{{ section.settings.engraving_label | escape }}]" maxlength="{{ section.settings.engraving_limit }}" data-engraving-input hidden>
            {% endif %}

            {% if product.gift_card? %}{% render 'gift-card-recipient-form', section_id: section.id, form: form %}{% endif %}

            <p class="aurelle-product__availability" data-product-availability data-available-label="{{ 'products.aurelle.in_stock' | t | escape }}" data-unavailable-label="{{ 'products.product.sold_out' | t | escape }}">
              <span class="aurelle-product__availability-dot" aria-hidden="true"></span>
              <span data-availability-copy>{% if current_variant.available %}{{ 'products.aurelle.in_stock' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
              {% if current_variant.available and dispatch_note != blank %}<span data-dispatch-note>· {{ dispatch_note | escape }}</span>{% endif %}
            </p>

            <div class="aurelle-product__purchase-row">
              <div class="aurelle-product__quantity" aria-label="{{ 'products.aurelle.quantity' | t }}">
                <button type="button" data-quantity-step="-1" aria-label="{{ 'products.aurelle.decrease_quantity' | t }}">−</button>
                <label class="visually-hidden" for="AurelleQuantity-{{ section.id }}">{{ 'products.aurelle.quantity' | t }}</label>
                <input id="AurelleQuantity-{{ section.id }}" type="number" name="quantity" min="1" value="1" inputmode="numeric" data-quantity-input>
                <button type="button" data-quantity-step="1" aria-label="{{ 'products.aurelle.increase_quantity' | t }}">+</button>
              </div>
              <button class="aurelle-product__add-to-bag" type="submit" name="add" data-product-atc data-label-available="{{ 'products.aurelle.add_to_bag' | t | escape }}" data-label-unavailable="{{ 'products.product.sold_out' | t | escape }}"{% unless current_variant.available %} disabled{% endunless %}>
                <span data-atc-label>{% if current_variant.available %}{{ 'products.aurelle.add_to_bag' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
                <span aria-hidden="true">—</span>
                <span data-atc-price>{{ current_variant.price | money_with_currency }}</span>
              </button>
            </div>

            {% if form.errors %}<div class="aurelle-product__form-errors" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
            <div class="aurelle-product__form-errors" role="alert" data-product-error hidden></div>
            {% if section.settings.show_dynamic_checkout %}<div class="aurelle-product__dynamic-checkout" data-dynamic-checkout>{{ form | payment_button }}</div>{% endif %}
          {% endform %}
          {% endif %}

          {% if section.settings.show_pickup_availability %}
            <div class="aurelle-product__pickup" data-pickup-container data-root-url="{{ routes.root_url }}">
              {% render 'aurelle-pickup-availability', variant: current_variant, section_id: section.id %}
            </div>
          {% endif %}

          {% if section.settings.booking_link != blank %}
            <a class="aurelle-product__booking" href="{{ section.settings.booking_link }}">
              <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><rect x="3" y="5" width="14" height="12" rx="1"/><path d="M6 3v4M14 3v4M3 9h14M7 12h2M11 12h2"/></svg>
              <span>{{ 'products.aurelle.book_viewing' | t }}</span>
            </a>
          {% else %}
            <button class="aurelle-product__booking" type="button" data-enquiry-open data-enquiry-title="{{ 'products.aurelle.viewing_request_title' | t | escape }}" data-enquiry-type="{{ 'products.aurelle.book_viewing' | t | escape }}">
              <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><rect x="3" y="5" width="14" height="12" rx="1"/><path d="M6 3v4M14 3v4M3 9h14M7 12h2M11 12h2"/></svg>
              <span>{{ 'products.aurelle.book_viewing' | t }}</span>
            </button>
          {% endif %}

          {% if section.settings.gift_note != blank %}
            <p class="aurelle-product__gift-note">
              <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M2.5 8h15v9h-15zM1.5 5h17v3h-17zM10 5v12M10 5H6.5a2 2 0 1 1 0-4c2 0 3.5 4 3.5 4Zm0 0h3.5a2 2 0 1 0 0-4C11.5 1 10 5 10 5Z"/></svg>
              <span>{{ section.settings.gift_note | escape }}</span>
            </p>
          {% endif %}

          {% if section.settings.concierge_link != blank %}
            <p class="aurelle-product__concierge">
              <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 2.5a7.5 7.5 0 0 0-6.2 11.7L3 18l4-1.1A7.5 7.5 0 1 0 10 2.5Z"/><path d="M7 7.5h.01M10 7.5h.01M13 7.5h.01"/></svg>
              <span>{{ 'products.aurelle.questions' | t }} <a href="{{ section.settings.concierge_link }}">{{ 'products.aurelle.speak_to_concierge' | t }}</a></span>
            </p>
          {% else %}
            <p class="aurelle-product__concierge">
              <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 2.5a7.5 7.5 0 0 0-6.2 11.7L3 18l4-1.1A7.5 7.5 0 1 0 10 2.5Z"/><path d="M7 7.5h.01M10 7.5h.01M13 7.5h.01"/></svg>
              <span>{{ 'products.aurelle.questions' | t }} <button class="aurelle-product__concierge-link" type="button" data-enquiry-open data-enquiry-title="{{ 'products.aurelle.concierge_title' | t | escape }}" data-enquiry-type="{{ 'products.aurelle.speak_to_concierge' | t | escape }}">{{ 'products.aurelle.speak_to_concierge' | t }}</button></span>
            </p>
          {% endif %}

          <dialog class="aurelle-product__enquiry-dialog" data-product-enquiry aria-labelledby="AurelleEnquiryTitle-{{ section.id }}">
            <button class="aurelle-product__enquiry-close" type="button" data-enquiry-close aria-label="{{ 'products.aurelle.close_enquiry' | t | escape }}">&times;</button>
            <p class="aurelle-product__eyebrow">{{ 'products.aurelle.concierge_title' | t }}</p>
            <h2 id="AurelleEnquiryTitle-{{ section.id }}" data-enquiry-heading>{{ 'products.aurelle.concierge_title' | t }}</h2>
            {% form 'contact', id: enquiry_form_id, class: 'aurelle-product__enquiry-form' %}
              {% if form.posted_successfully? %}
                <p class="aurelle-product__enquiry-success" data-enquiry-success role="status">{{ 'products.aurelle.enquiry_success' | t }}</p>
              {% else %}
                {% if form.errors %}<div class="aurelle-product__form-errors" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
                <input type="hidden" name="contact[product]" value="{{ product.title | escape }}">
                <input type="hidden" name="contact[request_type]" value="{{ 'products.aurelle.speak_to_concierge' | t | escape }}" data-enquiry-type-input>
                <label for="AurelleContactName-{{ section.id }}">{{ 'products.aurelle.contact_name' | t }}</label>
                <input id="AurelleContactName-{{ section.id }}" type="text" name="contact[name]" autocomplete="name" required>
                <label for="AurelleContactEmail-{{ section.id }}">{{ 'products.aurelle.contact_email' | t }}</label>
                <input id="AurelleContactEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required>
                <label for="AurelleContactBody-{{ section.id }}">{{ 'products.aurelle.contact_message' | t }}</label>
                <textarea id="AurelleContactBody-{{ section.id }}" name="contact[body]" rows="4" required></textarea>
                <button class="aurelle-product__add-to-bag" type="submit">{{ 'products.aurelle.contact_submit' | t }}</button>
              {% endif %}
            {% endform %}
          </dialog>
        </div>
      </div>
    </div>

    <section class="aurelle-product__details" aria-label="{{ 'products.aurelle.product_information' | t }}">
      <div class="aurelle-product__page-width">
        <div class="aurelle-product__tabs" role="tablist" aria-label="{{ 'products.aurelle.product_information' | t }}">
          <button type="button" role="tab" id="AurelleTabDetails-{{ section.id }}" aria-controls="AurellePanelDetails-{{ section.id }}" aria-selected="true" data-product-tab="details">{{ 'products.aurelle.details_tab' | t }}</button>
          <button type="button" role="tab" id="AurelleTabDelivery-{{ section.id }}" aria-controls="AurellePanelDelivery-{{ section.id }}" aria-selected="false" tabindex="-1" data-product-tab="delivery">{{ 'products.aurelle.delivery_tab' | t }}</button>
          <button type="button" role="tab" id="AurelleTabCare-{{ section.id }}" aria-controls="AurellePanelCare-{{ section.id }}" aria-selected="false" tabindex="-1" data-product-tab="care">{{ 'products.aurelle.care_tab' | t }}</button>
        </div>

        <div class="aurelle-product__tab-panel" id="AurellePanelDetails-{{ section.id }}" role="tabpanel" aria-labelledby="AurelleTabDetails-{{ section.id }}" data-product-panel="details">
          <div class="aurelle-product__story-copy">
            {% if details_heading != blank %}<h2>{{ details_heading | escape | newline_to_br }}</h2>{% endif %}
            {% if details_intro != blank %}<div class="rte">{{ details_intro | escape | newline_to_br }}</div>{% elsif section.settings.details_intro != blank %}<div class="rte">{{ section.settings.details_intro }}</div>{% endif %}
            {% if details_note != blank %}<p class="aurelle-product__detail-note"><svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="m10 2 7 4v8l-7 4-7-4V6l7-4Zm0 0v16M3 6l7 4 7-4" /></svg>{{ details_note | escape }}</p>{% endif %}
          </div>
          <dl class="aurelle-product__specifications">
            {% assign precious_metal = product.metafields.custom.precious_metal.value | default: product.metafields.custom.metal.value %}
            {% assign centre_stone = product.metafields.custom.centre_stone.value | default: product.metafields.custom.center_stone.value %}
            {% assign stone_weight = product.metafields.custom.diamond_weight.value | default: product.metafields.custom.stone_weight.value %}
            {% assign setting_dimensions = product.metafields.custom.setting_dimensions.value | default: product.metafields.custom.dimensions.value %}
            {% assign provenance = product.metafields.custom.provenance.value %}
            {% assign reference_code = product.metafields.custom.reference.value | default: product.selected_or_first_available_variant.sku %}
            {% if precious_metal != blank %}<div><dt>{{ 'products.aurelle.precious_metal' | t }}</dt><dd>{{ precious_metal | escape }}</dd></div>{% endif %}
            {% if centre_stone != blank %}<div><dt>{{ 'products.aurelle.centre_stone' | t }}</dt><dd>{{ centre_stone | escape }}</dd></div>{% endif %}
            {% if stone_weight != blank %}<div><dt>{{ 'products.aurelle.stone_weight' | t }}</dt><dd>{{ stone_weight | escape }}</dd></div>{% endif %}
            {% if setting_dimensions != blank %}<div><dt>{{ 'products.aurelle.setting_dimensions' | t }}</dt><dd>{{ setting_dimensions | escape }}</dd></div>{% endif %}
            {% if provenance != blank %}<div><dt>{{ 'products.aurelle.provenance' | t }}</dt><dd>{{ provenance | escape }}</dd></div>{% endif %}
            {% if reference_code != blank %}<div><dt>{{ 'products.aurelle.reference' | t }}</dt><dd>{{ reference_code | escape }}</dd></div>{% endif %}
          </dl>
        </div>

        <div class="aurelle-product__tab-panel aurelle-product__tab-panel--text" id="AurellePanelDelivery-{{ section.id }}" role="tabpanel" aria-labelledby="AurelleTabDelivery-{{ section.id }}" data-product-panel="delivery" hidden>
          {% if section.settings.delivery_copy != blank %}<div class="rte">{{ section.settings.delivery_copy }}</div>{% endif %}
        </div>
        <div class="aurelle-product__tab-panel aurelle-product__tab-panel--text" id="AurellePanelCare-{{ section.id }}" role="tabpanel" aria-labelledby="AurelleTabCare-{{ section.id }}" data-product-panel="care" hidden>
          {% if section.settings.care_copy != blank %}<div class="rte">{{ section.settings.care_copy }}</div>{% endif %}
        </div>
      </div>
    </section>

    {% if atelier_heading != blank or atelier_image != blank %}
      <section class="aurelle-product__atelier" aria-label="{{ 'products.aurelle.atelier_eyebrow' | t | escape }}">
        <div class="aurelle-product__atelier-inner aurelle-product__page-width{% if atelier_image == blank %} aurelle-product__atelier-inner--no-image{% endif %}">
            {% if atelier_image != blank %}
              {% assign atelier_alt = atelier_image.alt | default: product.title %}
            <div class="aurelle-product__atelier-visual">
              {{ atelier_image | image_url: width: 1400 | image_tag: class: 'aurelle-product__atelier-image', alt: atelier_alt, widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 1000px) 44vw, 100vw', loading: 'lazy' }}
              {% if atelier_badge != blank %}<div class="aurelle-product__atelier-badge"><span>{{ 'products.aurelle.atelier_note' | t }}</span><p>{{ atelier_badge | escape }}</p></div>{% endif %}
            </div>
          {% elsif request.design_mode %}
            <div class="aurelle-product__atelier-visual aurelle-product__atelier-visual--empty"><span>{{ 'products.aurelle.choose_atelier_image' | t }}</span></div>
          {% endif %}

          <div class="aurelle-product__atelier-copy">
            <p class="aurelle-product__eyebrow">{{ 'products.aurelle.atelier_eyebrow' | t }}</p>
            {% if atelier_heading != blank %}<h2>{{ atelier_heading | escape | newline_to_br }}</h2>{% endif %}
            {% if atelier_description != blank %}<div class="rte">{{ atelier_description | escape | newline_to_br }}</div>{% elsif section.settings.atelier_description != blank %}<div class="rte">{{ section.settings.atelier_description }}</div>{% endif %}
            <div class="aurelle-product__atelier-stats">
              {% if atelier_stat_one != blank %}<div><span>{{ atelier_stat_one | escape }}</span><small>{{ atelier_stat_one_label | escape }}</small></div>{% endif %}
              {% if atelier_stat_two != blank %}<div><span>{{ atelier_stat_two | escape }}</span><small>{{ atelier_stat_two_label | escape }}</small></div>{% endif %}
            </div>
            {% if section.settings.atelier_link != blank %}<a class="aurelle-product__text-link" href="{{ section.settings.atelier_link }}">{{ 'products.aurelle.atelier_link_label' | t }} <span aria-hidden="true">→</span></a>{% endif %}
          </div>
        </div>
      </section>
    {% endif %}

    {% if rating_value != blank and review_count != blank and review_count != 0 %}
      <section class="aurelle-product__reviews" id="AurelleReviews-{{ section.id }}" aria-label="{{ 'products.aurelle.customer_reviews' | t }}">
        <div class="aurelle-product__reviews-inner aurelle-product__page-width">
          <div class="aurelle-product__review-summary">
            <span class="aurelle-product__stars" aria-hidden="true">★★★★★</span>
            <p>{{ rating_value | round: 1 }} {{ 'products.aurelle.out_of_five' | t }}</p>
            <a href="#shopify-product-reviews">{{ 'products.aurelle.read_reviews' | t: count: review_count }}</a>
          </div>
          {% if product.metafields.custom.featured_review.value != blank %}
            <blockquote class="aurelle-product__review-quote">
              <p>“{{ product.metafields.custom.featured_review.value | escape }}”</p>
              {% if product.metafields.custom.featured_review_author.value != blank %}<cite>{{ product.metafields.custom.featured_review_author.value | escape }} · {{ 'products.aurelle.verified_collector' | t }}</cite>{% endif %}
            </blockquote>
          {% endif %}
        </div>
      </section>
    {% endif %}

    {% assign product_service_count = 0 %}
    {% for block in section.blocks %}
      {% if block.type == 'service' %}{% assign product_service_count = product_service_count | plus: 1 %}{% endif %}
    {% endfor %}
    {% if product_service_count > 0 %}
      <section class="aurelle-product__services" aria-label="{{ 'products.aurelle.client_services' | t }}">
        <div class="aurelle-product__services-inner aurelle-product__page-width">
          {% for block in section.blocks %}
            {% if block.type == 'service' %}
            <article class="aurelle-product__service" {{ block.shopify_attributes }}>
              <span class="aurelle-product__service-icon" aria-hidden="true">
                {% case block.settings.icon %}
                  {% when 'truck' %}<svg viewBox="0 0 24 24"><path d="M2 5h12v12H2zM14 9h4l4 4v4h-8zM6.5 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18.5 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></svg>
                  {% when 'return' %}<svg viewBox="0 0 24 24"><path d="M4 7v5h5M5 12a8 8 0 1 0 2-5M12 7v5l3 2"/></svg>
                  {% when 'diamond' %}<svg viewBox="0 0 24 24"><path d="M3 9 7 4h10l4 5-9 11L3 9Zm0 0h18M7 4l5 16 5-16M7 9l5-5 5 5"/></svg>
                  {% when 'infinity' %}<svg viewBox="0 0 24 24"><path d="M7 8c-2.3 0-4 1.7-4 4s1.7 4 4 4c3.1 0 6.1-8 10-8 2.3 0 4 1.7 4 4s-1.7 4-4 4C13.9 16 10.9 8 7 8Z"/></svg>
                {% endcase %}
              </span>
              <div>{% if block.settings.title != blank %}<h3>{{ block.settings.title | escape }}</h3>{% endif %}{% if block.settings.description != blank %}<p>{{ block.settings.description | escape }}</p>{% endif %}</div>
            </article>
            {% endif %}
          {% endfor %}
        </div>
      </section>
    {% endif %}
    {% for block in section.blocks %}
      {% if block.type == '@app' %}<div class="aurelle-product__app-block aurelle-product__page-width">{% render block %}</div>{% endif %}
      {% if block.type == 'custom_liquid' and product_info_block_count == 0 %}<div class="aurelle-product__app-block aurelle-product__page-width" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>{% endif %}
    {% endfor %}

    <script type="application/json" data-product-variants>
      [
        {% for variant in product.variants %}
          {"id":{{ variant.id | json }},"options":{{ variant.options | json }},"price":{{ variant.price | json }},"price_text":{{ variant.price | money_with_currency | json }},"unit_price_text":{{ variant.unit_price | unit_price_with_measurement: variant.unit_price_measurement | json }},"compare_at_price":{{ variant.compare_at_price | json }},"compare_at_price_text":{{ variant.compare_at_price | money_with_currency | json }},"available":{{ variant.available | json }},"featured_media_id":{{ variant.featured_media.id | json }},"sku":{{ variant.sku | json }},"inventory_quantity":{{ variant.inventory_quantity | json }},"inventory_management":{{ variant.inventory_management | json }},"inventory_policy":{{ variant.inventory_policy | json }},"quantity_rule":{"min":{{ variant.quantity_rule.min | default: 1 | json }},"max":{{ variant.quantity_rule.max | json }},"increment":{{ variant.quantity_rule.increment | default: 1 | json }}},"selling_plan_allocations":[{% for allocation in variant.selling_plan_allocations %}{"selling_plan_id":{{ allocation.selling_plan.id | json }},"price":{{ allocation.price | json }},"price_text":{{ allocation.price | money_with_currency | json }},"compare_at_price":{{ allocation.compare_at_price | json }},"compare_at_price_text":{{ allocation.compare_at_price | money_with_currency | json }},"unit_price_text":{{ allocation.unit_price | unit_price_with_measurement: allocation.unit_price_measurement | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]}
          {% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    </script>

    <dialog class="aurelle-product__lightbox" data-gallery-dialog aria-label="{{ 'products.aurelle.gallery' | t: title: product.title | escape }}">
      <button type="button" data-gallery-close aria-label="{{ 'products.aurelle.close_image' | t }}">×</button>
      {% if product.featured_image != blank %}
        <img src="{{ product.featured_image | image_url: width: 1600 }}" alt="{{ product.title | escape }}" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}" loading="lazy" data-gallery-dialog-image>
      {% endif %}
    </dialog>
  </section>
{% endif %}

{% stylesheet %}
  .aurelle-product {
    --aurelle-product-ink: #25231f;
    --aurelle-product-muted: #777169;
    --aurelle-product-gold: #806122;
    --aurelle-product-line: #e1dbd2;
    --aurelle-product-ivory: #fcf9f4;
    color: var(--aurelle-product-ink);
    background: var(--aurelle-product-ivory);
  }

  .aurelle-product__page-width {
    width: min(1184px, calc(100% - 96px));
    margin-inline: auto;
  }

  .aurelle-product__breadcrumbs {
    display: flex;
    align-items: center;
    gap: 13px;
    min-width: 0;
    padding: 27px 0 28px;
    color: #817c74;
    font-family: var(--font-primary--family, Arial, sans-serif);
    font-size: 14px;
    line-height: 1.4;
  }

  .aurelle-product__breadcrumbs a {
    color: inherit;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .aurelle-product__breadcrumbs a:hover,
  .aurelle-product__size-guide:hover,
  .aurelle-product__concierge a:hover {
    color: var(--aurelle-product-gold);
  }

  .aurelle-product__breadcrumbs [aria-current='page'] {
    overflow: hidden;
    color: var(--aurelle-product-ink);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .aurelle-product__overview {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 3fr);
    align-items: start;
    gap: 64px;
    padding-bottom: 70px;
  }

  .aurelle-product__gallery,
  .aurelle-product__purchase {
    min-width: 0;
  }

  .aurelle-product__gallery-stage {
    position: relative;
    overflow: hidden;
    aspect-ratio: 640 / 620;
    background: #eee9e1;
  }

  .aurelle-product__media-item {
    width: 100%;
    height: 100%;
  }

  .aurelle-product__media-item[hidden],
  .aurelle-product__tab-panel[hidden],
  .aurelle-product__fallback-variant[hidden],
  .aurelle-product__engraving-input[hidden] {
    display: none !important;
  }

  .aurelle-product__media-item > img,
  .aurelle-product__media-item > video,
  .aurelle-product__media-item > iframe,
  .aurelle-product__media-item > model-viewer,
  .aurelle-product__media-item > .shopify-model-viewer-ui {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .aurelle-product__media-item--empty {
    display: grid;
    place-items: center;
    padding: 10%;
    background: #f0ece5;
  }

  .aurelle-product__placeholder {
    width: 100%;
    height: 100%;
    fill: rgb(88 78 65 / 14%);
  }

  .aurelle-product__gallery-badge {
    position: absolute;
    top: 20px;
    left: 20px;
    padding: 9px 13px;
    color: var(--aurelle-product-gold);
    background: rgb(252 249 244 / 96%);
    font-family: var(--font-primary--family, Arial, sans-serif);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.11em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .aurelle-product__fullscreen {
    position: absolute;
    right: 18px;
    bottom: 18px;
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 0;
    border-radius: 50%;
    color: var(--aurelle-product-gold);
    background: rgb(252 249 244 / 96%);
    cursor: zoom-in;
    transition: transform 180ms ease, background-color 180ms ease;
  }

  .aurelle-product__fullscreen:hover {
    transform: scale(1.06);
    background: #fff;
  }

  .aurelle-product__fullscreen svg,
  .aurelle-product__booking svg,
  .aurelle-product__gift-note svg,
  .aurelle-product__concierge svg,
  .aurelle-product__detail-note svg,
  .aurelle-product__service-icon svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.35;
  }

  .aurelle-product__thumbnails {
    display: flex;
    gap: 12px;
    margin-top: 12px;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: thin;
    scrollbar-color: #c9b78e transparent;
    scroll-snap-type: x mandatory;
  }

  .aurelle-product__thumbnail {
    position: relative;
    flex: 0 0 calc((100% - 24px) / 3);
    min-width: 0;
    overflow: hidden;
    padding: 0;
    aspect-ratio: 1.38;
    border: 1px solid transparent;
    background: #eee9e1;
    cursor: pointer;
    scroll-snap-align: start;
    transition: border-color 180ms ease, opacity 180ms ease;
  }

  .aurelle-product__thumbnail.is-active,
  .aurelle-product__thumbnail[aria-pressed='true'] {
    border-color: var(--aurelle-product-gold);
  }

  .aurelle-product__thumbnail img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 450ms cubic-bezier(0.2, 0.65, 0.3, 1);
  }

  .aurelle-product__thumbnail:hover img {
    transform: scale(1.035);
  }

  .aurelle-product__thumbnail-type {
    position: absolute;
    right: 6px;
    bottom: 6px;
    padding: 4px 6px;
    color: #fff;
    background: rgb(37 35 31 / 75%);
    font: 12px/1.2 var(--font-primary--family, Arial, sans-serif);
    letter-spacing: 0.06em;
  }

  .aurelle-product__gallery-caption {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 16px;
    color: #888178;
    font-family: var(--font-primary--family, Arial, sans-serif);
    font-size: 13px;
    line-height: 1.5;
  }

  .aurelle-product__gallery-caption p {
    margin: 0;
  }

  .aurelle-product__gallery-caption span {
    flex: 0 0 auto;
    color: var(--aurelle-product-gold);
  }

  .aurelle-product__purchase {
    padding-top: 7px;
  }

  .aurelle-product__eyebrow {
    margin: 0 0 13px;
    color: var(--aurelle-product-gold);
    font-family: var(--font-primary--family, Arial, sans-serif);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.13em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .aurelle-product__title,
  .aurelle-product__tab-panel h2,
  .aurelle-product__atelier-copy h2,
  .aurelle-product__related-heading h2 {
    margin: 0;
    font-family: var(--font-heading--family, 'Playfair Display', Georgia, 'Times New Roman', serif);
    font-weight: 400;
    letter-spacing: -0.035em;
  }

  .aurelle-product__title {
    max-width: 560px;
    font-size: clamp(38px, 3.35vw, 48px);
    line-height: 1.12;
  }

  .aurelle-product__subtitle {
    margin: 11px 0 0;
    color: #5e5952;
    font-family: var(--font-primary--family, Arial, sans-serif);
    font-size: 16px;
    line-height: 1.55;
  }

  .aurelle-product__rating {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 11px;
    margin-top: 11px;
    color: var(--aurelle-product-ink);
    font-family: var(--font-primary--family, Arial, sans-serif);
    font-size: 14px;
    text-decoration-color: #aaa197;
    text-underline-offset: 3px;
  }

  .aurelle-product__stars {
    color: var(--aurelle-product-gold);
    font-size: 16px;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .aurelle-product__price-wrap {
    display: flex;
    align-items: baseline;
    gap: 11px;
    margin-top: 21px;
  }

  .aurelle-product__price {
    margin: 0;
    font-family: var(--font-primary--family, Arial, sans-serif);
    font-size: 25px;
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .aurelle-product__compare-price {
    color: var(--aurelle-product-muted);
    font: 16px var(--font-primary--family, Arial, sans-serif);
  }

  .aurelle-product__tax-note {
    margin: 5px 0 0;
    color: #8a847b;
    font: 14px/1.5 var(--font-primary--family, Arial, sans-serif);
  }

  .aurelle-product__unit-price { margin-top: 5px; color: #8a847b; font-size: 14px; }
  .aurelle-product__dynamic-checkout { grid-column: 1 / -1; }

  .aurelle-product__rule {
    height: 1px;
    margin: 20px 0 24px;
    background: var(--aurelle-product-line);
  }

  .aurelle-product__description {
    color: #59554e;
    font-family: var(--font-primary--family, Arial, sans-serif);
    font-size: 16px;
    line-height: 1.72;
  }

  .aurelle-product__description p {
    margin: 0 0 8px;
  }

  .aurelle-product__description p:last-child {
    margin-bottom: 0;
  }

  .aurelle-product__description img,
  .aurelle-product__description table {
    max-width: 100%;
  }

  .aurelle-product__form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    column-gap: 18px;
    row-gap: 17px;
    margin-top: 22px;
  }

  .aurelle-product__fallback-variant {
    display: block;
    grid-column: 1 / -1;
    width: 100%;
    min-height: 46px;
    padding: 0 12px;
    border: 1px solid var(--aurelle-product-line);
    border-radius: 0;
    color: var(--aurelle-product-ink);
    background: transparent;
    font: 16px var(--font-primary--family, Arial, sans-serif);
  }

  .aurelle-product.is-enhanced .aurelle-product__fallback-variant {
    display: none;
  }

  .aurelle-product__option {
    position: relative;
    display: grid;
    grid-column: 1 / -1;
    gap: 9px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .aurelle-product__option legend {
    width: 100%;
    margin-bottom: 0;
    padding: 0;
    color: #403d38;
    font-family: var(--font-primary--family, Arial, sans-serif);
    font-size: 15px;
    line-height: 1.45;
  }

  .aurelle-product__option legend span {
    color: var(--aurelle-product-muted);
  }

  .aurelle-product:not(.is-enhanced) .aurelle-product__option {
    display: none;
  }

  .aurelle-product__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .aurelle-product__swatch {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid transparent;
    border-radius: 50%;
    cursor: pointer;
    transition: border-color 180ms ease, transform 180ms ease;
  }

  .aurelle-product__swatch:hover {
    transform: translateY(-1px);
  }

  .aurelle-product__swatch.is-unavailable {
    opacity: 0.42;
    text-decoration: line-through;
    cursor: not-allowed;
  }

  .aurelle-product__swatch:has(input:checked) {
    border-color: var(--aurelle-product-gold);
  }

  .aurelle-product__swatch input:checked + .aurelle-product__swatch-dot {
