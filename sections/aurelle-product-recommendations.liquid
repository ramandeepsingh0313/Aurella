{% liquid
  assign recommendations_loaded = recommendations.performed?
  assign recommendation_count = recommendations.products_count | default: 0
  assign heading_id = 'AurelleRecommendationsHeading-' | append: section.id
%}

<section
  class="aurelle-recommendations full-width{% if section.settings.enable_carousel %} is-carousel{% endif %}"
  data-aurelle-recommendations
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-intent="{{ section.settings.intent }}"
  data-limit="{{ section.settings.products_to_show }}"
  data-recommendations-url="{{ routes.product_recommendations_url }}"
  data-design-mode="{{ request.design_mode }}"
  data-state="{% if product == blank %}no-product{% elsif recommendations_loaded %}{% if recommendation_count > 0 %}ready{% else %}empty{% endif %}{% else %}loading{% endif %}"
  style="--ar-background: {{ section.settings.background_color }}; --ar-foreground: {{ section.settings.foreground_color }}; --ar-muted: {{ section.settings.muted_color }}; --ar-accent: {{ section.settings.accent_color }}; --ar-card: {{ section.settings.card_background_color }}; --ar-padding-desktop: {{ section.settings.padding_desktop }}px; --ar-padding-mobile: {{ section.settings.padding_mobile }}px;"
  {% unless recommendations_loaded or product == blank %}aria-busy="true"{% endunless %}
>
  {% if product == blank %}
    {% if request.design_mode %}<div class="aurelle-recommendations__editor-note">Product recommendations are available on product pages with a product context.</div>{% endif %}
  {% elsif recommendations_loaded %}
    {% if recommendation_count > 0 %}
      <div class="aurelle-recommendations__inner">
        <div class="aurelle-recommendations__header">
          <div>
            {% if section.settings.eyebrow != blank %}<p class="aurelle-recommendations__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
            {% if section.settings.heading != blank %}<h2 id="{{ heading_id }}" class="aurelle-recommendations__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
          </div>
          {% if section.settings.enable_carousel %}
            <div class="aurelle-recommendations__controls" aria-label="Recommendation carousel controls">
              <button type="button" data-recommendation-step="-1" aria-label="Previous products" disabled><span aria-hidden="true">←</span></button>
              <button type="button" data-recommendation-step="1" aria-label="Next products" disabled><span aria-hidden="true">→</span></button>
            </div>
          {% endif %}
        </div>
        <div class="aurelle-recommendations__track columns-desktop-{{ section.settings.desktop_columns }} columns-mobile-{{ section.settings.mobile_columns }}" role="list"{% if section.settings.heading != blank %} aria-labelledby="{{ heading_id }}"{% else %} aria-label="Product recommendations"{% endif %} data-recommendations-track>
          {% for recommended_product in recommendations.products limit: section.settings.products_to_show %}{% render 'aurelle-product-card', product: recommended_product %}{% endfor %}
        </div>
      </div>
      <p class="visually-hidden" role="status" aria-live="polite">{{ recommendation_count }} product recommendations loaded.</p>
    {% else %}
      <p class="visually-hidden" role="status" aria-live="polite">No product recommendations are available.</p>
      {% if request.design_mode %}<div class="aurelle-recommendations__editor-note">No {{ section.settings.intent }} recommendations are currently available for this product.</div>{% endif %}
    {% endif %}
  {% else %}
    <div class="aurelle-recommendations__inner aurelle-recommendations__loading" aria-hidden="true">
      <div class="aurelle-recommendations__skeleton-heading"></div>
      <div class="aurelle-recommendations__skeleton-grid">{% for index in (1..section.settings.desktop_columns) %}<span></span>{% endfor %}</div>
    </div>
    <p class="visually-hidden" role="status" aria-live="polite" data-recommendations-status>Loading product recommendations.</p>
  {% endif %}
</section>

{% stylesheet %}
  .aurelle-recommendations { color: var(--ar-foreground); background: var(--ar-background); }
  .aurelle-recommendations[data-state='empty'], .aurelle-recommendations[data-state='no-product'] { padding: 0; }
  .aurelle-recommendations__inner { width: min(100% - 96px, 1480px); margin-inline: auto; padding-block: var(--ar-padding-desktop); }
  .aurelle-recommendations__header { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; padding-bottom: 24px; border-bottom: 1px solid color-mix(in srgb, var(--ar-foreground), transparent 88%); }
  .aurelle-recommendations__eyebrow { margin: 0 0 10px; color: var(--ar-accent); font-size: 11px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; }
  .aurelle-recommendations__heading { margin: 0; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(34px, 4vw, 54px); font-weight: 400; line-height: 1.08; }
  .aurelle-recommendations__controls { display: flex; gap: 8px; }
  .aurelle-recommendations__controls button { display: grid; place-items: center; width: 48px; height: 48px; border: 1px solid color-mix(in srgb, var(--ar-foreground), transparent 78%); border-radius: 2px; color: inherit; background: transparent; cursor: pointer; transition: border-color 180ms ease, background 180ms ease; }
  .aurelle-recommendations__controls button:hover:not(:disabled), .aurelle-recommendations__controls button:focus-visible { border-color: var(--ar-accent); background: color-mix(in srgb, var(--ar-accent), transparent 92%); }
  .aurelle-recommendations__controls button:disabled { cursor: default; opacity: .35; }
  .aurelle-recommendations__track { display: grid; gap: 22px; margin-top: 36px; }
  .aurelle-recommendations:not(.is-carousel) .columns-desktop-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .aurelle-recommendations:not(.is-carousel) .columns-desktop-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .aurelle-recommendations:not(.is-carousel) .columns-desktop-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .aurelle-recommendations.is-carousel .aurelle-recommendations__track { grid-auto-flow: column; grid-template-columns: none; overflow-x: auto; padding: 2px 2px 8px; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .aurelle-recommendations.is-carousel .aurelle-recommendations__track::-webkit-scrollbar { display: none; }
  .aurelle-recommendations.is-carousel .columns-desktop-2 { grid-auto-columns: calc((100% - 22px) / 2); }
  .aurelle-recommendations.is-carousel .columns-desktop-3 { grid-auto-columns: calc((100% - 44px) / 3); }
  .aurelle-recommendations.is-carousel .columns-desktop-4 { grid-auto-columns: calc((100% - 66px) / 4); }
  .aurelle-recommendations .aurelle-product-card { min-width: 0; overflow: hidden; border: 1px solid color-mix(in srgb, var(--ar-foreground), transparent 88%); background: var(--ar-card); scroll-snap-align: start; }
  .aurelle-recommendations .aurelle-product-card__media { position: relative; display: block; overflow: hidden; aspect-ratio: 4 / 5; background: color-mix(in srgb, var(--ar-card), var(--ar-background) 28%); }
  .aurelle-recommendations .aurelle-product-card__image, .aurelle-recommendations .aurelle-product-card__placeholder { display: block; width: 100%; height: 100%; object-fit: cover; transition: opacity 380ms ease, transform 650ms cubic-bezier(.2,.65,.3,1); }
  .aurelle-recommendations .aurelle-product-card__image--hover { position: absolute; inset: 0; opacity: 0; }
  .aurelle-recommendations .aurelle-product-card__media:hover .aurelle-product-card__image:not(.aurelle-product-card__image--hover), .aurelle-recommendations .aurelle-product-card__media:focus-visible .aurelle-product-card__image:not(.aurelle-product-card__image--hover) { transform: scale(1.035); }
  .aurelle-recommendations .aurelle-product-card__media:hover .aurelle-product-card__image--hover, .aurelle-recommendations .aurelle-product-card__media:focus-visible .aurelle-product-card__image--hover { opacity: 1; transform: scale(1.035); }
  .aurelle-recommendations .aurelle-product-card__badge, .aurelle-recommendations .aurelle-product-card__sold-out { position: absolute; z-index: 1; top: 16px; padding: 6px 10px; color: #fff; background: rgb(35 32 28 / 82%); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; }
  .aurelle-recommendations .aurelle-product-card__badge { left: 16px; }
  .aurelle-recommendations .aurelle-product-card__sold-out { right: 16px; }
  .aurelle-recommendations .aurelle-product-card__details { padding: 20px 18px; }
  .aurelle-recommendations .aurelle-product-card__meta-row, .aurelle-recommendations .aurelle-product-card__price-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .aurelle-recommendations .aurelle-product-card__subtitle, .aurelle-recommendations .aurelle-product-card__description { margin: 0; color: var(--ar-muted); font-size: 12px; line-height: 1.5; }
  .aurelle-recommendations .aurelle-product-card__subtitle { overflow: hidden; letter-spacing: .1em; text-overflow: ellipsis; text-transform: uppercase; white-space: nowrap; }
  .aurelle-recommendations .aurelle-product-card__swatches { display: flex; flex: 0 0 auto; gap: 5px; }
  .aurelle-recommendations .aurelle-product-card__swatch { width: 15px; height: 15px; border: 1px solid rgb(28 28 25 / 18%); border-radius: 50%; background: var(--aurelle-product-swatch); box-shadow: inset 0 0 0 2px #fff; }
  .aurelle-recommendations .aurelle-product-card__title { margin: 11px 0 5px; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(21px, 2vw, 26px); font-weight: 400; line-height: 1.25; }
  .aurelle-recommendations .aurelle-product-card__title a { color: inherit; text-decoration: none; }
  .aurelle-recommendations .aurelle-product-card__title a:hover { color: var(--ar-accent); }
  .aurelle-recommendations .aurelle-product-card__price-row { justify-content: flex-start; margin-top: 13px; padding-top: 12px; border-top: 1px solid color-mix(in srgb, var(--ar-foreground), transparent 88%); }
  .aurelle-recommendations .aurelle-product-card__price, .aurelle-recommendations .aurelle-product-card__compare-price { margin: 0; font-size: 15px; }
  .aurelle-recommendations .aurelle-product-card__compare-price { color: var(--ar-muted); }
  .aurelle-recommendations__loading { min-height: 520px; }
  .aurelle-recommendations__skeleton-heading { width: min(420px, 70%); height: 52px; background: color-mix(in srgb, var(--ar-foreground), transparent 94%); animation: aurelle-recommendations-pulse 1.4s ease-in-out infinite; }
  .aurelle-recommendations__skeleton-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px; margin-top: 36px; }
  .aurelle-recommendations__skeleton-grid span { display: block; aspect-ratio: 4 / 5; background: color-mix(in srgb, var(--ar-foreground), transparent 94%); animation: aurelle-recommendations-pulse 1.4s ease-in-out infinite; }
  .aurelle-recommendations__editor-note { width: min(100% - 40px, 900px); margin: 24px auto; padding: 18px; border: 1px dashed var(--ar-accent, #8a6d2f); color: var(--ar-muted, #716b64); text-align: center; }
  @keyframes aurelle-recommendations-pulse { 50% { opacity: .45; } }
  @media (max-width: 989px) {
    .aurelle-recommendations__inner { width: min(100% - 48px, 900px); }
    .aurelle-recommendations:not(.is-carousel) .aurelle-recommendations__track { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .aurelle-recommendations.is-carousel .aurelle-recommendations__track { grid-auto-columns: calc((100% - 18px) / 2); gap: 18px; }
    .aurelle-recommendations__skeleton-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .aurelle-recommendations__inner { width: min(100% - 24px, 560px); padding-block: var(--ar-padding-mobile); }
    .aurelle-recommendations__header { align-items: flex-end; gap: 14px; padding-bottom: 18px; }
    .aurelle-recommendations__controls button { width: 42px; height: 42px; }
    .aurelle-recommendations__track { gap: 13px; margin-top: 26px; }
    .aurelle-recommendations:not(.is-carousel) .columns-mobile-1 { grid-template-columns: minmax(0, 1fr); }
    .aurelle-recommendations:not(.is-carousel) .columns-mobile-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .aurelle-recommendations.is-carousel .columns-mobile-1 { grid-auto-columns: min(82vw, 350px); }
    .aurelle-recommendations.is-carousel .columns-mobile-2 { grid-auto-columns: calc((100% - 13px) / 2); }
    .aurelle-recommendations .aurelle-product-card__details { padding: 15px 13px; }
    .aurelle-recommendations .aurelle-product-card__title { font-size: 20px; }
    .aurelle-recommendations__loading { min-height: 380px; }
    .aurelle-recommendations__skeleton-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 13px; }
  }
  @media (prefers-reduced-motion: reduce) { .aurelle-recommendations *, .aurelle-recommendations *::before, .aurelle-recommendations *::after { scroll-behavior: auto !important; animation: none !important; transition: none !important; } }
{% endstylesheet %}

{% javascript %}
  (() => {
    const selector = '[data-aurelle-recommendations]';
    const setupCarousel = (section) => {
      const track = section.querySelector('[data-recommendations-track]');
      if (!track || !section.classList.contains('is-carousel') || track.dataset.carouselReady === 'true') return;
      const previous = section.querySelector('[data-recommendation-step="-1"]');
      const next = section.querySelector('[data-recommendation-step="1"]');
      if (!previous || !next) return;
      const update = () => { const maximum = Math.max(0, track.scrollWidth - track.clientWidth); previous.disabled = track.scrollLeft <= 1; next.disabled = maximum <= 1 || track.scrollLeft >= maximum - 1; };
      section.addEventListener('click', (event) => {
        const button = event.target.closest('[data-recommendation-step]');
        if (!button || button.disabled || !section.contains(button)) return;
        const card = track.querySelector('.aurelle-product-card');
        const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        const distance = card ? card.getBoundingClientRect().width + gap : track.clientWidth;
        track.scrollBy({ left: Number(button.dataset.recommendationStep) * distance, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      });
      let frame;
      track.addEventListener('scroll', () => { cancelAnimationFrame(frame); frame = requestAnimationFrame(update); }, { passive: true });
      if ('ResizeObserver' in window) new ResizeObserver(update).observe(track);
      track.dataset.carouselReady = 'true';
      update();
    };
    const load = async (section) => {
      if (section.dataset.recommendationsReady === 'true' || !section.dataset.productId || section.dataset.state === 'no-product') return;
      section.dataset.recommendationsReady = 'true';
      if (section.dataset.state === 'ready' || section.dataset.state === 'empty') { setupCarousel(section); return; }
      try {
        const endpoint = new URL(section.dataset.recommendationsUrl, window.location.origin);
        endpoint.searchParams.set('product_id', section.dataset.productId);
        endpoint.searchParams.set('section_id', section.dataset.sectionId);
        endpoint.searchParams.set('limit', section.dataset.limit);
        endpoint.searchParams.set('intent', section.dataset.intent);
        const response = await fetch(endpoint.toString(), { headers: { Accept: 'text/html' } });
        if (!response.ok) throw new Error(`Recommendation request failed: ${response.status}`);
        const fragment = new DOMParser().parseFromString(await response.text(), 'text/html');
        const incoming = fragment.querySelector(`${selector}[data-section-id="${CSS.escape(section.dataset.sectionId)}"]`);
        if (!incoming) throw new Error('Recommendation section missing from response');
        section.innerHTML = incoming.innerHTML;
        section.dataset.state = incoming.dataset.state || 'empty';
        section.removeAttribute('aria-busy');
        if (section.dataset.state === 'empty' && section.dataset.designMode !== 'true') section.hidden = true;
        setupCarousel(section);
        window.AurelleMotion?.init(section);
      } catch {
        section.dataset.state = 'error';
        section.removeAttribute('aria-busy');
        const status = section.querySelector('[data-recommendations-status]');
        if (status) status.textContent = 'Product recommendations are temporarily unavailable.';
        section.querySelector('.aurelle-recommendations__loading')?.remove();
      }
    };
    const observe = (section) => {
      if (section.dataset.state === 'ready' || section.dataset.state === 'empty' || !('IntersectionObserver' in window) || section.dataset.designMode === 'true') { load(section); return; }
      const observer = new IntersectionObserver((entries) => { if (!entries.some((entry) => entry.isIntersecting)) return; observer.disconnect(); load(section); }, { rootMargin: '300px 0px' });
      observer.observe(section);
    };
    const initialize = (root = document) => { if (root.matches?.(selector)) observe(root); root.querySelectorAll?.(selector).forEach(observe); };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => initialize(), { once: true }); else initialize();
    document.addEventListener('shopify:section:load', (event) => initialize(event.target));
  })();
{% endjavascript %}

{% schema %}
{
  "name": "AURELLE recommendations",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Selected for you" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The art of wearing together" },
    { "type": "select", "id": "intent", "label": "Recommendation type", "options": [ { "value": "related", "label": "Related products" }, { "value": "complementary", "label": "Complementary products" } ], "default": "related", "info": "Complementary products are configured using Shopify Search & Discovery." },
    { "type": "range", "id": "products_to_show", "label": "Maximum products", "min": 2, "max": 10, "step": 1, "default": 4 },
    { "type": "range", "id": "desktop_columns", "label": "Desktop columns", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "select", "id": "mobile_columns", "label": "Mobile columns", "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ], "default": "1" },
    { "type": "checkbox", "id": "enable_carousel", "label": "Enable carousel", "default": true },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f7f3ed" },
    { "type": "color", "id": "card_background_color", "label": "Card background", "default": "#fffdf9" },
    { "type": "color", "id": "foreground_color", "label": "Text", "default": "#25221f" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#777069" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#876b2d" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_desktop", "label": "Desktop vertical spacing", "min": 24, "max": 140, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_mobile", "label": "Mobile vertical spacing", "min": 20, "max": 100, "step": 4, "unit": "px", "default": 44 }
  ],
  "presets": [ { "name": "AURELLE recommendations" } ]
}
{% endschema %}
