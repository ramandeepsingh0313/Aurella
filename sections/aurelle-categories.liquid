<section
  class="aurelle-categories full-width"
  style="--aurelle-categories-background: {{ section.settings.background_color }}; --aurelle-categories-foreground: {{ section.settings.foreground_color }}; --aurelle-categories-muted: {{ section.settings.muted_color }}; --aurelle-categories-accent: {{ section.settings.accent_color }}; --aurelle-categories-card-background: {{ section.settings.card_background_color }};"
  aria-labelledby="AurelleCategoriesHeading-{{ section.id }}"
>
  <div class="aurelle-categories__inner">
    <div class="aurelle-categories__header">
      <div class="aurelle-categories__heading-group">
        {% if section.settings.eyebrow != blank %}
          <p class="aurelle-categories__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="aurelle-categories__heading" id="AurelleCategoriesHeading-{{ section.id }}">
            {{ section.settings.heading | escape }}
          </h2>
        {% endif %}
      </div>

      {% if section.settings.view_all_label != blank %}
        <a class="aurelle-categories__view-all" href="{{ section.settings.view_all_link | default: routes.collections_url | escape }}">
          <span>{{ section.settings.view_all_label | escape }}</span>
          <img src="{{ 'aurelle-arrow-right.svg' | asset_url }}" width="13" height="9" alt="" aria-hidden="true">
        </a>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="aurelle-categories__grid" role="list" aria-label="Jewellery categories">
        {% for block in section.blocks %}
          {% liquid
            assign category_title = block.settings.heading
            if category_title == blank and block.settings.collection != blank
              assign category_title = block.settings.collection.title
            endif

            assign category_alt = block.settings.image_alt
            if category_alt == blank
              assign category_alt = category_title
            endif

            assign category_link = block.settings.link
            if category_link == blank and block.settings.collection != blank
              assign category_link = block.settings.collection.url
            endif
            if category_link == blank
              assign encoded_category_title = category_title | url_encode
              assign category_link = routes.search_url | append: '?q=' | append: encoded_category_title | append: '&type=product'
            endif

            assign category_badge = block.settings.badge_text
            if block.settings.collection != blank
              assign category_badge = block.settings.collection.products_count | append: ' Pieces'
            endif

            assign fallback_asset = 'aurelle-category-rings.jpg'
            case block.settings.fallback_image
              when 'earrings'
                assign fallback_asset = 'aurelle-category-earrings.jpg'
              when 'necklaces'
                assign fallback_asset = 'aurelle-category-necklaces.jpg'
              when 'bangles'
                assign fallback_asset = 'aurelle-category-bangles.jpg'
              when 'bridal'
                assign fallback_asset = 'aurelle-category-bridal.jpg'
            endcase
          %}

          <a class="aurelle-categories__card{% if block.settings.hover_image != blank %} aurelle-categories__card--has-hover-image{% endif %}" href="{{ category_link | escape }}" role="listitem" {{ block.shopify_attributes }}>
            <div class="aurelle-categories__media">
              <div class="aurelle-categories__image-wrap">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 896 | image_tag: class: 'aurelle-categories__image', alt: category_alt, widths: '224, 448, 672, 896', sizes: '(min-width: 1100px) 224px, (min-width: 701px) 30vw, 76vw', loading: 'lazy' }}
                {% else %}
                  <img
                    class="aurelle-categories__image"
                    src="{{ fallback_asset | asset_url }}"
                    width="224"
                    height="280"
                    alt="{{ category_alt | escape }}"
                    loading="lazy"
                  >
                {% endif %}
                {% if block.settings.hover_image != blank %}
                  {{ block.settings.hover_image | image_url: width: 896 | image_tag: class: 'aurelle-categories__image aurelle-categories__image--hover', alt: '', widths: '224, 448, 672, 896', sizes: '(min-width: 1100px) 224px, (min-width: 701px) 30vw, 76vw', loading: 'lazy', attrs: 'aria-hidden="true"' }}
                {% endif %}
              </div>
              {% if category_badge != blank %}
                <span class="aurelle-categories__badge">{{ category_badge | escape }}</span>
              {% endif %}
              <span class="aurelle-categories__hover-cue" aria-hidden="true">
                <img src="{{ 'aurelle-arrow-right.svg' | asset_url }}" width="13" height="9" alt="">
              </span>
            </div>

            <div class="aurelle-categories__card-copy">
              {% if category_title != blank %}
                <h3 class="aurelle-categories__card-title">{{ category_title | escape }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class="aurelle-categories__card-description">{{ block.settings.description | escape }}</p>
              {% endif %}
            </div>
          </a>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .aurelle-categories {
    width: 100%;
    padding-block: 96px;
    color: var(--aurelle-categories-foreground);
    background: var(--aurelle-categories-background);
  }

  .aurelle-categories__inner {
    width: min(1440px, calc(100% - 96px));
    margin-inline: auto;
  }

  .aurelle-categories__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .aurelle-categories__heading-group {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  .aurelle-categories__eyebrow {
    margin: 0;
    color: var(--aurelle-categories-accent);
    font-family: var(--font-primary--family);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 14px;
    text-transform: uppercase;
  }

  .aurelle-categories__heading {
    margin: 0;
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
    font-size: 40px;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 48px;
  }

  .aurelle-categories__view-all {
    display: inline-flex;
    min-height: 24px;
    flex: 0 0 auto;
    align-items: center;
    gap: 8px;
    color: var(--aurelle-categories-foreground);
    font-family: var(--font-primary--family);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 16px;
    text-decoration: none;
    text-transform: uppercase;
  }

  .aurelle-categories__view-all:hover,
  .aurelle-categories__card:hover .aurelle-categories__card-title,
  .aurelle-categories__card:focus-visible .aurelle-categories__card-title {
    color: var(--aurelle-categories-accent);
  }

  .aurelle-categories__view-all img {
    display: block;
    flex: 0 0 auto;
  }

  .aurelle-categories__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
    margin-top: 64px;
  }

  .aurelle-categories__card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .aurelle-categories__card:focus-visible,
  .aurelle-categories__view-all:focus-visible {
    outline: 2px solid var(--aurelle-categories-accent);
    outline-offset: 4px;
  }

  .aurelle-categories__media {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 2px;
    background: var(--aurelle-categories-card-background);
  }

  .aurelle-categories__image-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }

  .aurelle-categories__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: opacity 420ms ease, transform 650ms cubic-bezier(0.2, 0.65, 0.3, 1);
  }

  .aurelle-categories__image--hover {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .aurelle-categories__card--has-hover-image:hover .aurelle-categories__image:not(.aurelle-categories__image--hover),
  .aurelle-categories__card--has-hover-image:focus-visible .aurelle-categories__image:not(.aurelle-categories__image--hover) {
    opacity: 0;
  }

  .aurelle-categories__card--has-hover-image:hover .aurelle-categories__image--hover,
  .aurelle-categories__card--has-hover-image:focus-visible .aurelle-categories__image--hover {
    opacity: 1;
  }

  .aurelle-categories__card:hover .aurelle-categories__image,
  .aurelle-categories__card:focus-visible .aurelle-categories__image {
    transform: scale(1.025);
  }

  .aurelle-categories__hover-cue {
    position: absolute;
    right: 14px;
    bottom: 14px;
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 50%;
    background: rgb(252 249 244 / 94%);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .aurelle-categories__hover-cue img {
    display: block;
  }

  .aurelle-categories__card:hover .aurelle-categories__hover-cue,
  .aurelle-categories__card:focus-visible .aurelle-categories__hover-cue {
    opacity: 1;
    transform: translateY(0);
  }

  .aurelle-categories__badge {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 4px 10px;
    border-radius: 2px;
    color: var(--aurelle-categories-foreground);
    background: rgb(255 255 255 / 80%);
    backdrop-filter: blur(2px);
    font-family: var(--font-primary--family);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.05em;
    line-height: 14px;
  }

  .aurelle-categories__card-copy {
    padding-top: 8px;
  }

  .aurelle-categories__card-title {
    margin: 0;
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
    font-size: 22px;
    font-weight: 500;
    line-height: 30px;
    transition: color 160ms ease;
  }

  .aurelle-categories__card-description {
    margin: 0;
    color: var(--aurelle-categories-muted);
    font-family: var(--font-primary--family);
    font-size: 12px;
    font-weight: 400;
    line-height: 18px;
  }

  @media screen and (max-width: 1100px) {
    .aurelle-categories__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 32px;
    }
  }

  @media screen and (max-width: 700px) {
    .aurelle-categories {
      padding-block: 56px;
    }

    .aurelle-categories__inner {
      width: calc(100% - 40px);
    }

    .aurelle-categories__header {
      align-items: flex-end;
      gap: 12px;
    }

    .aurelle-categories__heading {
      font-size: clamp(27px, 7vw, 34px);
      line-height: 1.15;
    }

    .aurelle-categories__view-all {
      gap: 6px;
      font-size: 9px;
      letter-spacing: 0.06em;
    }

    .aurelle-categories__grid {
      grid-auto-columns: min(76vw, 280px);
      grid-auto-flow: column;
      grid-template-columns: none;
      gap: 14px;
      margin-top: 32px;
      overflow-x: auto;
      padding-bottom: 8px;
      scroll-padding-inline: 1px;
      scroll-snap-type: x mandatory;
      scrollbar-width: thin;
      -webkit-overflow-scrolling: touch;
    }

    .aurelle-categories__card {
      scroll-snap-align: start;
    }

    .aurelle-categories__card-title {
      font-size: 21px;
      line-height: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aurelle-categories__image,
    .aurelle-categories__hover-cue,
    .aurelle-categories__card-title {
      transition: none;
    }

    .aurelle-categories__card:hover .aurelle-categories__image,
    .aurelle-categories__card:focus-visible .aurelle-categories__image,
    .aurelle-categories__hover-cue {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AURELLE categories",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Curated Archives"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Creations by Category"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all link label",
      "default": "View All Suites"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link destination",
      "info": "Leave blank to link to the store's collections index."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#FCF9F4"
    },
    {
      "type": "color",
      "id": "foreground_color",
      "label": "Primary text",
      "default": "#1C1C19"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Secondary text",
      "default": "#4B4640"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#735B26"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Image fallback background",
      "default": "#F6F3EE"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Optional. Links the card to this collection and uses its live product count."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image",
          "info": "Optional. If blank, the selected Figma artwork is used."
        },
        {
          "type": "image_picker",
          "id": "hover_image",
          "label": "Hover image",
          "info": "Optional. Fades smoothly to this image when a customer hovers over or focuses the card."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alternative text"
        },
        {
          "type": "select",
          "id": "fallback_image",
          "label": "Fallback artwork",
          "options": [
            { "value": "rings", "label": "Rings" },
            { "value": "earrings", "label": "Earrings" },
            { "value": "necklaces", "label": "Necklaces" },
            { "value": "bangles", "label": "Bangles" },
            { "value": "bridal", "label": "Bridal" }
          ],
          "default": "rings"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Category name",
          "default": "Rings"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Short description",
          "default": "Solitaires & Sculptural Stacks"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text",
          "default": "34 Pieces",
          "info": "Figma sample count. Selecting a collection replaces this with its live product count; verify or clear this sample before publishing."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom card link",
          "info": "Optional. This overrides the selected collection link."
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "AURELLE categories",
      "blocks": [
        { "type": "category", "settings": { "fallback_image": "rings", "heading": "Rings", "description": "Solitaires & Sculptural Stacks", "badge_text": "34 Pieces" } },
        { "type": "category", "settings": { "fallback_image": "earrings", "heading": "Earrings", "description": "Architectural Drops & Hoops", "badge_text": "28 Pieces" } },
        { "type": "category", "settings": { "fallback_image": "necklaces", "heading": "Necklaces", "description": "Tennis & Medallion Suites", "badge_text": "19 Pieces" } },
        { "type": "category", "settings": { "fallback_image": "bangles", "heading": "Bangles", "description": "Solid 18K Cuffs & Chains", "badge_text": "22 Pieces" } },
        { "type": "category", "settings": { "fallback_image": "bridal", "heading": "Bridal", "description": "Ceremonial Solitaires", "badge_text": "16 Pieces" } }
      ]
    }
  ]
}
{% endschema %}
