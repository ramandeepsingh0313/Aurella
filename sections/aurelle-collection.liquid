{% liquid
  assign active_sort = collection.sort_by | default: collection.default_sort_by
  assign hero_image = section.settings.hero_image | default: collection.image
  assign hero_image_alt = section.settings.hero_image_alt | default: hero_image.alt | default: section.settings.hero_heading | default: collection.title
  assign editorial_image_alt = section.settings.editorial_image_alt | default: section.settings.editorial_image.alt | default: section.settings.editorial_heading
  assign category_filter = blank
  assign active_filter_count = 0
  for filter in collection.filters
    assign filter_name = filter.label | downcase
    if category_filter == blank and filter.type == 'list'
      if filter_name contains 'category' or filter_name contains 'product type'
        assign category_filter = filter
      endif
    endif
    assign active_filter_count = active_filter_count | plus: filter.active_values.size
    if filter.type == 'price_range' and filter.min_value.value != nil
      assign active_filter_count = active_filter_count | plus: 1
    endif
    if filter.type == 'price_range' and filter.max_value.value != nil
      assign active_filter_count = active_filter_count | plus: 1
    endif
  endfor
%}

<section class="ac full-width" data-aurelle-collection aria-labelledby="ac-title-{{ section.id }}">
  <div class="ac__inner">
    <nav class="ac__breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span><span>Collections</span><span aria-hidden="true">/</span><span aria-current="page">{{ collection.title | escape }}</span>
    </nav>

    <header class="ac__hero">
      <div class="ac__hero-copy">
        {% if section.settings.eyebrow != blank %}<p class="ac__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h1 id="ac-title-{{ section.id }}">{{ section.settings.hero_heading | default: collection.title | escape }}</h1>
        {% if collection.description != blank %}<div class="ac__hero-description">{{ collection.description }}</div>{% elsif section.settings.hero_description != blank %}<p class="ac__hero-description">{{ section.settings.hero_description | escape }}</p>{% endif %}
        {% if section.settings.hero_note != blank %}<p class="ac__hero-note">{{ section.settings.hero_note | escape }}</p>{% endif %}
      </div>
      <div class="ac__hero-visual">
        {% if hero_image != blank %}
          {{ hero_image | image_url: width: 1700 | image_tag: class: 'ac__hero-image', alt: hero_image_alt, widths: '600, 900, 1200, 1700', sizes: '(min-width: 700px) 62vw, 100vw', loading: 'eager' }}
        {% else %}
          <img class="ac__hero-image" src="{{ 'aurelle-hero-main.jpeg' | asset_url }}" width="512" height="286" alt="AURELLE jewellery editorial portrait" fetchpriority="high">
        {% endif %}
      </div>
    </header>

    <nav class="ac__categories" aria-label="Collection categories">
      <a href="{{ collection.url }}"{% if category_filter == blank or category_filter.active_values.size == 0 %} aria-current="page"{% endif %}>All creations ({{ collection.all_products_count }})</a>
      {% if category_filter != blank %}
        {% for value in category_filter.values %}
          <a href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}"{% if value.active %} aria-current="page"{% endif %}>{{ value.label | escape }}</a>
        {% endfor %}
      {% else %}
        {% for block in section.blocks %}
          {% if block.settings.collection != blank and block.settings.collection.handle != collection.handle %}<a href="{{ block.settings.collection.url }}" {{ block.shopify_attributes }}>{{ block.settings.label | default: block.settings.collection.title | escape }}</a>{% endif %}
        {% endfor %}
      {% endif %}
    </nav>

    {% paginate collection.products by section.settings.products_per_page %}
      <div class="ac__toolbar">
        <div class="ac__filter-controls">
          <button class="ac__filter-trigger" type="button" data-open-dialog="ac-filters-{{ section.id }}" aria-label="Filter and refine products">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M2 5h16M2 10h16M2 15h16M7 3v4m6 1v4m-4 1v4" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
            Filter &amp; refine{% if active_filter_count > 0 %} ({{ active_filter_count }}){% endif %}
          </button>
          {% for filter in collection.filters limit: 4 %}<button class="ac__filter-shortcut" type="button" data-open-dialog="ac-filters-{{ section.id }}">{{ filter.label | escape }} <span aria-hidden="true">⌄</span></button>{% endfor %}
        </div>
        <span class="ac__result-count" aria-live="polite">{{ collection.products_count }} {% if collection.products_count == 1 %}creation{% else %}creations{% endif %}</span>
        <button class="ac__sort-trigger" type="button" data-open-dialog="ac-sort-{{ section.id }}">Sort by: {% for option in collection.sort_options %}{% if option.value == active_sort %}{{ option.name | escape }}{% endif %}{% endfor %} <span aria-hidden="true">⌄</span></button>
      </div>

      {% if active_filter_count > 0 %}
        <div class="ac__active-filters" aria-label="Active filters">
          {% for filter in collection.filters %}
            {% for value in filter.active_values %}<a href="{{ value.url_to_remove }}">{{ value.label | escape }} <span aria-hidden="true">×</span></a>{% endfor %}
            {% if filter.type == 'price_range' and filter.min_value.value != nil %}<a href="{{ filter.url_to_remove }}">From {{ filter.min_value.value | money }} <span aria-hidden="true">×</span></a>{% endif %}
            {% if filter.type == 'price_range' and filter.max_value.value != nil %}<a href="{{ filter.url_to_remove }}">Under {{ filter.max_value.value | money }} <span aria-hidden="true">×</span></a>{% endif %}
          {% endfor %}
          <a class="ac__active-clear" href="{{ collection.url }}?sort_by={{ active_sort | url_encode }}">Clear all</a>
        </div>
      {% endif %}

      {% if collection.products_count > 0 %}
        <div class="ac__grid">
          {% for product in collection.products %}
            {% render 'aurelle-collection-card', product: product, section_id: section.id, collection_title: collection.title, dispatch_note: section.settings.dispatch_note, size_guide_page: section.settings.size_guide_page %}
            {% if forloop.index == 4 and paginate.current_page == 1 and section.settings.show_editorial %}
              <aside class="ac__editorial" aria-label="Collection story">
                <div class="ac__editorial-visual">
                  {% if section.settings.editorial_image != blank %}{{ section.settings.editorial_image | image_url: width: 1400 | image_tag: class: 'ac__editorial-image', alt: editorial_image_alt, widths: '500, 800, 1100, 1400', sizes: '(min-width: 700px) 43vw, 100vw', loading: 'lazy' }}{% else %}<div class="ac__media-placeholder" role="img" aria-label="{{ editorial_image_alt | escape }}"><span aria-hidden="true">◇</span></div>{% endif %}
                </div>
                <div class="ac__editorial-copy">
                  {% if section.settings.editorial_eyebrow != blank %}<p class="ac__eyebrow">{{ section.settings.editorial_eyebrow | escape }}</p>{% endif %}
                  {% if section.settings.editorial_heading != blank %}<h2>{{ section.settings.editorial_heading | escape }}</h2>{% endif %}
                  {% if section.settings.editorial_text != blank %}<p>{{ section.settings.editorial_text | escape }}</p>{% endif %}
                  {% if section.settings.editorial_link != blank and section.settings.editorial_link_label != blank %}<a href="{{ section.settings.editorial_link }}">{{ section.settings.editorial_link_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}
                </div>
              </aside>
            {% endif %}
          {% endfor %}
        </div>
        {% if collection.products.size < 4 and paginate.current_page == 1 and section.settings.show_editorial %}
          <aside class="ac__editorial ac__editorial--after" aria-label="Collection story">
            <div class="ac__editorial-visual">{% if section.settings.editorial_image != blank %}{{ section.settings.editorial_image | image_url: width: 1400 | image_tag: class: 'ac__editorial-image', alt: editorial_image_alt, widths: '500, 800, 1100, 1400', sizes: '(min-width: 700px) 43vw, 100vw', loading: 'lazy' }}{% else %}<div class="ac__media-placeholder" role="img" aria-label="{{ editorial_image_alt | escape }}"><span aria-hidden="true">◇</span></div>{% endif %}</div>
            <div class="ac__editorial-copy">{% if section.settings.editorial_eyebrow != blank %}<p class="ac__eyebrow">{{ section.settings.editorial_eyebrow | escape }}</p>{% endif %}{% if section.settings.editorial_heading != blank %}<h2>{{ section.settings.editorial_heading | escape }}</h2>{% endif %}{% if section.settings.editorial_text != blank %}<p>{{ section.settings.editorial_text | escape }}</p>{% endif %}{% if section.settings.editorial_link != blank and section.settings.editorial_link_label != blank %}<a href="{{ section.settings.editorial_link }}">{{ section.settings.editorial_link_label | escape }} →</a>{% endif %}</div>
          </aside>
        {% endif %}
      {% else %}
        <div class="ac__empty">
          <div class="ac__empty-head"><span>{{ collection.title | escape }}</span><span>0 creations</span></div>
          {% if active_filter_count > 0 %}<div class="ac__empty-chips">{% for filter in collection.filters %}{% for value in filter.active_values %}<a href="{{ value.url_to_remove }}">{{ value.label | escape }} ×</a>{% endfor %}{% if filter.type == 'price_range' and filter.min_value.value != nil %}<a href="{{ filter.url_to_remove }}">From {{ filter.min_value.value | money }} ×</a>{% endif %}{% if filter.type == 'price_range' and filter.max_value.value != nil %}<a href="{{ filter.url_to_remove }}">Under {{ filter.max_value.value | money }} ×</a>{% endif %}{% endfor %}</div>{% endif %}
          <svg class="ac__empty-icon" viewBox="0 0 36 36" aria-hidden="true"><circle cx="15" cy="15" r="9" fill="none" stroke="currentColor"/><path d="m22 22 8 8" fill="none" stroke="currentColor"/></svg>
          {% if active_filter_count > 0 %}<h2>A little more room to discover.</h2><p>No creations match this combination. Try removing a filter or widening your price range to find your next heirloom.</p><a class="ac__empty-button" href="{{ collection.url }}">Clear all filters</a><a class="ac__empty-link" href="{{ collection.url }}">Explore all {{ collection.all_products_count }} creations</a>{% else %}<h2>More creations are coming.</h2><p>Explore the rest of the atelier while this collection is being prepared.</p><a class="ac__empty-link" href="{{ routes.all_products_collection_url }}">Explore all creations</a>{% endif %}
        </div>
      {% endif %}

      {% if collection.products_count > 0 %}
        {% assign first_item = paginate.current_offset | plus: 1 %}
        {% assign last_item = paginate.current_offset | plus: collection.products.size %}
        <p class="ac__pagination-count">Showing {{ first_item }}–{{ last_item }} of {{ collection.products_count }} creations</p>
        {% if paginate.pages > 1 %}<nav class="ac__pagination" aria-label="Collection pages">
          {% if paginate.previous %}<a href="{{ paginate.previous.url }}" aria-label="Previous page">‹</a>{% else %}<span class="ac__pagination-disabled" aria-hidden="true">‹</span>{% endif %}
          {% for part in paginate.parts %}{% if part.is_link %}<a href="{{ part.url }}" aria-label="Page {{ part.title }}">{{ part.title }}</a>{% elsif part.title == paginate.current_page %}<span aria-current="page">{{ part.title }}</span>{% else %}<span>{{ part.title }}</span>{% endif %}{% endfor %}
          {% if paginate.next %}<a href="{{ paginate.next.url }}" aria-label="Next page">›</a>{% else %}<span class="ac__pagination-disabled" aria-hidden="true">›</span>{% endif %}
        </nav>{% endif %}
      {% endif %}
    {% endpaginate %}
  </div>

  <dialog class="ac__drawer ac__drawer--filter" id="ac-filters-{{ section.id }}" aria-label="Filter and refine">
    <div class="ac__drawer-head"><div><h2>Filter &amp; refine</h2><p>{{ collection.title | escape }}</p></div><button type="button" aria-label="Close filters" data-dialog-close>×</button></div>
    {% if collection.filters.size > 0 %}
      <form action="{{ collection.url }}" method="get" class="ac__filter-form">
        <input type="hidden" name="sort_by" value="{{ active_sort | escape }}">
        {% if active_filter_count > 0 %}<div class="ac__drawer-active">{% for filter in collection.filters %}{% for value in filter.active_values %}<a href="{{ value.url_to_remove }}">{{ value.label | escape }} ×</a>{% endfor %}{% if filter.type == 'price_range' and filter.min_value.value != nil %}<a href="{{ filter.url_to_remove }}">From {{ filter.min_value.value | money }} ×</a>{% endif %}{% if filter.type == 'price_range' and filter.max_value.value != nil %}<a href="{{ filter.url_to_remove }}">Under {{ filter.max_value.value | money }} ×</a>{% endif %}{% endfor %}<a href="{{ collection.url }}">Clear all</a></div>{% endif %}
        {% for filter in collection.filters %}
          {% assign filter_name = filter.label | downcase %}
          <details class="ac__filter-group"{% if filter.active_values.size > 0 or filter_name contains 'category' or filter_name contains 'metal' or filter.min_value.value != nil or filter.max_value.value != nil %} open{% endif %}>
            <summary>{{ filter.label | escape }}{% if filter.type == 'price_range' %} ({{ cart.currency.iso_code }}){% endif %}<span aria-hidden="true"></span></summary>
            {% case filter.type %}
              {% when 'list' %}
                <div class="ac__filter-values">{% for value in filter.values %}<label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}><span>{{ value.label | escape }}</span><small>{{ value.count }}</small></label>{% endfor %}</div>
              {% when 'boolean' %}
                <div class="ac__filter-values">{% if filter.true_value %}<label><input type="checkbox" name="{{ filter.true_value.param_name }}" value="{{ filter.true_value.value | escape }}"{% if filter.true_value.active %} checked{% endif %}{% if filter.true_value.count == 0 and filter.true_value.active == false %} disabled{% endif %}><span>{{ filter.true_value.label | escape }}</span><small>{{ filter.true_value.count }}</small></label>{% endif %}{% if filter.false_value %}<label><input type="checkbox" name="{{ filter.false_value.param_name }}" value="{{ filter.false_value.value | escape }}"{% if filter.false_value.active %} checked{% endif %}{% if filter.false_value.count == 0 and filter.false_value.active == false %} disabled{% endif %}><span>{{ filter.false_value.label | escape }}</span><small>{{ filter.false_value.count }}</small></label>{% endif %}</div>
              {% when 'price_range' %}
                <div class="ac__price-fields"><label>Minimum<input type="number" step="0.01" min="0" name="{{ filter.min_value.param_name }}"{% if filter.min_value.value != nil %} value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"{% endif %} placeholder="0"></label><label>Maximum<input type="number" step="0.01" min="0" name="{{ filter.max_value.param_name }}"{% if filter.max_value.value != nil %} value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"{% endif %} placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"></label></div>
            {% endcase %}
          </details>
        {% endfor %}
        <button class="ac__filter-submit" type="submit">Show creations</button>
      </form>
    {% else %}<p class="ac__no-filters">Filters will appear here when configured in Shopify Admin for this collection.</p>{% endif %}
  </dialog>

  <dialog class="ac__drawer ac__drawer--sort" id="ac-sort-{{ section.id }}" aria-label="Sort products">
    <div class="ac__drawer-head"><h2>Sort by</h2><button type="button" aria-label="Close sorting" data-dialog-close>×</button></div>
    <form action="{{ collection.url }}" method="get" class="ac__sort-form">
      {% for filter in collection.filters %}
        {% if filter.type == 'price_range' %}
          {% if filter.min_value.value != nil %}<input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}">{% endif %}
          {% if filter.max_value.value != nil %}<input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}">{% endif %}
        {% else %}{% for value in filter.active_values %}<input type="hidden" name="{{ value.param_name }}" value="{{ value.value | escape }}">{% endfor %}{% endif %}
      {% endfor %}
      {% for option in collection.sort_options %}
        {% if option.value == 'manual' or option.value == 'best-selling' or option.value == 'created-descending' or option.value == 'price-ascending' or option.value == 'price-descending' %}
          <label><span>{{ option.name | escape }}</span><input type="radio" name="sort_by" value="{{ option.value | escape }}"{% if option.value == active_sort %} checked{% endif %} data-sort-option></label>
        {% endif %}
      {% endfor %}
      <button class="ac__sort-submit" type="submit">Apply sort</button>
    </form>
  </dialog>
  <span class="ac__sr-only" role="status" aria-live="polite" data-wishlist-status></span>
</section>

{% stylesheet %}
  .ac{--ac-ivory:#faf7f2;--ac-paper:#f4f0ea;--ac-ink:#26231f;--ac-muted:#77726c;--ac-gold:#79612d;--ac-line:#e4ded5;width:100%;background:var(--ac-ivory);color:var(--ac-ink);font-family:var(--font-primary--family),Arial,sans-serif}
  .ac *{box-sizing:border-box}.ac a{color:inherit}.ac__inner{width:min(100%,1536px);margin:auto;padding:0 48px 80px}.ac__sr-only,.acq__visually-hidden{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .ac__breadcrumbs{display:flex;align-items:center;gap:13px;min-height:65px;color:#8c877f;font-size:12px}.ac__breadcrumbs a{text-decoration:none}.ac__breadcrumbs [aria-current]{color:var(--ac-ink)}
  .ac__hero{display:grid;grid-template-columns:38% 62%;min-height:420px;margin-inline:-48px;background:#f2eee9}.ac__hero-copy{display:flex;flex-direction:column;justify-content:center;align-items:flex-start;padding:42px clamp(42px,5vw,96px) 42px 64px}.ac__eyebrow{margin:0 0 22px;color:var(--ac-gold);font-size:11px;font-weight:600;letter-spacing:.15em;line-height:1.4;text-transform:uppercase}.ac__hero h1,.ac__editorial h2,.ac__empty h2,.acq h2,.acq h3,.ac__drawer h2{font-family:Georgia,'Times New Roman',serif;font-weight:400;letter-spacing:-.035em}.ac__hero h1{max-width:510px;margin:0;font-size:clamp(46px,4vw,62px);line-height:1.04}.ac__hero-description{max-width:420px;margin:22px 0 0;color:#4f4b46;font-size:15px;line-height:1.7}.ac__hero-description p{margin:0}.ac__hero-note{margin:18px 0 0;color:var(--ac-gold);font-size:10px;letter-spacing:.12em;text-transform:uppercase}.ac__hero-visual{min-width:0;min-height:420px;background:#c6bbae}.ac__hero-image{display:block;width:100%;height:100%;object-fit:cover}
  .ac__categories{display:flex;align-items:center;justify-content:center;gap:42px;min-height:104px;overflow-x:auto;border-bottom:1px solid var(--ac-line);white-space:nowrap;scrollbar-width:thin}.ac__categories a{display:inline-flex;align-items:center;min-height:43px;border-bottom:1px solid transparent;color:#68635e;font-size:12px;text-decoration:none}.ac__categories a:hover,.ac__categories a[aria-current]{border-color:var(--ac-gold);color:var(--ac-gold)}
  .ac__toolbar{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:12px;min-height:64px;border-bottom:1px solid var(--ac-line)}.ac__filter-controls{display:flex;align-items:center;gap:28px;min-width:0}.ac__toolbar button{display:inline-flex;align-items:center;gap:9px;padding:8px 0;border:0;background:none;color:var(--ac-ink);font:inherit;font-size:12px;text-transform:uppercase;white-space:nowrap;cursor:pointer}.ac__filter-trigger svg{width:17px;height:17px}.ac__filter-shortcut{color:#5a554f!important;text-transform:none!important}.ac__result-count{color:#8b857e;font-size:12px}.ac__sort-trigger{justify-self:end;text-transform:none!important}.ac__active-filters{display:flex;gap:8px;flex-wrap:wrap;padding:14px 0}.ac__active-filters a{padding:8px 12px;background:var(--ac-paper);font-size:12px;text-decoration:none}.ac__active-filters .ac__active-clear{margin-left:auto;background:none;text-decoration:underline}
  .ac__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:48px 24px;padding-top:32px}.ac__card{min-width:0;border:1px solid var(--ac-line);background:#fff}.ac__card-media{position:relative;aspect-ratio:4/4.65;overflow:hidden;background:#e4ded4}.ac__card-image-link{display:block;width:100%;height:100%}.ac__card-image{display:block;width:100%;height:100%;object-fit:cover;transition:transform .55s ease,opacity .4s ease}.ac__card-image--hover{position:absolute;inset:0;opacity:0}.ac__card:hover .ac__card-image:not(.ac__card-image--hover){transform:scale(1.035)}.ac__card:hover .ac__card-image--hover{opacity:1;transform:scale(1.035)}.ac__badge{position:absolute;top:14px;left:14px;max-width:calc(100% - 68px);padding:6px 9px;background:rgb(255 255 255 / 94%);color:var(--ac-gold);font-size:10px;letter-spacing:.06em;text-transform:uppercase}.ac__wishlist{position:absolute;top:12px;right:12px;display:grid;width:36px;height:36px;place-items:center;border:0;border-radius:50%;background:#fff;color:var(--ac-ink);cursor:pointer}.ac__wishlist svg{width:19px;height:19px}.ac__wishlist[aria-pressed=true] svg path{fill:var(--ac-gold);stroke:var(--ac-gold)}.ac__card-actions{position:absolute;right:11px;bottom:11px;left:11px;display:grid;grid-template-columns:1fr 1fr;min-height:42px;opacity:0;transform:translateY(8px);transition:opacity .25s,transform .25s}.ac__card:hover .ac__card-actions,.ac__card:focus-within .ac__card-actions{opacity:1;transform:none}.ac__card-actions form{min-width:0}.ac__card-actions button{width:100%;height:42px;padding:5px;border:0;background:#fff;color:var(--ac-gold);font:inherit;font-size:11px;letter-spacing:.04em;text-transform:uppercase;cursor:pointer}.ac__card-actions .ac__quick-add{background:var(--ac-gold);color:#fff}.ac__card-copy{display:flex;min-height:173px;flex-direction:column;padding:15px 16px 16px}.ac__card-meta{display:flex;align-items:center;justify-content:space-between;gap:8px;color:#8d8880;font-size:11px}.ac__metal-dot{flex:0 0 auto;width:10px;height:10px;border-radius:50%;background:var(--ac-metal)}.ac__card h3{min-height:52px;margin:8px 0;font-family:Georgia,'Times New Roman',serif;font-size:21px;font-weight:400;line-height:1.2}.ac__card h3 a{text-decoration:none}.ac__card h3 a:hover{color:var(--ac-gold)}.ac__card-detail{overflow:hidden;margin:auto 0 10px;color:#8d8880;font-size:11px;text-overflow:ellipsis;white-space:nowrap}.ac__card-price{display:flex;align-items:center;gap:8px;margin:auto 0 0;padding-top:10px;border-top:1px solid var(--ac-line);font-size:14px}.ac__card-price s{color:#9b948b;font-size:12px}
