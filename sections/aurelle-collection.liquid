{% javascript %}
  (function () {
    const wishlistKey = 'aurelle-wishlist-products';
    function savedProducts() { try { return JSON.parse(localStorage.getItem(wishlistKey) || '[]'); } catch (_) { return []; } }
    function setup(section) {
      section.querySelectorAll('.acq').forEach(dialog => {
        dialog.classList.add('is-enhanced');
        const select = dialog.querySelector('[data-quick-view-variant]');
        if (select) select.tabIndex = -1;
      });
      section.querySelectorAll('.ac__sort-form').forEach(form => form.classList.add('is-enhanced'));
      const saved = savedProducts();
      section.querySelectorAll('[data-wishlist-product]').forEach(button => button.setAttribute('aria-pressed', String(saved.includes(button.dataset.wishlistProduct))));
    }
    document.querySelectorAll('[data-aurelle-collection]').forEach(setup);
    document.addEventListener('shopify:section:load', event => {
      if (event.target.matches?.('[data-aurelle-collection]')) setup(event.target);
      event.target.querySelectorAll('[data-aurelle-collection]').forEach(setup);
    });
    document.addEventListener('click', event => {
      const section = event.target.closest('[data-aurelle-collection]');
      if (!section) return;
      if (event.target.matches('dialog.ac__drawer, dialog.acq')) {
        const bounds = event.target.getBoundingClientRect();
        if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) event.target.close();
      }
      const opener = event.target.closest('[data-open-dialog],[data-quick-view-open]');
      if (opener) document.getElementById(opener.dataset.openDialog || opener.dataset.quickViewOpen)?.showModal();
      const closer = event.target.closest('[data-dialog-close]');
      if (closer) closer.closest('dialog')?.close();
      const wishlist = event.target.closest('[data-wishlist-product]');
      if (wishlist) {
        const saved = new Set(savedProducts());
        const id = wishlist.dataset.wishlistProduct;
        saved.has(id) ? saved.delete(id) : saved.add(id);
        try { localStorage.setItem(wishlistKey, JSON.stringify([...saved])); } catch (_) {}
        section.querySelectorAll('[data-wishlist-product="' + id + '"]').forEach(button => button.setAttribute('aria-pressed', String(saved.has(id))));
        const status = section.querySelector('[data-wishlist-status]');
        if (status) status.textContent = saved.has(id) ? 'Saved to your wishlist on this device.' : 'Removed from your wishlist on this device.';
      }
      const choice = event.target.closest('[data-option-value]');
      if (choice) {
        const dialog = choice.closest('.acq');
        const group = choice.closest('[data-option-position]');
        group.querySelectorAll('[data-option-value]').forEach(button => button.setAttribute('aria-pressed', String(button === choice)));
        group.querySelector('[data-selected-label]').textContent = choice.dataset.optionValue;
        const selected = [...dialog.querySelectorAll('[data-option-position]')].map(item => item.querySelector('[aria-pressed="true"]')?.dataset.optionValue || '');
        const select = dialog.querySelector('[data-quick-view-variant]');
        const match = [...select.options].find(option => [option.dataset.option1, option.dataset.option2, option.dataset.option3].slice(0, selected.length).every((value, index) => value === selected[index]));
        const add = dialog.querySelector('[data-quick-view-add]');
        const stock = dialog.querySelector('[data-quick-view-stock]');
        if (match) {
          select.value = match.value;
          const available = match.dataset.available === 'true';
          add.disabled = !available;
          stock.textContent = available ? 'In stock' : 'Sold out';
          dialog.querySelector('[data-quick-view-price]').textContent = match.dataset.price;
          dialog.querySelector('[data-quick-view-add-price]').textContent = match.dataset.price;
        } else { add.disabled = true; stock.textContent = 'Combination unavailable'; }
      }
    });
    document.addEventListener('change', event => {
      const radio = event.target.closest('[data-sort-option]');
      if (radio) {
        const url = new URL(window.location.href);
        url.searchParams.set('sort_by', radio.value);
        url.searchParams.delete('page');
        window.location.assign(url.toString());
      }
      const select = event.target.closest('[data-quick-view-variant]');
      if (select) {
        const dialog = select.closest('.acq');
        const option = select.selectedOptions[0];
        dialog.querySelector('[data-quick-view-price]').textContent = option.dataset.price;
        dialog.querySelector('[data-quick-view-add-price]').textContent = option.dataset.price;
      }
    });
  })();
{% endjavascript %}

