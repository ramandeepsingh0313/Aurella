{% comment %}
  This section is used in the cart template to render /cart page with an
  overview of the items in customer's cart.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

<section class="aurelle-cart full-width">
  <div class="aurelle-cart__inner">
    <h1>{{ 'cart.title' | t }}</h1>

    {% if cart.item_count == 0 %}
      <p>{{ 'cart.empty' | t }}</p>
      <a class="aurelle-cart__continue" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post">
        <table class="aurelle-cart__table">
          <caption class="visually-hidden">{{ 'cart.title' | t }}</caption>
          <thead>
            <tr>
              <th scope="col">{{ 'cart.product' | t }}</th>
              <th scope="col">{{ 'cart.quantity' | t }}</th>
              <th scope="col">{{ 'cart.total' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {% for item in cart.items %}
              <tr>
                <td class="aurelle-cart__item">
                  {% render 'image', class: 'aurelle-cart__image', image: item.image, url: item.url, width: 240, sizes: '(min-width: 701px) 120px, 80px' %}
                  <span class="aurelle-cart__item-copy">
                    <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
                    {% unless item.variant.title == 'Default Title' %}<span>{{ item.variant.title | escape }}</span>{% endunless %}
                    {{ 'cart.remove' | t | link_to: item.url_to_remove }}
                  </span>
                </td>
                <td class="aurelle-cart__quantity">
                  <label class="visually-hidden" for="CartQuantity-{{ item.index | plus: 1 }}">{{ 'cart.quantity' | t }} — {{ item.product.title | escape }}</label>
                  <input id="CartQuantity-{{ item.index | plus: 1 }}" type="number" name="updates[]" min="0" value="{{ item.quantity }}" inputmode="numeric">
                </td>
                <td class="aurelle-cart__line-total">{{ item.final_line_price | money_with_currency }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        <div class="aurelle-cart__summary">
          <button class="aurelle-cart__update" type="submit" name="update">{{ 'cart.update' | t }}</button>
          <p>{{ 'cart.total' | t }} <strong>{{ cart.total_price | money_with_currency }}</strong></p>
          <button class="aurelle-cart__checkout" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
        </div>
      </form>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .aurelle-cart {
    padding-block: clamp(40px, 6vw, 88px);
  }

  .aurelle-cart__inner {
    width: min(1184px, calc(100% - clamp(32px, 8vw, 112px)));
    margin-inline: auto;
  }

  .aurelle-cart__inner > h1 {
    margin-bottom: 32px;
    font-family: 'Bodoni MT', Didot, Georgia, 'Times New Roman', serif;
    font-size: clamp(34px, 5vw, 56px);
    font-weight: 400;
    line-height: 1.1;
  }

  .aurelle-cart__table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .aurelle-cart__table th,
  .aurelle-cart__table td {
    padding: 16px 12px;
    border-bottom: 1px solid #e6e1da;
    text-align: left;
    vertical-align: middle;
    overflow-wrap: anywhere;
  }

  .aurelle-cart__table th:first-child,
  .aurelle-cart__item {
    width: 60%;
  }

  .aurelle-cart__item {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .aurelle-cart__image {
    width: 96px;
    flex: 0 0 96px;
  }

  .aurelle-cart__image img {
    width: 100%;
    height: auto;
  }

  .aurelle-cart__item-copy {
    display: grid;
    min-width: 0;
    gap: 6px;
  }

  .aurelle-cart__item-copy a {
    color: inherit;
  }

  .aurelle-cart__item-copy span,
  .aurelle-cart__item-copy a:last-child {
    color: #77716a;
    font-size: 13px;
  }

  .aurelle-cart__quantity input {
    width: 76px;
    min-height: 42px;
    padding: 8px;
  }

  .aurelle-cart__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
    margin-top: 24px;
  }

  .aurelle-cart__summary p {
    margin: 0 auto 0 0;
    font-size: 16px;
  }

  .aurelle-cart__summary button,
  .aurelle-cart__continue {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    padding: 10px 18px;
    border: 1px solid #1e1c19;
    color: #1e1c19;
    background: transparent;
    cursor: pointer;
    font: inherit;
    text-decoration: none;
  }

  .aurelle-cart__summary .aurelle-cart__checkout {
    color: #fff;
    background: #1e1c19;
  }

  .aurelle-cart__continue {
    margin-top: 16px;
  }

  @media screen and (max-width: 600px) {
    .aurelle-cart__inner {
      width: calc(100% - 32px);
    }

    .aurelle-cart__table,
    .aurelle-cart__table tbody {
      display: block;
    }

    .aurelle-cart__table thead {
      position: absolute;
      overflow: hidden;
      width: 1px;
      height: 1px;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    .aurelle-cart__table tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 8px 12px;
      padding-block: 12px;
      border-bottom: 1px solid #e6e1da;
    }

    .aurelle-cart__table th,
    .aurelle-cart__table td {
      width: auto;
      padding: 4px 0;
      border: 0;
    }

    .aurelle-cart__item {
      grid-column: 1 / -1;
    }

    .aurelle-cart__image {
      width: 72px;
      flex-basis: 72px;
    }

    .aurelle-cart__line-total {
      text-align: right !important;
    }

    .aurelle-cart__summary {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .aurelle-cart__summary p {
      grid-column: 1 / -1;
    }

    .aurelle-cart__summary button {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
