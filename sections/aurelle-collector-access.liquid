<section
  class="aurelle-collector full-width"
  style="--aurelle-collector-page: {{ section.settings.page_background }}; --aurelle-collector-strip: {{ section.settings.strip_background }}; --aurelle-collector-panel: {{ section.settings.panel_background }}; --aurelle-collector-foreground: {{ section.settings.foreground_color }}; --aurelle-collector-muted: {{ section.settings.muted_color }}; --aurelle-collector-accent: {{ section.settings.accent_color }};"
  aria-label="{{ section.settings.heading | escape }}"
>
  {% if section.blocks.size > 0 %}
    <div class="aurelle-collector__strip">
      <div class="aurelle-collector__strip-inner">
        <ul class="aurelle-collector__benefits" role="list">
          {% for block in section.blocks %}
            <li class="aurelle-collector__benefit" {{ block.shopify_attributes }}>
              <span class="aurelle-collector__benefit-icon" aria-hidden="true">
                {% case block.settings.icon %}
                  {% when 'transit' %}
                    <svg viewBox="0 0 24 24" focusable="false"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7zM6.5 20a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM18 20a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"/><path d="M17 10v3h4"/></svg>
                  {% when 'adjustments' %}
                    <svg viewBox="0 0 24 24" focusable="false"><path d="M20 7h-8M8 7H4m16 10h-4m-4 0H4"/><circle cx="10" cy="7" r="2"/><circle cx="14" cy="17" r="2"/><path d="M7 3 4 6l3 3M17 21l3-3-3-3"/></svg>
                  {% when 'gia' %}
                    <svg viewBox="0 0 24 24" focusable="false"><path d="m12 3 2 2.2 3-.3.8 2.8 2.7 1.5-1 2.8 1 2.8-2.7 1.5-.8 2.8-3-.3-2 2.2-2-2.2-3 .3-.8-2.8-2.7-1.5 1-2.8-1-2.8 2.7-1.5.8-2.8 3 .3z"/><path d="m9 12 2 2 4-4"/></svg>
                  {% when 'casket' %}
                    <svg viewBox="0 0 24 24" focusable="false"><path d="M4 10h16v10H4zM3 7h18v3H3zM12 7v13M12 7H8.5a2 2 0 1 1 2-2L12 7Zm0 0h3.5a2 2 0 1 0-2-2L12 7Z"/></svg>
                {% endcase %}
              </span>
              <span class="aurelle-collector__benefit-copy">
                {% if block.settings.heading != blank %}
                  <span class="aurelle-collector__benefit-heading">{{ block.settings.heading | escape }}</span>
                {% endif %}
                {% if block.settings.description != blank %}
                  <span class="aurelle-collector__benefit-description">{{ block.settings.description | escape }}</span>
                {% endif %}
              </span>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  {% endif %}

  <div class="aurelle-collector__main">
    <div class="aurelle-collector__panel">
      <span class="aurelle-collector__salon-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" focusable="false"><path d="m16 2 3.5 7.2 8 .9-5.9 5.5 1.5 7.8-7.1-3.9-7.1 3.9 1.5-7.8-5.9-5.5 8-.9L16 2Z"/><path d="m21.7 20.4 1.5 3.8 4.1.4-3.1 2.8.8 4-3.6-2-2.4 1.3"/></svg>
      </span>
      {% if section.settings.eyebrow != blank %}
        <p class="aurelle-collector__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="aurelle-collector__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="aurelle-collector__description">{{ section.settings.description | escape | newline_to_br }}</p>
      {% endif %}

      {% capture collector_email_id %}AurelleCollectorEmail-{{ section.id }}{% endcapture %}
      {% form 'customer', id: section.id, class: 'aurelle-collector__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter, aurelle-collector">
        <label class="aurelle-collector__visually-hidden" for="{{ collector_email_id }}">{{ section.settings.email_label | escape }}</label>
        <input
          class="aurelle-collector__email"
          id="{{ collector_email_id }}"
          type="email"
          name="contact[email]"
          value="{{ form.email | escape }}"
          placeholder="{{ section.settings.email_placeholder | escape }}"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          required
        >
        <button class="aurelle-collector__submit" type="submit">{{ section.settings.button_label | escape }}</button>
        {% if form.errors %}
          <div class="aurelle-collector__message aurelle-collector__message--error" role="alert">{{ form.errors | default_errors }}</div>
        {% endif %}
        {% if form.posted_successfully? %}
          <p class="aurelle-collector__message aurelle-collector__message--success" role="status">{{ section.settings.success_message | escape }}</p>
        {% endif %}
      {% endform %}

      {% if section.settings.privacy_note != blank %}
        <p class="aurelle-collector__privacy">{{ section.settings.privacy_note | escape }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .aurelle-collector {
    width: 100%;
    color: var(--aurelle-collector-foreground);
    background: var(--aurelle-collector-page);
  }

  .aurelle-collector__strip {
    padding: 48px 42px;
    background: var(--aurelle-collector-strip);
  }

  .aurelle-collector__strip-inner {
    width: min(1380px, 100%);
    margin-inline: auto;
  }

  .aurelle-collector__benefits {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(18px, 2.4vw, 38px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .aurelle-collector__benefit {
    display: grid;
    min-width: 0;
    grid-template-columns: 42px minmax(0, 1fr);
    align-items: start;
    gap: 13px;
  }

  .aurelle-collector__benefit-icon {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 11px;
    color: var(--aurelle-collector-accent);
    background: #fff;
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .aurelle-collector__benefit:hover .aurelle-collector__benefit-icon {
    box-shadow: 0 5px 14px rgb(37 33 27 / 10%);
    transform: translateY(-3px);
  }

  .aurelle-collector__benefit-icon svg {
    width: 21px;
    height: 21px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.65;
  }

  .aurelle-collector__benefit-copy {
    display: grid;
    gap: 4px;
    padding-top: 3px;
  }

  .aurelle-collector__benefit-heading {
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
    font-size: 16px;
    line-height: 1.3;
  }

  .aurelle-collector__benefit-description {
    color: var(--aurelle-collector-muted);
    font-family: var(--font-primary--family);
    font-size: 14px;
    line-height: 1.5;
  }

  .aurelle-collector__main {
    padding: 82px 24px 76px;
  }

  .aurelle-collector__panel {
    display: flex;
    width: min(780px, 100%);
    min-height: 402px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-inline: auto;
    padding: 44px 48px;
    background: linear-gradient(118deg, var(--aurelle-collector-panel) 0%, var(--aurelle-collector-panel) 72%, rgb(225 219 208 / 22%) 100%);
    box-shadow: 0 2px 5px rgb(33 30 26 / 12%);
    text-align: center;
  }

  .aurelle-collector__salon-mark {
    display: block;
    width: 30px;
    height: 30px;
    margin-bottom: 7px;
    color: var(--aurelle-collector-accent);
  }

  .aurelle-collector__salon-mark svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .aurelle-collector__eyebrow {
    margin: 0 0 8px;
    color: var(--aurelle-collector-accent);
    font-family: var(--font-primary--family);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .aurelle-collector__heading {
    margin: 0;
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
    font-size: clamp(32px, 3.3vw, 40px);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .aurelle-collector__description {
    max-width: 570px;
    margin: 8px 0 0;
    color: var(--aurelle-collector-muted);
    font-family: var(--font-primary--family);
    font-size: 16px;
    line-height: 1.55;
  }

  .aurelle-collector__form {
    display: flex;
    width: min(420px, 100%);
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-top: 34px;
  }

  .aurelle-collector__visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    clip-path: inset(50%);
  }

  .aurelle-collector__email {
    width: 0;
    min-width: 0;
    min-height: 46px;
    flex: 1 1 215px;
    padding: 0 14px;
    border: 1px solid rgb(44 40 34 / 8%);
    border-radius: 0;
    color: var(--aurelle-collector-foreground);
    background: #fff;
    font-family: var(--font-primary--family);
    font-size: 16px;
  }

  .aurelle-collector__email::placeholder {
    color: #958f86;
    opacity: 1;
  }

  .aurelle-collector__submit {
    min-width: 153px;
    min-height: 46px;
    padding: 0 18px;
    border: 1px solid #111;
    border-radius: 0;
    color: #fff;
    background: #111;
    cursor: pointer;
    font-family: var(--font-primary--family);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color 180ms ease, background-color 180ms ease, transform 180ms ease;
  }

  .aurelle-collector__submit:hover {
    color: #111;
    background: transparent;
    transform: translateY(-2px);
  }

  .aurelle-collector__privacy {
    margin: 14px 0 0;
    color: var(--aurelle-collector-muted);
    font-family: var(--font-primary--family);
    font-size: 14px;
    line-height: 1.5;
    text-align: center;
  }

  .aurelle-collector__message {
    flex: 0 0 100%;
    margin: 4px 0 0;
    font-family: var(--font-primary--family);
    font-size: 14px;
    line-height: 1.5;
    text-align: center;
  }

  .aurelle-collector__message--error {
    color: #9c2d24;
  }

  .aurelle-collector__message--success {
    color: var(--aurelle-collector-accent);
  }

  .aurelle-collector__message ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (max-width: 1000px) {
    .aurelle-collector__strip {
      padding-inline: 28px;
    }

    .aurelle-collector__benefits {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 24px;
    }
  }

  @media screen and (max-width: 700px) {
    .aurelle-collector__strip {
      padding: 30px 20px;
    }

    .aurelle-collector__benefits {
      gap: 20px 16px;
    }

    .aurelle-collector__benefit {
      grid-template-columns: 36px minmax(0, 1fr);
      gap: 10px;
    }

    .aurelle-collector__benefit-icon {
      width: 36px;
      height: 36px;
    }

    .aurelle-collector__benefit-icon svg {
      width: 19px;
      height: 19px;
    }

    .aurelle-collector__benefit-heading {
      font-size: 16px;
    }

    .aurelle-collector__benefit-description {
      font-size: 14px;
    }

    .aurelle-collector__main {
      padding: 46px 20px 48px;
    }

    .aurelle-collector__panel {
      min-height: 0;
      padding: 44px 24px;
    }

    .aurelle-collector__form {
      width: min(360px, 100%);
      margin-top: 26px;
    }

    .aurelle-collector__email,
    .aurelle-collector__submit {
      min-height: 46px;
      flex-basis: 100%;
    }
  }

  @media screen and (max-width: 440px) {
    .aurelle-collector__benefits {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }

    .aurelle-collector__benefit {
      grid-template-columns: 40px minmax(0, 1fr);
    }

    .aurelle-collector__benefit-icon {
      width: 40px;
      height: 40px;
    }

    .aurelle-collector__heading {
      font-size: clamp(28px, 8vw, 34px);
    }

    .aurelle-collector__panel {
      padding: 38px 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aurelle-collector__benefit-icon,
    .aurelle-collector__submit {
      transition: none;
    }

    .aurelle-collector__benefit:hover .aurelle-collector__benefit-icon,
    .aurelle-collector__submit:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AURELLE collector",
  "settings": [
    { "type": "color", "id": "page_background", "label": "Page background", "default": "#FCF9F4" },
    { "type": "color", "id": "strip_background", "label": "Benefits background", "default": "#F0EDE9" },
    { "type": "color", "id": "panel_background", "label": "Signup panel background", "default": "#F6F3EE" },
    { "type": "color", "id": "foreground_color", "label": "Primary text", "default": "#292621" },
    { "type": "color", "id": "muted_color", "label": "Secondary text", "default": "#706B64" },
    { "type": "color", "id": "accent_color", "label": "Muted gold accent", "default": "#856322" },
    { "type": "text", "id": "eyebrow", "label": "Salon eyebrow", "default": "The AURELLE Salon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Private Collector Access" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Members receive priority allocation for limited atelier releases, private salon previews in Paris and New York, and bespoke concierge appointments." },
    { "type": "text", "id": "email_label", "label": "Accessible email label", "default": "Email address" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "Enter your private correspondence email" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Request Access" },
    { "type": "text", "id": "success_message", "label": "Signup success message", "default": "Thank you. Your request has been received." },
    { "type": "text", "id": "privacy_note", "label": "Privacy note", "default": "By joining, you respect our privacy terms. Unsubscribe at your discretion." }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Service benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "transit", "label": "Insured transit" },
            { "value": "adjustments", "label": "Atelier adjustments" },
            { "value": "gia", "label": "Certification" },
            { "value": "casket", "label": "Gift casket" }
          ],
          "default": "transit"
        },
        { "type": "text", "id": "heading", "label": "Benefit heading", "default": "Armored Insured Transit" },
        { "type": "textarea", "id": "description", "label": "Benefit description", "default": "Direct insured courier with mandatory biometric or physical signature upon release." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "AURELLE collector",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "transit", "heading": "Armored Insured Transit", "description": "Direct insured courier with mandatory biometric or physical signature upon release." } },
        { "type": "benefit", "settings": { "icon": "adjustments", "heading": "30-Day Atelier Adjustments", "description": "Complimentary sizing, vault exchanges, and full insurance returns within thirty days." } },
        { "type": "benefit", "settings": { "icon": "gia", "heading": "GIA Certified & Hallmarked", "description": "Stamped with French eagle hallmarks and accompanied by full laboratory dossiers." } },
        { "type": "benefit", "settings": { "icon": "casket", "heading": "Signature Silk Casket", "description": "Handcrafted velour jewellery trunk with personalized calligraphed wax-sealed letter." } }
      ]
    }
  ]
}
{% endschema %}
