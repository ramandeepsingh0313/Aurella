{% liquid
  assign show_hero_actions = false
  if section.settings.primary_cta_label != blank
    if section.settings.primary_cta_link != blank
      assign show_hero_actions = true
    endif
  endif

  if section.settings.secondary_cta_label != blank
    if section.settings.secondary_cta_link != blank
      assign show_hero_actions = true
    endif
  endif

  assign main_image_alt = section.settings.main_image_alt
  if main_image_alt == blank
    assign main_image_alt = section.settings.heading | strip_html | strip
  endif

  assign detail_image_alt = section.settings.detail_image_alt
  if detail_image_alt == blank
    assign detail_image_alt = section.settings.caption_title | default: section.settings.caption_eyebrow
  endif
%}

<section
  class="aurelle-hero full-width"
  style="--aurelle-hero-background: {{ section.settings.background_color }}; --aurelle-hero-foreground: {{ section.settings.foreground_color }}; --aurelle-hero-accent: {{ section.settings.accent_color }};"
  aria-labelledby="AurelleHeroHeading-{{ section.id }}"
>
  <div class="aurelle-hero__inner">
    <div class="aurelle-hero__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="aurelle-hero__eyebrow">
          <span aria-hidden="true"></span>
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="aurelle-hero__heading" id="AurelleHeroHeading-{{ section.id }}">
          {{ section.settings.heading }}
        </h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="aurelle-hero__description">{{ section.settings.description | escape | newline_to_br }}</div>
      {% endif %}

      {% if show_hero_actions %}
        <div class="aurelle-hero__actions">
          {% if section.settings.primary_cta_label != blank and section.settings.primary_cta_link != blank %}
            <a class="aurelle-hero__button" href="{{ section.settings.primary_cta_link | escape }}">
              {{ section.settings.primary_cta_label | escape }}
            </a>
          {% endif %}

          {% if section.settings.secondary_cta_label != blank and section.settings.secondary_cta_link != blank %}
            <a class="aurelle-hero__text-link" href="{{ section.settings.secondary_cta_link | escape }}">
              {{ section.settings.secondary_cta_label | escape }}
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                <path d="M2.5 8h10M8.5 3.5 13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.proof_point_one != blank or section.settings.proof_point_two != blank %}
        <ul class="aurelle-hero__proof-points" aria-label="Atelier credentials">
          {% if section.settings.proof_point_one != blank %}
            <li>
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                <path d="m10 1.6 2 1.1 2.3-.1.9 2.1 1.9 1.3-.5 2.2.8 2.2-1.7 1.5-.6 2.2-2.2.4L10 16l-2.1-1.5-2.2-.4-.6-2.2-1.7-1.5.8-2.2-.5-2.2 1.9-1.3.9-2.1 2.3.1 2-1.1Z" stroke="currentColor" stroke-width="1.2" />
                <path d="m6.8 9.5 2.1 2.1 4.4-4.4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span>{{ section.settings.proof_point_one | escape }}</span>
            </li>
          {% endif %}
          {% if section.settings.proof_point_one != blank and section.settings.proof_point_two != blank %}
            <li class="aurelle-hero__proof-separator" aria-hidden="true"></li>
          {% endif %}
          {% if section.settings.proof_point_two != blank %}
            <li>
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                <path d="M5.1 2.8h9.8l3.2 4.1L10 17.3 1.9 6.9l3.2-4.1Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" />
                <path d="m5.1 2.8 1.5 4.1L10 17.3l3.4-10.4 1.5-4.1M1.9 6.9h16.2" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round" />
              </svg>
              <span>{{ section.settings.proof_point_two | escape }}</span>
            </li>
          {% endif %}
        </ul>
      {% endif %}
    </div>

    <div class="aurelle-hero__visual" role="group" aria-label="Collection and atelier imagery">
      <div class="aurelle-hero__main-image">
        {% if section.settings.main_image != blank %}
          {{ section.settings.main_image | image_url: width: 1400 | image_tag: class: 'aurelle-hero__image', alt: main_image_alt, widths: '444, 888, 1332', sizes: '(min-width: 1200px) 444px, (min-width: 761px) 42vw, 100vw', loading: 'eager' }}
        {% else %}
          <img
            class="aurelle-hero__image"
            src="{{ 'aurelle-hero-main.jpeg' | asset_url }}"
            alt="{{ main_image_alt | escape }}"
            width="512"
            height="288"
            loading="eager"
          >
        {% endif %}
      </div>

      <div class="aurelle-hero__detail-card">
        <div class="aurelle-hero__detail-image">
          {% if section.settings.detail_image != blank %}
            {{ section.settings.detail_image | image_url: width: 900 | image_tag: class: 'aurelle-hero__image', alt: detail_image_alt, widths: '254, 508, 762', sizes: '(min-width: 1200px) 254px, 42vw', loading: 'lazy' }}
          {% else %}
            <img
              class="aurelle-hero__image"
              src="{{ 'aurelle-hero-detail.jpeg' | asset_url }}"
              alt="{{ detail_image_alt | escape }}"
              width="512"
              height="288"
              loading="lazy"
            >
          {% endif %}
        </div>
        {% if section.settings.caption_eyebrow != blank or section.settings.caption_title != blank %}
          <div class="aurelle-hero__caption">
            {% if section.settings.caption_eyebrow != blank %}
              <p>{{ section.settings.caption_eyebrow | escape }}</p>
            {% endif %}
            {% if section.settings.caption_title != blank %}
              <span>{{ section.settings.caption_title | escape }}</span>
            {% endif %}
          </div>
        {% endif %}
      </div>

      {% if section.settings.appointment_badge != blank %}
        {% if section.settings.appointment_link != blank %}
          <a class="aurelle-hero__appointment" href="{{ section.settings.appointment_link | escape }}">
            <span aria-hidden="true"></span>
            {{ section.settings.appointment_badge | escape }}
          </a>
        {% else %}
          <p class="aurelle-hero__appointment">
            <span aria-hidden="true"></span>
            {{ section.settings.appointment_badge | escape }}
          </p>
        {% endif %}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .aurelle-hero {
    width: 100%;
    padding-block: 96px;
    color: var(--aurelle-hero-foreground);
    background: var(--aurelle-hero-background);
  }

  .aurelle-hero__inner {
    display: grid;
    width: min(1184px, calc(100% - 96px));
    min-height: 555px;
    grid-template-columns: minmax(0, 0.697fr) minmax(0, 1fr);
    align-items: center;
    gap: 40px;
    margin-inline: auto;
  }

  .aurelle-hero__copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding-block: 38px;
  }

  .aurelle-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 22px;
    color: var(--aurelle-hero-accent);
    font-family: var(--font-primary--family);
    font-size: 10px;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .aurelle-hero__eyebrow span {
    width: 32px;
    height: 1px;
    flex: 0 0 32px;
    background: currentColor;
  }

  .aurelle-hero__heading {
    max-width: 100%;
    margin: 0;
    /* Approximate display-serif stack; the Figma font family isn't exposed in the inspected metadata. */
    font-family: 'Bodoni MT', Didot, Georgia, 'Times New Roman', serif;
    font-size: clamp(52px, 4.4vw, 60px);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1.14;
  }

  .aurelle-hero__heading p {
    margin: 0;
  }

  .aurelle-hero__heading em {
    font-weight: 400;
  }

  .aurelle-hero__description {
    max-width: 470px;
    margin-top: 16px;
    color: rgb(39 37 33 / 78%);
    font-family: var(--font-primary--family);
    font-size: 16px;
    line-height: 1.62;
  }

  .aurelle-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 36px;
  }

  .aurelle-hero__button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 0 32px;
    /* Approximate charcoal/white CTA treatment from the Figma screenshot. */
    color: #fff;
    background: #171716;
    font-family: var(--font-primary--family);
    font-size: 11px;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 160ms ease;
  }

  .aurelle-hero__button:hover {
    background: var(--aurelle-hero-accent);
  }

  .aurelle-hero__text-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 8px;
    padding: 0 8px;
    color: var(--aurelle-hero-foreground);
    font-family: var(--font-primary--family);
    font-size: 11px;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-decoration: none;
    text-transform: uppercase;
  }

  .aurelle-hero__text-link svg {
    width: 16px;
    height: 16px;
  }

  .aurelle-hero__button:focus-visible,
  .aurelle-hero__text-link:focus-visible,
  .aurelle-hero__appointment:focus-visible {
    outline: 2px solid var(--aurelle-hero-accent);
    outline-offset: 4px;
  }

  .aurelle-hero__proof-points {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin: 42px 0 0;
    padding: 0;
    list-style: none;
  }

  .aurelle-hero__proof-points li:not(.aurelle-hero__proof-separator) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: rgb(39 37 33 / 82%);
    font-family: var(--font-primary--family);
    font-size: 10px;
    letter-spacing: 0.04em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .aurelle-hero__proof-points svg {
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
    color: var(--aurelle-hero-accent);
  }

  .aurelle-hero__proof-separator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgb(134 106 53 / 38%);
  }

  .aurelle-hero__visual {
    position: relative;
    min-width: 0;
    min-height: 555px;
  }

  .aurelle-hero__main-image {
    position: absolute;
    top: 0;
    left: 0;
    overflow: hidden;
    width: calc(100% - 230px);
    height: 100%;
    background: #e9e3d8;
  }

  .aurelle-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .aurelle-hero__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    fill: #d6d0c6;
  }

  .aurelle-hero__placeholder-label {
    position: absolute;
    right: 12px;
    bottom: 12px;
    left: 12px;
    padding: 8px 10px;
    color: var(--aurelle-hero-foreground);
    background: rgb(247 244 239 / 90%);
    font-size: 11px;
    line-height: 1.4;
    text-align: center;
  }

  .aurelle-hero__detail-card {
    position: absolute;
    z-index: 1;
    top: 136px;
    right: 0;
    width: 214px;
  }

  .aurelle-hero__detail-image {
    position: relative;
    overflow: hidden;
    width: 254px;
    height: 339px;
    margin-left: -40px;
    background: #e5dfd3;
  }

  .aurelle-hero__caption {
    position: relative;
    display: flex;
    min-height: 48px;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    width: 254px;
    margin-left: -40px;
    padding: 6px 8px;
    background: #fff;
    box-shadow: 0 5px 14px rgb(39 37 33 / 10%);
  }

  .aurelle-hero__caption p,
  .aurelle-hero__caption span {
    overflow: hidden;
    margin: 0;
    color: var(--aurelle-hero-foreground);
    font-family: var(--font-primary--family);
    font-size: 12px;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .aurelle-hero__caption p {
    color: var(--aurelle-hero-accent);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .aurelle-hero__appointment {
    position: absolute;
    z-index: 2;
    right: 48px;
    bottom: -16px;
    display: inline-flex;
    min-height: 38px;
    align-items: center;
    gap: 12px;
    max-width: calc(100% - 48px);
    margin: 0;
    padding: 0 20px;
    color: var(--aurelle-hero-foreground);
    background: #fff;
    box-shadow: 0 5px 14px rgb(39 37 33 / 12%);
    font-family: var(--font-primary--family);
    font-size: 10px;
    letter-spacing: 0.12em;
    line-height: 1.35;
    text-decoration: none;
    text-transform: uppercase;
  }

  .aurelle-hero__appointment > span {
    width: 10px;
    height: 10px;
    flex: 0 0 10px;
    border-radius: 50%;
    background: var(--aurelle-hero-accent);
  }

  /* Responsive breakpoints and stacking are implementation adaptations; Figma includes only a desktop hero. */
  @media screen and (max-width: 1000px) {
    .aurelle-hero {
      padding-block: 72px;
    }

    .aurelle-hero__inner {
      width: min(720px, calc(100% - 64px));
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }

    .aurelle-hero__copy {
      max-width: 620px;
      padding-block: 0;
    }

    .aurelle-hero__visual {
      min-height: min(72vw, 555px);
    }

    .aurelle-hero__main-image {
      width: calc(100% - 230px);
    }
  }

  @media screen and (max-width: 600px) {
    .aurelle-hero {
      padding-block: 48px 64px;
    }

    .aurelle-hero__inner {
      width: calc(100% - 40px);
      gap: 32px;
    }

    .aurelle-hero__eyebrow {
      margin-bottom: 16px;
      font-size: 9px;
    }

    .aurelle-hero__heading {
      font-size: clamp(42px, 12vw, 54px);
      line-height: 1.08;
    }

    .aurelle-hero__description {
      margin-top: 14px;
      font-size: 15px;
      line-height: 1.55;
    }

    .aurelle-hero__actions {
      gap: 8px;
      margin-top: 24px;
    }

    .aurelle-hero__button {
      min-height: 46px;
      padding-inline: 18px;
      font-size: 10px;
    }

    .aurelle-hero__text-link {
      padding-inline: 0;
      font-size: 10px;
    }

    .aurelle-hero__proof-points {
      gap: 12px;
      margin-top: 28px;
    }

    .aurelle-hero__proof-points li:not(.aurelle-hero__proof-separator) {
      gap: 6px;
      font-size: 9px;
    }

    .aurelle-hero__proof-points svg {
      width: 18px;
      height: 18px;
      flex-basis: 18px;
    }

    .aurelle-hero__visual {
      min-height: min(106vw, 430px);
    }

    .aurelle-hero__main-image {
      width: calc(100% - 130px);
    }

    .aurelle-hero__detail-card {
      top: 84px;
      width: 165px;
    }

    .aurelle-hero__detail-image {
      width: 200px;
      height: 267px;
      margin-left: -35px;
    }

    .aurelle-hero__caption {
      width: 200px;
      min-height: 44px;
      margin-left: -35px;
      padding-inline: 7px;
    }

    .aurelle-hero__appointment {
      right: 4px;
      bottom: -14px;
      gap: 8px;
      max-width: calc(100% - 4px);
      min-height: 36px;
      padding-inline: 12px;
      font-size: 8px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AURELLE hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Maison Joaillerie Parisienne"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>The Eternal<br/><em>Reflection</em><br/>Collection</p>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Sculptural 18-karat solid gold and brilliant-cut conflict-free diamonds handcrafted in our historical Place Vendôme atelier."
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Primary button label",
      "default": "Explore High Jewellery"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary button link",
      "info": "Leave blank to hide this button until a destination is selected."
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Secondary link label",
      "default": "Book Consultation"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary link destination",
      "info": "Leave blank to hide this link until a destination is selected."
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main portrait image"
    },
    {
      "type": "text",
      "id": "main_image_alt",
      "label": "Main image alternative text"
    },
    {
      "type": "image_picker",
      "id": "detail_image",
      "label": "Atelier detail image"
    },
    {
      "type": "text",
      "id": "detail_image_alt",
      "label": "Detail image alternative text"
    },
    {
      "type": "text",
      "id": "caption_eyebrow",
      "label": "Detail image caption eyebrow",
      "default": "Edition 2025"
    },
    {
      "type": "text",
      "id": "caption_title",
      "label": "Detail image caption title",
      "default": "Bespoke Diamond Suites"
    },
    {
      "type": "text",
      "id": "appointment_badge",
      "label": "Appointment badge text",
      "default": "Private salon appointments open"
    },
    {
      "type": "url",
      "id": "appointment_link",
      "label": "Appointment badge link",
      "info": "Optional. Without a destination, the badge is displayed as non-interactive text."
    },
    {
      "type": "text",
      "id": "proof_point_one",
      "label": "First proof point",
      "default": "Certified RJC Member",
      "info": "Verify this business claim before publishing."
    },
    {
      "type": "text",
      "id": "proof_point_two",
      "label": "Second proof point",
      "default": "GIA Natural Gemstones",
      "info": "Verify this business claim before publishing."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hero background",
      "default": "#F7F4EF",
      "info": "Approximate ivory implementation default; adjust to the approved brand color."
    },
    {
      "type": "color",
      "id": "foreground_color",
      "label": "Hero text",
      "default": "#272521",
      "info": "Approximate charcoal implementation default; adjust to the approved brand color."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Hero accent",
      "default": "#866A35",
      "info": "Approximate muted-gold implementation default; adjust to the approved brand color."
    }
  ],
  "presets": [
    {
      "name": "AURELLE hero"
    }
  ]
}
{% endschema %}
