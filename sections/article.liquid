{% comment %}
  This section renders an article page and optional customer comments.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/article
{% endcomment %}

<article class="aurelle-article full-width">
  <div class="aurelle-article__inner">
    {% if article.image %}
      {{ article.image | image_url: width: 1600 | image_tag: class: 'aurelle-article__image', alt: article.image.alt | default: article.title, widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 1100px) 1000px, calc(100vw - 40px)', loading: 'eager', fetchpriority: 'high' }}
    {% endif %}

    <h1>{{ article.title | escape }}</h1>
    {% assign date = article.published_at | time_tag: format: 'date' %}
    <p class="aurelle-article__metadata">{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</p>
    <div class="aurelle-article__content">{{ article.content }}</div>

    {% if blog.comments_enabled? %}
      <section class="aurelle-article__comments" id="comments" aria-labelledby="AurelleArticleComments-{{ section.id }}">
        <h2 id="AurelleArticleComments-{{ section.id }}">{{ 'blog.article_comments' | t }}</h2>

        {% paginate article.comments by 10 %}
          {% for comment in article.comments %}
            <article class="aurelle-article__comment">
              <p>{{ comment.author | escape }}</p>
              <p>{{ comment.created_at | time_tag: format: 'date' }}</p>
              <p>{{ comment.content | escape }}</p>
            </article>
          {% endfor %}
          {{ paginate | default_pagination: anchor: 'comments' }}
        {% endpaginate %}

        {% form 'new_comment', article, class: 'aurelle-article__comment-form' %}
          <h3>{{ 'blog.comment_form_title' | t }}</h3>
          {{ form.errors | default_errors }}
          <label for="AurelleCommentAuthor-{{ section.id }}">{{ 'blog.comment_form_name' | t }}</label>
          <input type="text" name="comment[author]" id="AurelleCommentAuthor-{{ section.id }}" value="{{ form.author | escape }}" autocomplete="name" required>
          <label for="AurelleCommentEmail-{{ section.id }}">{{ 'blog.comment_form_email' | t }}</label>
          <input type="email" name="comment[email]" id="AurelleCommentEmail-{{ section.id }}" value="{{ form.email | escape }}" autocomplete="email" required>
          <label for="AurelleCommentBody-{{ section.id }}">{{ 'blog.comment_form_body' | t }}</label>
          <textarea name="comment[body]" id="AurelleCommentBody-{{ section.id }}" required>{{ form.body | escape }}</textarea>
          <button type="submit">{{ 'blog.comment_form_submit' | t }}</button>
        {% endform %}
      </section>
    {% endif %}
  </div>
</article>

{% stylesheet %}
  .aurelle-article {
    padding-block: clamp(36px, 6vw, 88px);
  }

  .aurelle-article__inner {
    width: min(1000px, calc(100% - clamp(32px, 8vw, 112px)));
    margin-inline: auto;
  }

  .aurelle-article__image {
    width: 100%;
    height: auto;
    margin-bottom: clamp(24px, 4vw, 48px);
  }

  .aurelle-article__inner > h1 {
    margin-bottom: 12px;
    font-family: 'Bodoni MT', Didot, Georgia, 'Times New Roman', serif;
    font-size: clamp(34px, 5vw, 60px);
    font-weight: 400;
    line-height: 1.08;
  }

  .aurelle-article__metadata {
    margin-bottom: 28px;
    color: #77716a;
    font-size: 16px;
    line-height: 1.5;
  }

  .aurelle-article__content {
    font-size: 16px;
    line-height: 1.75;
  }

  .aurelle-article__content img,
  .aurelle-article__content table,
  .aurelle-article__comment-form input,
  .aurelle-article__comment-form textarea {
    max-width: 100%;
  }

  .aurelle-article__comments {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid #e6e1da;
  }

  .aurelle-article__comments h2,
  .aurelle-article__comment-form h3 {
    margin-bottom: 20px;
    font-family: 'Bodoni MT', Didot, Georgia, 'Times New Roman', serif;
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 400;
  }

  .aurelle-article__comment-form {
    display: grid;
    gap: 10px;
    margin-top: 32px;
  }

  .aurelle-article__comment-form input,
  .aurelle-article__comment-form textarea {
    width: 100%;
    min-height: 44px;
    padding: 10px 12px;
    border: 1px solid #c9c1b6;
  }

  .aurelle-article__comment-form textarea {
    min-height: 140px;
  }

  .aurelle-article__comment-form button {
    min-height: 48px;
    padding: 10px 18px;
    border: 0;
    color: #fff;
    background: #1e1c19;
    cursor: pointer;
  }

  @media screen and (max-width: 520px) {
    .aurelle-article__inner {
      width: calc(100% - 32px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.article",
  "settings": []
}
{% endschema %}
