<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">

{%- liquid
  assign seo_title = page_title | default: shop.name
  assign seo_description = page_description | default: shop.description | strip_html | strip_newlines | strip
  assign canonical = canonical_url | default: request.origin
  assign og_url = canonical
  assign og_type = 'website'
  assign social_image = page_image

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  if social_image != blank
    assign social_image_url = social_image | image_url: width: 1200 | prepend: 'https:'
    assign social_image_alt = social_image.alt | default: seo_title
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name | escape }}"
>
<meta
  property="og:url"
  content="{{ og_url | escape }}"
>
<meta
  property="og:title"
  content="{{ seo_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
{%- if seo_description != blank -%}
  <meta
    property="og:description"
    content="{{ seo_description | escape }}"
  >
{%- endif -%}

{%- if social_image != blank -%}
  <meta
    property="og:image"
    content="{{ social_image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="{{ social_image_url }}"
  >
  <meta
    property="og:image:alt"
    content="{{ social_image_alt | escape }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ seo_title | escape }}"
>
{%- if seo_description != blank -%}
  <meta
    name="twitter:description"
    content="{{ seo_description | escape }}"
  >
{%- endif -%}
{%- if social_image != blank -%}
  <meta
    name="twitter:image"
    content="{{ social_image_url }}"
  >
  <meta
    name="twitter:image:alt"
    content="{{ social_image_alt | escape }}"
  >
{%- endif -%}

<title>
  {{ seo_title | escape }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' | escape }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- if page_title != blank -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name | escape }}{% endunless -%}
  {%- endif -%}
</title>

<link
  rel="canonical"
  href="{{ canonical | escape }}"
>

{% if seo_description != blank %}
  <meta
    name="description"
    content="{{ seo_description | escape }}"
  >
{% endif %}

{% if request.page_type == 'index' %}
  {%- assign organization_id = canonical | append: '#organization' -%}
  {%- assign website_id = canonical | append: '#website' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": {{ organization_id | json }},
          "name": {{ shop.name | json }},
          "url": {{ canonical | json }}
        },
        {
          "@type": "WebSite",
          "@id": {{ website_id | json }},
          "name": {{ shop.name | json }},
          "url": {{ canonical | json }},
          "publisher": { "@id": {{ organization_id | json }} }
        }
      ]
    }
  </script>
{% endif %}
